"""任务6.4 端到端：subdir apply（demo 路径，两种落点模式）。

接 compare 结果（冲突统一采纳 target），验证两种 apply_mode：
  - new_version（默认）：目标产生新版本 match_stat_s4.xlsx（s3→s4，迭代+1）
  - overwrite：覆盖目标最新 match_stat_s2.xlsx（同名，内容为合并结果）
overwrite 用临时目标副本，避免污染 demo 快照（merge/demo）；new_version 产出后清理。
"""
import json
import shutil
import sys
import tempfile
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SERVER_DIR))

from openpyxl import load_workbook
from engine.models import SheetMergeData
from routers.merge_subdir import subdir_compare, subdir_apply, SubdirCompareRequest, SubdirApplyRequest
from routers.merge_branch import TableApplyItem

DEMO = SERVER_DIR.parent / "merge" / "demo"
AUDIT_LOG = SERVER_DIR.parent / "merge" / "trunk" / "_merge_audit.json"


def _tgt_file(resp):
    """比对结果中目标 HEAD 版本列的文件名（如 match_stat_tgt_s3.xlsx）。"""
    for f in resp.groups["match_stat"].files:
        if "_tgt_" in f:
            return f
    return ""


def _resolve_to_target(resp):
    """把所有冲突单元格统一采纳 target 版本（置 conflict=False 即视为已解决）。"""
    tgt_file = _tgt_file(resp)
    for g in resp.groups.values():
        for s in g.sheets.values():
            for r in s.rows:
                for c in r.cells:
                    if c.conflict:
                        c.value = c.versions.get(tgt_file, c.value)
                        c.conflict = False
                        c.changed = False
                        c.diff_type = ""


def _tables_payload(resp):
    """构建 apply 负载：跳过结构增删的只读展示分组（files<=1 无比对数据，不参与写回）。"""
    items = []
    for gn, g in resp.groups.items():
        if len(g.files) <= 1:
            continue
        sheets = [SheetMergeData(name=s.name, headers=s.headers, rows=s.rows)
                  for s in g.sheets.values()]
        items.append(TableApplyItem(group_name=gn, sheets=sheets))
    return items


def _compare(src="trunk_r4/subdir_copied", tgt="trunk_r4"):
    resp = subdir_compare(SubdirCompareRequest(
        source_dir=src, target_dir=tgt, group_names=["match_stat"],
    ))
    _resolve_to_target(resp)
    return resp


def check_new_version():
    resp = _compare()
    result = subdir_apply(SubdirApplyRequest(
        source_dir="trunk_r4/subdir_copied", target_dir="trunk_r4",
        tables=_tables_payload(resp), apply_mode="new_version",
    ))
    r0 = result["results"][0]
    dest = Path(r0["path"])
    print(f"[new_version] output={r0['output']} mode={r0['apply_mode']}")
    assert r0["output"] == "match_stat_s4.xlsx", f"新版本应为 match_stat_s4.xlsx，实际 {r0['output']}"
    assert dest.is_file(), f"落点未生成: {dest}"
    assert r0["apply_mode"] == "new_version"
    dest.unlink(missing_ok=True)   # 清理产出的新版本
    print("  PASS new_version → match_stat_s4.xlsx")


def check_overwrite():
    # 用临时目标副本（s1/s2），避免覆盖污染 demo/trunk_r4 的 s2/s3
    tmp_tgt = Path(tempfile.mkdtemp(prefix="subdir_overwrite_"))
    shutil.copy2(DEMO / "trunk_r4" / "match_stat_s1.xlsx", tmp_tgt / "match_stat_s1.xlsx")
    shutil.copy2(DEMO / "trunk_r4" / "match_stat_s2.xlsx", tmp_tgt / "match_stat_s2.xlsx")
    try:
        resp = _compare(tgt=str(tmp_tgt))
        # 覆盖前 s2 行6 c1=40（未改）
        wb_before = load_workbook(tmp_tgt / "match_stat_s2.xlsx", data_only=True)
        before_row6 = wb_before["SeasonStat"].cell(6, 2).value
        wb_before.close()

        result = subdir_apply(SubdirApplyRequest(
            source_dir="trunk_r4/subdir_copied", target_dir=str(tmp_tgt),
            tables=_tables_payload(resp), apply_mode="overwrite",
        ))
        r0 = result["results"][0]
        dest = Path(r0["path"])
        print(f"[overwrite] output={r0['output']} mode={r0['apply_mode']}")
        assert r0["output"] == "match_stat_s2.xlsx", f"覆盖应同名 s2，实际 {r0['output']}"
        assert dest.is_file(), f"落点未生成: {dest}"
        assert r0["apply_mode"] == "overwrite"
        # 覆盖后内容应为合并结果：行6 c1 采纳源单向改动 444
        wb_after = load_workbook(dest, data_only=True)
        after_row6 = wb_after["SeasonStat"].cell(6, 2).value
        wb_after.close()
        assert after_row6 == 444, f"覆盖后行6 c1 应为源改动 444，实际 {after_row6}（覆盖前 {before_row6}）"
        print(f"  PASS overwrite → match_stat_s2.xlsx（行6 c1: {before_row6}→{after_row6}）")
    finally:
        shutil.rmtree(tmp_tgt, ignore_errors=True)


def main():
    check_new_version()
    check_overwrite()
    # 审计：一次合并一条记录（tables 明细数组）；最新一条应为 subdir_new_version 或 subdir_overwrite
    audit = json.loads(AUDIT_LOG.read_text(encoding="utf-8")) if AUDIT_LOG.is_file() else []
    assert audit and audit[0].get("mode") in ("subdir_new_version", "subdir_overwrite"), \
        f"审计最新条目 mode 应为 subdir_*：{audit[0] if audit else None}"
    assert len(audit[0].get("tables") or []) == 1, f"一次合并应一条记录带 tables 明细：{audit[0]}"
    assert audit[1].get("mode") in ("subdir_new_version", "subdir_overwrite") and len(audit[1].get("tables") or []) == 1, \
        f"两次合并应各一条记录：{audit[1] if len(audit) > 1 else None}"
    print(f"PASS 审计单条记录 mode={audit[0]['mode']} tables={len(audit[0]['tables'])}")
    print("=== ALL PASS subdir_apply ===")


if __name__ == "__main__":
    main()
