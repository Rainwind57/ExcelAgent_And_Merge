"""CLI instrument 层:tool-call 可见性。

装饰器包裹 CodeMakerCLI,每次方法调用捕获 {name, desc, cmd, result, ok, ts}
生成 ToolRecord → 推送 SSE `tool` 事件。对齐 example.html tool-block。

设计:
- instrument(cli) -> InstrumentedCLI 代理对象
- 拦截每次方法调用,不侵入 cli_interface.py 内部
- 异常捕获:失败生成 ToolRecord ok=False,重新抛出原异常(不吞错误)
- 环境变量 CODEMAKER_CLI_INSTRUMENT=on|off 开关(管道默认 on,旧路径 off)
"""

from __future__ import annotations

import json
import logging
import os
import time
from datetime import datetime
from typing import Any, Callable, Optional

logger = logging.getLogger(__name__)

# SSE tool 事件 sink 签名:(event_type: str, payload: dict) -> None
# dispatcher 注入,复用 agent_service.py:1662 sink queue 模式
ToolSink = Callable[[str, dict], None]


def _env_enabled() -> bool:
    """管道模式默认 on,旧路径 off。显式 off 则关闭。"""
    val = os.environ.get("CODEMAKER_CLI_INSTRUMENT", "").lower()
    if val in ("off", "0", "false"):
        return False
    if val in ("on", "1", "true"):
        return True
    # 未显式设置:默认开启(管道模式调用方应显式设 on)
    return True


def _make_tool_record(name: str, args: tuple, kwargs: dict,
                       result: Any, ok: bool, error: str = "") -> dict:
    """生成 ToolRecord,对齐 example.html tool-block 结构。

    {name, desc, cmd, result, ok, ts}
    - name: 方法名(如 read_cell)
    - desc: 简述(基于方法名 + 首参)
    - cmd: 完整命令字符串(name + args)
    - result: 结果(成功为返回值,失败为异常消息)
    - ok: 是否成功
    - ts: 时间戳
    """
    # 构造 cmd 字符串:method(arg1, arg2, ...)
    arg_parts = []
    for a in args:
        try:
            arg_parts.append(repr(a) if not isinstance(a, str) else a)
        except Exception:
            arg_parts.append("<unrepr>")
    for k, v in kwargs.items():
        try:
            arg_parts.append(f"{k}={v!r}")
        except Exception:
            arg_parts.append(f"{k}=<unrepr>")
    cmd = f"{name}({', '.join(arg_parts)})" if arg_parts else f"{name}()"

    # desc: 方法名 + 首参(路径或 sheet)
    first_arg = args[0] if args else ""
    if isinstance(first_arg, str):
        desc = f"{name}: {first_arg}"
    else:
        desc = name

    # result 序列化(避免大对象)
    try:
        if isinstance(result, (dict, list, str, int, float, bool, type(None))):
            result_data = result
        else:
            # 对象转 dict(若有 model_dump/dict 方法)
            if hasattr(result, "model_dump"):
                result_data = result.model_dump()
            elif hasattr(result, "__dict__"):
                result_data = {k: v for k, v in vars(result).items()
                               if not k.startswith("_")}
            else:
                result_data = str(result)
    except Exception:
        result_data = "<unserializable>"

    return {
        "name": name,
        "desc": desc,
        "cmd": cmd,
        "result": result_data if ok else error,
        "ok": ok,
        "ts": datetime.now().isoformat(timespec="seconds"),
    }


class InstrumentedCLI:
    """代理对象:拦截 CodeMakerCLI 方法调用,生成 ToolRecord 推送 SSE。

    不修改原始 cli_interface.py,通过 __getattr__ 代理所有方法。
    """

    def __init__(self, cli, sink: Optional[ToolSink] = None,
                 enabled: Optional[bool] = None):
        self._cli = cli
        self._sink = sink
        self._enabled = _env_enabled() if enabled is None else enabled

    def set_sink(self, sink: ToolSink) -> None:
        """dispatcher 注入 SSE sink。"""
        self._sink = sink

    def set_enabled(self, enabled: bool) -> None:
        """管道模式开,旧路径关。"""
        self._enabled = enabled

    def __getattr__(self, name: str):
        """代理所有未显式定义的方法:拦截 → 记录 → 推送。

        下划线开头方法(如 _resolve_data_start/_load/_last_data_row)视为内部
        辅助方法,直接透传不包装记录(避免 agent.py 内部调用被阻断)。
        """
        if name.startswith("__"):
            raise AttributeError(name)
        attr = getattr(self._cli, name)
        if name.startswith("_"):
            # 内部方法:直接返回,不记录(供 agent.py 的 _resolve_data_start 等用)
            return attr
        if not callable(attr):
            # 非方法属性直接返回
            return attr

        def wrapper(*args, **kwargs):
            if not self._enabled or self._sink is None:
                # 未开启或无 sink:直通
                return attr(*args, **kwargs)
            t0 = time.time()
            try:
                result = attr(*args, **kwargs)
                record = _make_tool_record(name, args, kwargs, result, ok=True)
                self._push("tool", record)
                return result
            except Exception as e:
                record = _make_tool_record(name, args, kwargs, None,
                                             ok=False, error=str(e))
                self._push("tool", record)
                raise  # 不吞错误,重新抛出

        return wrapper

    def _push(self, event_type: str, payload: dict) -> None:
        """推送 SSE 事件,复用 sink queue 模式(agent_service.py:1662)。"""
        if self._sink is None:
            return
        try:
            self._sink(event_type, payload)
        except Exception:
            logger.debug("tool sink 推送失败", exc_info=True)


def instrument(cli, sink: Optional[ToolSink] = None,
               enabled: Optional[bool] = None) -> InstrumentedCLI:
    """包裹 CodeMakerCLI 返回 InstrumentedCLI 代理对象。

    Args:
        cli: 原始 CodeMakerCLI 实例
        sink: SSE 事件 sink,签名 (event_type, payload) -> None
        enabled: 是否开启 instrument,None 走环境变量
    """
    return InstrumentedCLI(cli, sink=sink, enabled=enabled)
