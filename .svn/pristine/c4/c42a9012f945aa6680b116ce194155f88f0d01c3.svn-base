    # 聚焦 pet 表
    ctx = b.build_context(focused=["pet"])
    print(f"token_used={ctx.token_used}/{ctx.token_budget}  degraded={ctx.degraded}")
    print(f"focused_full={ctx.focused_full}  brief={len(ctx.included_brief)}  omitted={len(ctx.omitted)}")
    print("=== system_prompt 头部 ===")
    print(ctx.system_prompt[:600])
    print("...")
    print("=== SkillExecutor ===")
    ex = SkillExecutor()
    print("locate_table 灵兽:", ex.call("locate_table", text="灵兽")["path"])
    print("list_all_tables count:", len(ex.call("list_all_tables")))
    print("get_table_structure pet:", {s["name"] for s in ex.call("get_table_structure", path="pet")["sheets"]})
    print("fuzzy_search_value 刑天:", [c["value"] for c in ex.call("fuzzy_search_value", query="刑天", candidates=["刑天一阶", "刑天二阶", "饕餮"])])
