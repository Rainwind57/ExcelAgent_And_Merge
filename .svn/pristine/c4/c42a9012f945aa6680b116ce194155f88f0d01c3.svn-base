        "name": "list_all_tables",
        "description": "列出所有已注册表格的简要信息（文件名 + Sheet 名列表）。",
        "parameters": {},
        "returns": "[{'path': str, 'stem': str, 'sheets': [str]}]",
    },
    {
        "name": "analyze_enum_columns",
        "description": "分析指定表的所有 int 列，扫描实际数据返回每列的唯一值集合、"
                       "值域、是否疑似枚举列。用于让 AI 自己发现哪些 int 列有中文枚举含义"
                       "（如品质1=蓝/2=紫/3=橙），无需人工配置。",
        "parameters": {
            "path": "str — 表格相对路径（如 pet/pet.xlsx）或 stem",
            "sheet": "str|None — 指定 sheet，None 分析全部业务 sheet",
            "max_unique": "int — 唯一值数上限，超过则不视为枚举候选（默认 20）",
        },
        "returns": "{'stem': str, 'columns': [{'col_name','col_index','col_type',"
