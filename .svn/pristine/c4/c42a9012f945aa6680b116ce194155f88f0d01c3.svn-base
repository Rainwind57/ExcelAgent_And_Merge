        "description": "获取指定表格的完整结构：每个 Sheet 的列名、数据起始行、行数、前3行样本。",
        "parameters": {"path": "str — 表格相对路径（如 pet/pet.xlsx）或 stem"},
        "returns": "{'path': str, 'stem': str, 'sheets': [{'name', 'headers', 'header_names', "
                   "'data_start_row', 'row_count', 'samples'}]}",
    },
    {
        "name": "add_column",
        "description": "向指定 Sheet 添加列。写入前应已通过 locate_table 与 get_table_structure "
                       "确认目标，写操作需用户确认后执行。",
        "parameters": {
            "path": "str — 表格相对路径",
            "sheet": "str — Sheet 名",
            "name": "str — 新列表头名",
