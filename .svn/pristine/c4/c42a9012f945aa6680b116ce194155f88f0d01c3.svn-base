        "name": "fuzzy_search_value",
        "description": "在候选值集合中模糊搜索，返回按相似度降序的候选列表。"
                       "融合子串匹配、Levenshtein 编辑距离、字符重叠度三路评分。",
        "parameters": {"query": "str — 查询值", "candidates": "list[str] — 候选值集合"},
        "returns": "[{'value': str, 'score': float, 'confidence': 'high|medium|low', "
                   "'reasons': [str]}]",
