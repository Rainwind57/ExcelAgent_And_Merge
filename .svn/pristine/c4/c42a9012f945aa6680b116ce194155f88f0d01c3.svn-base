"""LLM 上下文构建器与 Skill 注入（层4）。

职责：
  1. 每次调用 LLM 前，动态构建不超过 Token 限制的结构化上下文。
  2. 注入 7 个 Skill 定义（locate_table / fuzzy_search_value / get_table_structure
     / add_column / list_all_tables / analyze_enum_columns / update_enum_mapping）。
  3. 组装系统提示词：表格结构摘要 + Skill 定义 + 操作规则。

Skill 双重形态：
  - 成功路径：build_skill_context 把 skill 定义拼进 prompt 作知识注入（零工具调用）。
  - repair 路径：SkillExecutor 经 tools.make_skill_tools 注册为 LangChain @tool，
    供 Level 2 ReAct 循环 LLM 自主探查调用（capability: skill-executor-tools）。

Token 感知策略：
  - 估算：中文 ≈ 2 token/字，英文/ASCII ≈ 0.5 token/字符，其它 ≈ 1 token/字符。
  - 上限 12000 token，预留 2000 token 安全余量（有效预算 10000）。
  - 增量加载：聚焦表格注入完整结构，剩余空间补充其他表格简要摘要（文件名+Sheet名）。
  - 降级：全量摘要超限时，自动降级为简要摘要模式（聚焦表也降为摘要）。
"""

from __future__ import annotations

import json
from dataclasses import dataclass, field
from typing import Any, Optional

from .cli_interface import CodeMakerCLI
from .fuzzy_matcher import FuzzyMatcher, FuzzyCandidate
from .table_index import TableMeta, load_index
from .table_locator import TableLocator, LocateResult, LocateOutcome
from .table_relations import RelationGraph


# ── Token 估算 ───────────────────────────────────────────────

def estimate_tokens(text: str) -> int:
    """估算文本 token 数。

    中文（CJK）字符 ≈ 2 token/字；ASCII 字符 ≈ 0.5 token/字符；其它 ≈ 1 token/字符。
    向上取整。
    """
    if not text:
        return 0
    cjk = 0
    ascii_cnt = 0
    other = 0
    for ch in text:
        cp = ord(ch)
        if 0x4E00 <= cp <= 0x9FFF or 0x3400 <= cp <= 0x4DBF:
            cjk += 1
        elif ch.isascii():
            ascii_cnt += 1
        else:
            other += 1
    # 0.5 token/ascii → 每 2 个 ascii 1 token；向上取整统一用 math.ceil
    import math
    return math.ceil(cjk * 2 + ascii_cnt * 0.5 + other * 1)


# ── Skill 定义 ───────────────────────────────────────────────

