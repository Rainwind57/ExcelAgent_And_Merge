"""QA 处理器：基于 codemaker LLM + 表格索引回答自然语言问题。

LangChain 化：优先走 CodemakerChatModel + ChatPromptTemplate（无状态，
多轮记忆由 LangGraph state 维护）；未注入 model 时回退到旧版 codemaker
client 直连（session 轮询），保证向后兼容。

支持的问题类型：
- "邮件相关的表格有哪些" → 语义匹配文件名/sheet名
- "hero表有哪些列" → 列出表结构
- "ability表存了什么" → 表格用途说明
- 通用配表知识问答
"""

from __future__ import annotations

from pathlib import Path
from typing import Optional

from .codemaker_client import CodemakerClient
from .excel.table_index import load_index, TableMeta
from .prompts import QA_SYSTEM_PROMPT


class QAHandler:
    """基于 LLM 的自然语言问答处理器。

    构建表格索引摘要，注入 LLM prompt，生成语义理解回答。
    """

    def __init__(self, client: CodemakerClient | None = None,
                 model=None, resources_dir: Path | None = None):
        """初始化 QA 处理器。

        Args:
            client: codemaker 客户端（回退路径与索引构建均可能用到）。
            model: LangChain ChatModel（注入后走 LangChain 路径，无状态）。
                缺省时回退到 client 直连（session 轮询），保持旧行为。
            resources_dir: 资源目录，用于重建索引摘要。
        """
        self.client = client or CodemakerClient()
        self.model = model
        self.resources_dir = resources_dir
        # 流式思考回调（chat_stream 注入；非流式调用时为 None，静默降级）
        self._thinking_sink = None
        self._step_sink = None

    def build_index_context(self, resources_dir: Path | None = None) -> str:
        """构建表格索引的文本摘要，用于注入 LLM prompt。

        包含：文件名、sheet 列表、每 sheet 部分列名、行数。
        """
        try:
            index = load_index()
        except Exception:
            index = []

        if not index:
            return "(暂无表格索引信息)"

        lines: list[str] = []
        for t in index:
            stem = t.stem
            path = t.path
            # 根据 stem 推断表格用途
            usage = self._infer_usage(stem)
            lines.append(f"\n### 📁 {stem}.xlsx [{usage}]（路径: {path}）")
            for s in t.sheets:
                headers = s.headers[:15]  # 只取前15列避免过长
                header_str = "、".join(h for h in headers if h) if headers else "(空)"
                lines.append(
                    f"  - Sheet: {s.name} | {s.row_count}行 | 列: {header_str}"
                )
        return "\n".join(lines)

    @staticmethod
    def _infer_usage(stem: str) -> str:
        """根据文件名推断表格用途。"""
        mapping = {
            "hero": "英雄/角色基础属性",
            "item": "道具/物品配置",
            "equipment": "装备属性",
            "ability": "技能/能力配置",
            "mail": "邮件模板与配置",
            "quest": "任务配置",
            "combat": "战斗系统配置",
            "spell": "法术/技能效果",
            "pet": "宠物/灵兽配置",
            "map": "地图信息",
            "city": "城池/建筑",
            "guild": "帮派/公会",
            "school": "门派/流派",
            "residence": "家园/住宅",
            "activity": "活动配置",
            "reward": "奖励配置",
            "player_common": "玩家通用配置",
            "const": "全局常量",
            "tips": "提示/引导文本",
            "fabao": "法宝配置",
            "world_buff": "世界Buff",
            "space": "空间/场景",
            "space_landmark": "场景地标",
            "interaction": "交互系统",
            "spawn_world_entity": "世界实体生成",
        }
        for key, desc in mapping.items():
            if key in stem.lower():
                return desc
        return "通用配置"

    def _think(self, phase: str, detail: str = "") -> None:
        """推送 thinking 事件（sink 未注入时静默跳过）。"""
        sink = self._thinking_sink
        if sink:
            try:
                sink(phase, detail)
            except Exception:
                pass

    def _step(self, name: str, ok: bool = True, detail: str = "") -> None:
        """推送 step 事件（sink 未注入时静默跳过）。"""
        sink = self._step_sink
        if sink:
            try:
                sink({"name": name, "ok": ok, "detail": detail})
            except Exception:
                pass

    def answer(self, question: str, session_id: str = "",
               history: str = "",
               resources_dir: Path | None = None) -> str:
        """回答自然语言问题。

        Args:
            question: 用户问题
            session_id: codemaker 会话 ID（LangChain 路径下忽略，保留以兼容旧签名）
            history: 对话上下文摘要（最近操作/问答），用于多轮记忆与代词消解
            resources_dir: 资源目录路径（用于重建索引摘要）

        Returns:
            LLM 生成的回答文本

        Raises:
            RuntimeError: codemaker 不可用或调用失败
        """
        rd = resources_dir or self.resources_dir

        self._think("分析问题", question[:80])
        self._step("Step 1: 解析问题", True, f"问题: {question[:60]}")

        self._think("构建表格索引", "加载 _table_index.json 并汇总表/sheet/列")
        index_ctx = self.build_index_context(rd)
        try:
            idx_count = len(load_index())
        except Exception:
            idx_count = 0
        self._step("Step 2: 构建表格索引上下文", True,
                   f"{idx_count} 张表, {len(index_ctx)} 字符")

        prompt = QA_SYSTEM_PROMPT.format(context=index_ctx)
        # 注入对话历史摘要，使 QA 具备多轮记忆（代词消解、指代上文操作）
        hist = (history or "").strip()
        if hist:
            prompt += f"\n\n## 对话上下文（最近操作/问答摘要）\n{hist}"
        self._think("组装 Prompt",
                    f"QA_SYSTEM_PROMPT + 索引({len(index_ctx)}) + 历史({len(hist)}) 字符")
        self._step("Step 3: 组装 LLM Prompt", True, f"{len(prompt)} 字符")

        # LangChain 路径：ChatModel 无状态调用
        if self.model is not None:
            from langchain_core.messages import HumanMessage, SystemMessage
            self._think("调用 LLM", f"CodemakerChatModel.invoke（含历史 {len(hist)} 字符）")
            msg = self.model.invoke([
                SystemMessage(content=prompt),
                HumanMessage(content=question),
            ])
            self._step("Step 4: 调用 LLM 生成回答", True,
                       f"返回 {len(msg.content or '')} 字符")
            return msg.content

        # 回退路径：直接走 codemaker client（未注入 model 时保持旧行为）
        full_prompt = f"{prompt}\n\n## 用户问题\n{question}"
        self._think("调用 codemaker client", "session prompt 轮询")
        if session_id:
            resp = self.client.prompt(session_id, full_prompt)
        else:
            # 5.1：缓存并复用 session，避免每次 QA 都新建。
            sid = getattr(self, "_session_id", "")
            if not sid:
                sess = self.client.create_session(directory=str(rd) if rd else "")
                if not sess.ok:
                    self._step("Step 4: codemaker 会话创建", False, sess.error or "")
                    raise RuntimeError(f"codemaker 不可用：{sess.error}")
                sid = sess.session_id
                self._session_id = sid
            resp = self.client.prompt(sid, full_prompt)

        if not resp.ok:
            self._step("Step 4: codemaker QA 调用", False, resp.error or "")
            raise RuntimeError(f"codemaker QA 调用失败：{resp.error}")

        self._step("Step 4: codemaker QA 调用", True,
                   f"返回 {len(resp.response_text or '')} 字符")
        return resp.response_text
