@echo off
setlocal
REM ============================================================
REM  One-click update
REM  Steps: stop services -> svn update -> sync python deps ->
REM         rebuild frontend -> rebuild index -> reinstall table mode -> restart services
REM ============================================================
cd /d "%~dp0\.."

echo ========================================
echo   AI Excel Tool - Update
echo ========================================
echo.

REM [1/6] stop old services
echo [1/6] Stop old services...
call tools\stop.bat --no-pause
echo.

REM [2/6] svn update
echo [2/6] SVN update...
svn update
if errorlevel 1 (
  echo   [X] svn update failed
  goto :err
)
echo.

REM [3/6] python deps
echo [3/6] Sync python deps (uv sync)...
uv sync
if errorlevel 1 (
  echo   [X] uv sync failed
  goto :err
)
echo.

REM [4/6] frontend
echo [4/6] Rebuild frontend...
pushd frontend
call npm install
if errorlevel 1 (
  echo   [X] npm install failed
  popd
  goto :err
)
call npm run build
if errorlevel 1 (
  echo   [X] frontend build failed
  popd
  goto :err
)
popd
echo.

REM [5/6] table index
echo [5/6] Rebuild table index...
uv run python -W "ignore::RuntimeWarning:runpy" -m server.agent.excel.index_builder
if errorlevel 1 (
  echo   [X] index build failed
  goto :err
)
echo.

REM [6/6] table mode (after svn update, table-mode docs/skills may change, reinstall)
echo [6/6] Reinstall table operation mode...
uv run python tools\table-mode\install.py
if errorlevel 1 (
  echo   [X] table mode install failed
  goto :err
)
echo.

echo Restart services...
call tools\start.bat

echo.
echo ========================================
echo   Update done, services restarted
echo ========================================
echo   Frontend : http://127.0.0.1:8000
echo   API docs : http://127.0.0.1:8000/docs
echo   Table mode : run "enter table mode" in CodeMaker
echo.
pause
exit /b 0

:err
echo.
echo Update failed. See messages above.
pause
exit /b 1
