"""管道 7 步编排器:固定工作流 + 断点续跑 + 多 Agent 并行。

Step0 断点检查 → Step1 拆解 → Step2 分区 → Step3 并行填表
→ Step4 汇总(assemble) → Step5 验证(verify) → Step6 写库(write)
→ Step7 清理(cleanup)+报告

复用:
- CheckpointManager(断点续跑)
- file_parser(parse_file → DocIntent)
- subagent/dispatcher(asyncio.gather 并行 SubAgent)
- OperationOrchestrator(Step4 拓扑排序+符号校验,升级支持 fragment)
- skill 体系(Step5 验证)
- cli_interface(Step6 写库,包 instrument)
- table_resolver/table_locator(Step2 分区,替代 SchemaMaster 查库)
"""

from __future__ import annotations

import logging
import os
import re
from dataclasses import asdict
from pathlib import Path
from typing import Any, Callable, Optional

from ..checkpoint import CheckpointManager
from ..cli_instrument import instrument, ToolSink
from ..nl_parser import NLIntent
from ..operation_orchestrator import OperationOrchestrator
from ..parser.file_parser import parse_file, assign_symbols
from ..subagent.base import SubAgent
from ..subagent.dispatcher import dispatch
from ..table_resolver import TableResolver
from .types import (AgentFragment, DocIntent, PipelineContext,
                    PipelineResult, StepCard, StepResult)
from .verifier import PipelineVerifier

logger = logging.getLogger(__name__)

# 管道模式判定关键词(auto 模式)
# 收紧:「配表」过于宽泛(几乎每个 CRUD 都触及配表),移除以避免普通查询误入重型管道。
# 保留强信号:跨表/多表(多表协同)、流程/并行(工作流)、剧本(脚本驱动)。
_PIPELINE_KEYWORDS = ("跨表", "多张表", "多表", "流程", "并行", "剧本")

# 文件路径正则
_FILE_PATH_RE = re.compile(r'[A-Za-z]:[\\/][^\s]+\.(md|csv|txt|xlsx)',
                            re.IGNORECASE)

# 7 步顺序(断点续跑跳步判定)+ 步骤显示名
_STEP_ORDER = ("0_checkpoint", "1_decompose", "2_partition", "3_fill",
               "4_assemble", "5_verify", "6_write", "7_cleanup")
_STEP_NAMES = {
    "0_checkpoint": "Step0断点检查",
    "1_decompose": "Step1拆解",
    "2_partition": "Step2分区",
    "3_fill": "Step3并行填表",
    "4_assemble": "Step4汇总",
    "5_verify": "Step5验证",
    "6_write": "Step6写库",
    "7_cleanup": "Step7清理",
}


def should_trigger_pipeline(text: str) -> bool:
    """管道模式判定:文件路径或多表关键词 → True。

    可配置 CODEMAKER_PIPELINE_MODE=auto|off|on(默认 auto)。
    """
    mode = os.environ.get("CODEMAKER_PIPELINE_MODE", "auto").lower()
    if mode == "off":
        return False
    if mode == "on":
        return True
    # auto:判定
    if _FILE_PATH_RE.search(text or ""):
        return True
    if any(kw in (text or "") for kw in _PIPELINE_KEYWORDS):
        return True
    return False


def extract_file_path(text: str) -> Optional[str]:
    """从文本提取首个文件路径。"""
    m = _FILE_PATH_RE.search(text or "")
    return m.group(0) if m else None


class Pipeline:
    """7 步管道编排器。

    Attributes:
        cli: CodeMakerCLI 实例(Step6 写库用,包 instrument)
        parser: CodemakerNLParser 实例(SubAgent 复用 HTTP 通道)
        table_resolver: 表/sheet 定位器(Step2)
        orchestrator: OperationOrchestrator(Step4)
        verifier: PipelineVerifier(Step5)
        thinking_sink: SSE thinking 回调(主流注入)
        tool_sink: SSE tool 回调(instrument 注入)
    """

    def __init__(self, cli=None, parser=None, table_resolver=None,
                 thinking_sink: Optional[Callable] = None,
                 tool_sink: Optional[ToolSink] = None,
                 writer=None,
                 step_sink: Optional[Callable] = None):
        self.cli = cli
        self.parser = parser
        self.table_resolver = table_resolver or TableResolver()
        self.thinking_sink = thinking_sink
        self.tool_sink = tool_sink
        self.step_sink = step_sink
        # writer: TableAgent 实例(用其 run_as_writer 做 Step6 真写库);None 则降级 cli 原语
        self._writer = writer
        # Step4 复用 orchestrator(run_single 由 Step6 驱动,此处占位)
        self.orchestrator = OperationOrchestrator(run_single=self._run_single_writer)
        self.verifier = PipelineVerifier()

    def _think(self, phase: str, detail: str) -> None:
        """推送 thinking 到主流 SSE。"""
        if self.thinking_sink:
            try:
                self.thinking_sink(phase, detail)
            except Exception:
                pass

    def _emit_step(self, sr: StepResult) -> None:
        """推送 step 完成事件到主流 SSE(供前端实时渲染 7 步进度卡片)。"""
        if self.step_sink:
            try:
                self.step_sink({
                    "name": sr.name,
                    "ok": sr.status == "done",
                    "detail": sr.output or sr.error or "",
                    "step_id": sr.step_id,
                    "status": sr.status,
                })
            except Exception:
                pass

    # ── 断点续跑:跳过已完成步骤 + 产物恢复 ──
    def _maybe_skip(self, ctx: PipelineContext, ckpt: CheckpointManager,
                    result: PipelineResult, step_id: str) -> bool:
        """断点续跑跳步判定。返回 True 表示该步已 done 且产物已恢复,应跳过。

        规则:
        - resume_point 为空(非续跑)→ 不跳过
        - step_id == resume_point(续跑点)→ 清空 resume_point,不跳过(后续含重试正常执行)
        - step_id 在 resume_point 之前 → 尝试从 checkpoint 恢复产物;恢复成功则跳过,
          恢复失败(产物缺失)→ 清空 resume_point 不跳过(从该步重新执行)
        """
        if not ctx.resume_point:
            return False
        rp = ctx.resume_point
        if step_id == rp:
            ctx.resume_point = ""
            return False
        if step_id in _STEP_ORDER and rp in _STEP_ORDER \
                and _STEP_ORDER.index(step_id) < _STEP_ORDER.index(rp):
            if self._restore_step_state(ctx, ckpt, step_id):
                sr = ctx.add_step(step_id, _STEP_NAMES.get(step_id, step_id))
                sr.status = "done"
                sr.output = "resumed (skipped re-execution)"
                result.steps.append(sr)
                self._emit_step(sr)
                self._think("解析", f"{step_id}: 断点续跑跳过(产物已恢复)")
                return True
            # 恢复失败 → 后续正常执行
            ctx.resume_point = ""
            return False
        return False

    def _restore_step_state(self, ctx: PipelineContext,
                            ckpt: CheckpointManager, step_id: str) -> bool:
        """从 checkpoint 恢复该步产物到 ctx。恢复成功返回 True。"""
        data = ckpt.load() or {}
        entry = (data.get("steps") or {}).get(step_id) or {}
        try:
            if step_id == "1_decompose":
                di = entry.get("doc_intent")
                if not di:
                    return False
                ctx.doc_intent = self._dict_to_doc_intent(di)
            elif step_id == "2_partition":
                ctx.partitions = entry.get("partitions") or {}
            elif step_id == "3_fill":
                frags = entry.get("fragments")
                if frags is None:
                    return False
                ctx.fragments = [self._dict_to_fragment(f) for f in frags]
            elif step_id == "4_assemble":
                subs = entry.get("sub_tasks")
                frags = entry.get("fragments")
                if subs is None or frags is None:
                    return False
                ctx.sub_tasks = list(subs)
                ctx.fragments = [self._dict_to_fragment(f) for f in frags]
            elif step_id == "5_verify":
                pass  # 无新 ctx 状态
            elif step_id == "6_write":
                ctx.produced = entry.get("produced") or {}
                subs = entry.get("sub_tasks")
                if subs is not None:
                    ctx.sub_tasks = list(subs)
            else:
                return False
            return True
        except Exception:
            logger.warning(f"恢复 {step_id} 状态失败", exc_info=True)
            return False

    @staticmethod
    def _dict_to_doc_intent(d: dict) -> DocIntent:
        steps = [StepCard(
            step_id=s.get("step_id", ""), title=s.get("title", ""),
            content=s.get("content", ""),
            involved_elements=s.get("involved_elements", []),
            branches=s.get("branches", []),
            dialog_fragments=s.get("dialog_fragments", []))
            for s in (d.get("steps") or [])]
        return DocIntent(
            source_path=d.get("source_path", ""), file_type=d.get("file_type", ""),
            steps=steps, records=d.get("records", []),
            symbol_map=d.get("symbol_map", {}), raw_text=d.get("raw_text", ""),
            ok=d.get("ok", True), error=d.get("error", ""))

    @staticmethod
    def _dict_to_fragment(f: dict) -> AgentFragment:
        return AgentFragment(
            agent_name=f.get("agent_name", ""),
            produces=f.get("produces"),
            references=f.get("references", []),
            sql_or_ops=f.get("sql_or_ops", []),
            thinking_steps=f.get("thinking_steps", []),
            ok=f.get("ok", True), error=f.get("error", ""),
            target_table=f.get("target_table", ""),
            target_sheet=f.get("target_sheet", ""))

    def run(self, input_path: str, text: str = "",
            session_id: str = "default",
            workspace: str = "Trunk") -> PipelineResult:
        """管道入口:7 步固定工作流。

        Args:
            input_path: 输入文件路径(.md/.xlsx/.csv/.txt)
            text: 用户原始文本(含文件路径 + 补充说明)
            session_id: 会话 id
            workspace: 工作区逻辑名

        Returns:
            PipelineResult(含 ok 汇总 + errors 聚合 + produced 映射)
        """
        result = PipelineResult()
        # 输出目录:输入文件同目录下 {stem}_output/
        p = Path(input_path)
        output_dir = p.parent / f"{p.stem}_output"
        ctx = PipelineContext(
            input_path=input_path, output_dir=str(output_dir),
            workspace=workspace, session_id=session_id,
        )
        ckpt = CheckpointManager(output_dir)

        try:
            # Step 0: 断点检查
            if not self._step0_checkpoint(ctx, ckpt, result):
                return result

            # Step 1: 拆解
            if not self._step1_decompose(ctx, ckpt, result):
                return result

            # Step 2: 分区
            if not self._step2_partition(ctx, ckpt, result):
                return result

            # Step 3: 并行填表
            if not self._step3_fill(ctx, ckpt, result):
                return result

            # Step 4: 汇总
            if not self._step4_assemble(ctx, ckpt, result):
                return result

            # Step 5: 验证
            if not self._step5_verify(ctx, ckpt, result):
                # 验证失败 → 回退 Step3 一次
                if ctx.retry_count < 1:
                    ctx.retry_count += 1
                    self._think("校验", "Step5: 验证失败,回退 Step3 重试一次")
                    if not self._step3_fill(ctx, ckpt, result):
                        return result
                    if not self._step4_assemble(ctx, ckpt, result):
                        return result
                    if not self._step5_verify(ctx, ckpt, result):
                        return result
                else:
                    return result

            # Step 6: 写库
            if not self._step6_write(ctx, ckpt, result):
                return result

            # Step 7: 清理
            self._step7_cleanup(ctx, ckpt, result)

            # 全成功
            result.ok = True
            result.sub_tasks = ctx.sub_tasks
            result.message = result.aggregated_message
        except Exception as e:
            logger.error("管道执行异常", exc_info=True)
            result.add_error("pipeline", f"执行异常: {e}")
            result.message = result.aggregated_message
        return result

    # ── Step 0: 断点检查 ──
    def _step0_checkpoint(self, ctx: PipelineContext, ckpt: CheckpointManager,
                          result: PipelineResult) -> bool:
        sr = ctx.add_step("0_checkpoint", "Step0断点检查")
        self._think("解析", "Step0: 检查断点")
        data = ckpt.load()
        if data is None:
            ckpt.init_checkpoint(flow="generic", scene=Path(ctx.input_path).stem,
                                 workspace=ctx.workspace, script_path=ctx.input_path)
            self._think("解析", "Step0: 无断点,从头开始")
        elif ckpt.is_complete():
            self._think("解析", "Step0: 检测到已完成,询问是否重跑")
            # 默认重跑(管道模式自动重跑,实际可由调用方拦截)
            ckpt.init_checkpoint(flow="generic", scene=Path(ctx.input_path).stem,
                                 workspace=ctx.workspace, script_path=ctx.input_path)
        else:
            resume = ckpt.get_resume_point()
            ctx.resume_point = resume or ""
            if resume:
                self._think("解析", f"Step0: 检测到断点 {resume},从该步续跑(跳过已完成步骤)")
            else:
                self._think("解析", "Step0: 无断点,从头开始")
        sr.status = "done"
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("0_checkpoint", "done", output=str(ctx.output_dir))
        return True

    # ── Step 1: 拆解(parse_file → DocIntent + 符号映射表) ──
    def _step1_decompose(self, ctx: PipelineContext, ckpt: CheckpointManager,
                         result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "1_decompose"):
            return True
        sr = ctx.add_step("1_decompose", "Step1拆解")
        self._think("解析", f"Step1: 解析文件 {ctx.input_path}")
        doc = parse_file(ctx.input_path, cli=self.cli)
        if not doc.ok:
            sr.status = "failed"
            sr.error = doc.error
            result.add_error("1_decompose", doc.error)
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("1_decompose", "failed", error=doc.error)
            return False
        assign_symbols(doc)
        ctx.doc_intent = doc
        sr.status = "done"
        sr.output = f"{len(doc.steps)} steps, {len(doc.records)} records, {len(doc.symbol_map)} symbols"
        self._think("解析", f"Step1: 拆解完成: {sr.output}")
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("1_decompose", "done", output=sr.output,
                    extra={"doc_intent": asdict(ctx.doc_intent)})
        return True

    # ── Step 2: 分区(查 _table_index.json + table_resolver) ──
    def _step2_partition(self, ctx: PipelineContext, ckpt: CheckpointManager,
                         result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "2_partition"):
            return True
        sr = ctx.add_step("2_partition", "Step2分区")
        self._think("路由", "Step2: 确定目标表/sheet")
        doc = ctx.doc_intent
        # 从步骤卡片/记录提取目标表线索
        clues = set()
        for step in (doc.steps or []):
            for elem in step.involved_elements:
                clues.add(elem.get("type", ""))
        if not clues and doc.records:
            clues.add("record")
        # 用 table_resolver 定位
        for clue in clues:
            try:
                tr = self.table_resolver.resolve(clue)
                if tr:
                    ctx.partitions[clue] = f"{tr.table_stem}:{tr.sheet}"
            except Exception:
                pass
        sr.status = "done"
        sr.output = str(ctx.partitions)
        self._think("路由", f"Step2: 分区确认: {ctx.partitions}")
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("2_partition", "done", output=sr.output,
                    extra={"partitions": ctx.partitions})
        return True

    # ── Step 3: 并行填表(派发 SubAgent) ──
    def _step3_fill(self, ctx: PipelineContext, ckpt: CheckpointManager,
                    result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "3_fill"):
            return True
        sr = ctx.add_step("3_fill", "Step3并行填表")
        self._think("执行", "Step3: 派发并行填表 SubAgent")
        # 构造 SubAgent(初版:按涉及元素类型分组)
        subagents, prompts = self._build_subagents(ctx)
        if not subagents:
            # 无可派发:跳过(如纯 xlsx 输入无配表需求)
            sr.status = "done"
            sr.output = "no subagents needed"
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("3_fill", "done", output=sr.output)
            return True
        fragments = self._dispatch_with_retry(subagents, prompts, ctx, ckpt, sr, result)
        ctx.fragments = fragments
        ok_all = all(f.ok for f in fragments)
        if not ok_all:
            failed = [f.agent_name for f in fragments if not f.ok]
            sr.status = "failed"
            sr.error = f"failed agents: {failed}"
            result.add_error("3_fill", sr.error)
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("3_fill", "failed", error=sr.error,
                        extra={"retry_count": ctx.retry_count})
            return False
        sr.status = "done"
        sr.output = f"{len(fragments)} fragments produced"
        self._think("执行", f"Step3: 填表完成: {sr.output}")
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("3_fill", "done", output=sr.output,
                    extra={"retry_count": ctx.retry_count,
                           "fragments": [asdict(f) for f in ctx.fragments]})
        return True

    def _dispatch_with_retry(self, subagents, prompts, ctx, ckpt, sr, result):
        """派发 SubAgent + 单 SubAgent 失败重试 1 次(不递归)。"""
        fragments = dispatch(subagents, prompts, ctx.__dict__,
                             thinking_sink=self.thinking_sink)
        # 检测失败 SubAgent,对每个重试 1 次
        has_failure = any(not f.ok for f in fragments)
        if has_failure and ctx.retry_count < 1:
            ctx.retry_count += 1
            ckpt.update("3_fill", "pending", output="retrying",
                        extra={"retry_count": ctx.retry_count})
            self._think("执行", "Step3: SubAgent 失败,重试 1 次(非递归)")
            # 仅重试失败的 SubAgent,保留成功的 fragment
            for i, frag in enumerate(fragments):
                if not frag.ok:
                    retry_frags = dispatch([subagents[i]], [prompts[i]],
                                            ctx.__dict__,
                                            thinking_sink=self.thinking_sink)
                    if retry_frags and retry_frags[0].ok:
                        fragments[i] = retry_frags[0]
                        self._think("执行", f"Step3: {frag.agent_name} 重试成功")
                    else:
                        self._think("执行", f"Step3: {frag.agent_name} 重试仍失败")
        return fragments

    def _build_subagents(self, ctx: PipelineContext):
        """根据 DocIntent 构造 SubAgent 列表 + prompts。

        用角色化 SubAgent(对齐 example.html flow-quest 的 3 个并行 Agent):
        - DialogFillAgent: 对话表族
        - ItemNpcFillAgent: NPC+道具+显隐+奇遇联合
        - ButterflyEventFillAgent: 任务主表族
        子类可重写以定制 Agent 角色。
        """
        from ..subagent.roles import (
            DialogFillAgent, ItemNpcFillAgent, ButterflyEventFillAgent, GenericFillAgent
        )
        doc = ctx.doc_intent
        if not doc or not doc.steps:
            return [], []
        # 收集涉及的实体类型
        types = set()
        for step in doc.steps:
            for elem in step.involved_elements:
                types.add(elem.get("type", "npc"))
        subagents = []
        prompts = []
        if "dlg" in types or "dialog" in types:
            subagents.append(DialogFillAgent(parser=self.parser, cli=self.cli))
            prompts.append("根据拆解结果生成 Dialog_Dialog 表 INSERT 片段,用符号引用 NPC")
        if "npc" in types or "item" in types:
            subagents.append(ItemNpcFillAgent(parser=self.parser, cli=self.cli))
            prompts.append("生成 Npc_Npc/Item_Item/ShowHideNpc_Tool/QiYu_Message 表 INSERT 片段")
        if "task" in types:
            subagents.append(ButterflyEventFillAgent(parser=self.parser, cli=self.cli))
            prompts.append("生成 Task_Task/Task_BurstTask/Task_TaskState 表 INSERT 片段")
        if not subagents:
            subagents.append(GenericFillAgent(parser=self.parser, cli=self.cli))
            prompts.append("根据拆解结果生成对应表 INSERT 片段")
        return subagents, prompts

    # ── Step 4: 汇总(拓扑排序 + 符号闭环校验,不写库) ──
    def _step4_assemble(self, ctx: PipelineContext, ckpt: CheckpointManager,
                        result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "4_assemble"):
            return True
        sr = ctx.add_step("4_assemble", "Step4汇总")
        self._think("校验", "Step4: 汇总 + 符号引用闭环校验")
        # 符号引用闭环校验:每个引用必须有 produces 声明
        produces_set = {f.produces for f in ctx.fragments if f.produces}
        for frag in ctx.fragments:
            for ref in frag.references:
                if ref not in produces_set:
                    sr.status = "failed"
                    sr.error = f"dangling_symbol: {ref}"
                    result.add_error("4_assemble", sr.error)
                    result.dirty_data = True
                    ckpt.update("4_assemble", "failed", error=sr.error)
                    return False
        # 把 fragment 转 NLIntent(仅用于拓扑排序,不执行 run_single)
        intents = self._fragments_to_intents(ctx.fragments)
        try:
            # 复用 orchestrator 的拓扑排序能力算依赖顺序(不调 run,避免此处写库)
            order = OperationOrchestrator._topo_order(intents)
            # 装配 sub_tasks(按拓扑顺序),produced 留到 Step6 写库后填充
            seq_counter: dict[str, int] = {}
            for idx, i in enumerate(order):
                it = intents[i]
                frag = ctx.fragments[i] if i < len(ctx.fragments) else None
                ctx.sub_tasks.append({
                    "index": idx + 1,
                    "intent_action": getattr(it, "action", "add"),
                    "ok": None,  # 待 Step6 写库后回填
                    "message": "",
                    "table_stem": getattr(it, "table_hint", "") or (frag.target_table if frag else ""),
                })
            # 把拓扑顺序的 fragment 列表回写 ctx,供 Step6 按依赖序写库
            ctx.fragments = [ctx.fragments[i] for i in order if i < len(ctx.fragments)]
        except Exception as e:
            sr.status = "failed"
            sr.error = f"assemble error: {e}"
            result.add_error("4_assemble", sr.error)
            result.failed_tables = [f.target_table for f in ctx.fragments]
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("4_assemble", "failed", error=sr.error)
            return False
        sr.status = "done"
        sr.output = f"{len(ctx.sub_tasks)} sub_tasks assembled (topo order)"
        self._think("校验", f"Step4: 汇总完成: {sr.output}")
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("4_assemble", "done", output=sr.output,
                    extra={"sub_tasks": ctx.sub_tasks,
                           "fragments": [asdict(f) for f in ctx.fragments]})
        return True

    def _fragments_to_intents(self, fragments: list[AgentFragment]) -> list[NLIntent]:
        """AgentFragment → NLIntent(扑排序)。"""
        intents = []
        for frag in fragments:
            for op in frag.sql_or_ops:
                if isinstance(op, dict):
                    it = NLIntent(
                        action=op.get("action", "add"),
                        table_hint=frag.target_table or op.get("table_hint"),
                        sheet_hint=frag.target_sheet or op.get("sheet_hint"),
                        raw=op.get("raw", ""),
                    )
                    if frag.produces:
                        it.extras["produces"] = frag.produces.lstrip("<>").rstrip(">")
                    intents.append(it)
        return intents

    # ── Step 5: 验证(skill 体系 + 规则终检) ──
    def _step5_verify(self, ctx: PipelineContext, ckpt: CheckpointManager,
                      result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "5_verify"):
            return True
        sr = ctx.add_step("5_verify", "Step5验证")
        self._think("校验", "Step5: 规则终检 + 符号引用校验")
        try:
            verify_result = self.verifier.verify(ctx.fragments, ctx.produced)
            if not verify_result.get("ok", True):
                sr.status = "failed"
                sr.error = verify_result.get("error", "verification failed")
                for rule in verify_result.get("violations", []):
                    result.add_error("5_verify", f"rule: {rule}")
                result.steps.append(sr)
                self._emit_step(sr)
                ckpt.update("5_verify", "failed", error=sr.error)
                return False
        except Exception as e:
            sr.status = "failed"
            sr.error = f"verify error: {e}"
            result.add_error("5_verify", sr.error)
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("5_verify", "failed", error=sr.error)
            return False
        sr.status = "done"
        sr.output = "all rules passed"
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("5_verify", "done", output=sr.output)
        return True

    # ── Step 6: 写库(cli_interface + instrument + 符号回查) ──
    def _step6_write(self, ctx: PipelineContext, ckpt: CheckpointManager,
                     result: PipelineResult) -> bool:
        if self._maybe_skip(ctx, ckpt, result, "6_write"):
            return True
        sr = ctx.add_step("6_write", "Step6写库")
        self._think("执行", "Step6: 写库 + 符号引用回查")
        if self.cli is None:
            sr.status = "failed"
            sr.error = "no cli available"
            result.add_error("6_write", sr.error)
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("6_write", "failed", error=sr.error)
            return False
        # 包 instrument(管道模式开启)
        instrumented_cli = instrument(self.cli, sink=self.tool_sink, enabled=True)
        # writer 路径:临时把 writer.cli 换成 instrumented,让 run_as_writer 内部
        # 调 _run_single → _run_add 的 cli.append_row 也经 instrument 捕获 tool 记录
        orig_writer_cli = None
        if self._writer is not None and hasattr(self._writer, "cli"):
            orig_writer_cli = self._writer.cli
            self._writer.cli = instrumented_cli
        try:
            # 执行各 fragment 的 sql_or_ops(真写库,经 instrumented_cli 捕获 tool 记录)
            seq_counter: dict[str, int] = {}
            for idx, frag in enumerate(ctx.fragments):
                # 给 fragment 注入 instrumented_cli(若 writer 用 cli 原语)
                frag._cli = instrumented_cli
                # 写前占位符替换:用已 produced 的真实 ID 替换 fields 中的 placeholder
                self._resolve_frag_placeholders(frag, ctx.produced)
                if self._writer is not None and hasattr(self._writer, "run_as_writer"):
                    # 复用 TableAgent.run_as_writer 做 Step6 写库执行器
                    write_res = self._writer.run_as_writer(
                        frag, context={"produced": ctx.produced},
                        session_id=ctx.session_id)
                    if write_res is None or write_res.ok is not True:
                        sr.status = "failed"
                        sr.error = f"write failed: {frag.agent_name} - {getattr(write_res, 'message', '')}"
                        result.add_error("6_write", sr.error)
                        result.dirty_data = True
                        result.steps.append(sr)
                        self._emit_step(sr)
                        ckpt.update("6_write", "failed", error=sr.error)
                        return False
                    # 写库成功:从 write_res 提取新 ID → ctx.produced
                    intent = NLIntent(action="add",
                                      table_hint=frag.target_table,
                                      sheet_hint=frag.target_sheet,
                                      extras={"produces": frag.produces} if frag.produces else {})
                    OperationOrchestrator._capture_produced(
                        write_res, intent, ctx.produced, seq_counter)
                    # 回填 sub_tasks[idx].ok/message
                    if idx < len(ctx.sub_tasks):
                        ctx.sub_tasks[idx]["ok"] = True
                        ctx.sub_tasks[idx]["message"] = getattr(write_res, "message", "")
                else:
                    # 无 writer:降级用 instrumented_cli 原语直接执行 op
                    for op in frag.sql_or_ops:
                        if isinstance(op, dict):
                            self._execute_op(instrumented_cli, op, ctx)
            # 符号引用回查:ctx.produced 已在 Step6 写库后填充,校验引用符号已解析
            produces_set = {f.produces for f in ctx.fragments if f.produces}
            referenced = set()
            for frag in ctx.fragments:
                referenced.update(frag.references)
            unresolved = [ph for ph in referenced
                          if ph not in ctx.produced and ph not in produces_set]
            if unresolved:
                sr.status = "failed"
                sr.error = f"unresolved_symbol: {unresolved}"
                result.add_error("6_write", sr.error)
                result.steps.append(sr)
                self._emit_step(sr)
                ckpt.update("6_write", "failed", error=sr.error)
                return False
        except Exception as e:
            sr.status = "failed"
            sr.error = f"write error: {e}"
            result.add_error("6_write", sr.error)
            result.dirty_data = True
            result.steps.append(sr)
            self._emit_step(sr)
            ckpt.update("6_write", "failed", error=sr.error)
            return False
        finally:
            # 还原 writer.cli(避免 instrument 代理泄漏到旧路径)
            if orig_writer_cli is not None and self._writer is not None:
                self._writer.cli = orig_writer_cli
        sr.status = "done"
        sr.output = f"{sum(len(f.sql_or_ops) for f in ctx.fragments)} ops written"
        result.produced = ctx.produced
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("6_write", "done", output=sr.output,
                    extra={"produced": ctx.produced,
                           "sub_tasks": ctx.sub_tasks})
        return True

    def _resolve_frag_placeholders(self, frag: AgentFragment,
                                    produced: dict[str, str]) -> None:
        """写前用 produced 真实 ID 替换 fragment fields 中的 placeholder。"""
        if not produced or not frag.sql_or_ops:
            return
        for op in frag.sql_or_ops:
            if not isinstance(op, dict):
                continue
            fields = op.get("fields")
            if not isinstance(fields, dict):
                continue
            for k, v in list(fields.items()):
                if isinstance(v, str):
                    for ph, rid in produced.items():
                        if ph in v:
                            fields[k] = v.replace(ph, rid)

    def _execute_op(self, cli, op: dict, ctx: PipelineContext) -> None:
        """降级执行单 op(无 writer 时用 cli 原语)。"""
        action = op.get("action", "get")
        table = op.get("table_hint", "")
        sheet = op.get("sheet_hint", "")
        fields = op.get("fields", {})
        produced = ctx.produced
        # 占位符替换
        def _sub(v):
            if not isinstance(v, str):
                return v
            for ph, rid in produced.items():
                if ph in v:
                    v = v.replace(ph, rid)
            return v
        fields = {k: _sub(v) for k, v in fields.items()} if fields else {}
        try:
            if action == "add" and hasattr(cli, "append_row"):
                # fields → dict[int, Any] (需列索引,降级跳过)
                cli.append_row(table, sheet, fields)
            elif action == "set" and hasattr(cli, "write_cell"):
                cli.write_cell(table, sheet, fields)
        except Exception:
            logger.warning(f"降级 op 执行失败: table={table}", exc_info=True)

    def _run_single_writer(self, intent: NLIntent, confirm_token: Optional[str],
                           session_id: str):
        """orchestrator 的 run_single 回调:Step6 写库执行器。

        复用 TableAgent.run_as_writer(若注入)或降级调 cli 原语。
        """
        if self._writer is not None and hasattr(self._writer, "run_as_writer"):
            # 把 intent 包成 fragment 调 run_as_writer
            from .types import AgentFragment
            frag = AgentFragment(
                agent_name="orchestrator_single",
                produces=(intent.extras or {}).get("produces"),
                sql_or_ops=[{"action": intent.action, "table_hint": intent.table_hint,
                             "sheet_hint": intent.sheet_hint,
                             "fields": (intent.extras or {}).get("fields", {})}],
                target_table=intent.table_hint or "",
                target_sheet=intent.sheet_hint or "",
            )
            return self._writer.run_as_writer(
                frag, context={"produced": {}}, session_id=session_id)
        return None

    # ── Step 7: 清理 + 报告 ──
    def _step7_cleanup(self, ctx: PipelineContext, ckpt: CheckpointManager,
                       result: PipelineResult) -> None:
        if self._maybe_skip(ctx, ckpt, result, "7_cleanup"):
            return
        sr = ctx.add_step("7_cleanup", "Step7清理")
        self._think("执行", "Step7: 清理中间文件 + 生成报告")
        # 生成汇总报告
        report_path = Path(ctx.output_dir) / f"{Path(ctx.input_path).stem}_写入报告.md"
        try:
            report_path.parent.mkdir(parents=True, exist_ok=True)
            report_path.write_text(self._build_report(ctx, result),
                                   encoding="utf-8")
            result.report_path = str(report_path)
        except Exception as e:
            logger.warning(f"报告生成失败: {e}", exc_info=True)
        sr.status = "done"
        sr.output = str(report_path)
        result.steps.append(sr)
        self._emit_step(sr)
        ckpt.update("7_cleanup", "done", output=sr.output)

    def _build_report(self, ctx: PipelineContext, result: PipelineResult) -> str:
        """生成汇总报告:做了什么 + 中间产物 + 提醒。"""
        lines = [
            f"# 管道执行报告: {Path(ctx.input_path).stem}",
            "",
            "## 执行步骤",
            "",
        ]
        for sr in result.steps:
            status_mark = "✓" if sr.status == "done" else "✗"
            lines.append(f"- {status_mark} **{sr.name}**: {sr.output or sr.error or ''}")
        lines.extend([
            "",
            "## 符号映射表(produced)",
            "",
        ])
        for ph, rid in ctx.produced.items():
            lines.append(f"- `{ph}` → `{rid}`")
        lines.extend([
            "",
            "## 子任务汇总",
            "",
        ])
        for st in ctx.sub_tasks:
            lines.append(f"- {st.get('index')}. {st.get('intent_action')} → {st.get('table_stem')} ({'成功' if st.get('ok') else '失败'})")
        if result.errors:
            lines.extend([
                "",
                "## 错误汇总",
                "",
            ])
            for e in result.errors:
                lines.append(f"- {e['step']}: {e['error']}")
        lines.extend([
            "",
            "## 提醒事项",
            "",
            "- 中间 fragment 文件已清理",
            "- 如需重新执行,删除 `_checkpoint.json` 后重跑",
            "- 符号引用回查结果见上方符号映射表",
        ])
        return "\n".join(lines)
