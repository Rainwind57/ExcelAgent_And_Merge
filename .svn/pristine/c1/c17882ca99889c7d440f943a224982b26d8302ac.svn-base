"""第一批改动（#24/#25/#33）前后对比样例。

不跑全量，仅 3 个最小样例展示每项改动的 before→after 效果：

  样例1 (#24 语义相等归一)：eval_seed id=2（100/"100.0"/"1e2"）
       before: str() 比对 → 假冲突（false_conflict_rate=0.5）
       after : _semantic_eq 归一 → 非冲突（false_conflict_rate=0.0）

  样例2 (#25 splitter 跳 Step4)：extras.source=='splitter' 的 intent
       before: _phase_validate 调 ai_validate_plan（1 次 LLM 往返 + 幻觉风险）
       after : 检测 splitter 早返回，走规则校验（省 1 次 LLM）

  样例3 (#33 未变更表跳过 compare)：version_meta 所有衍生 rev==base rev
       before: _build_group 对每 sheet 跑 compare_sheet（CPU 全量比对）
       after : 跳过 compare_sheet，返回 structural_status="no_change"

用法: python -m tests.samples_first_batch   （在 server/ 下）
      python tests/samples_first_batch.py
"""
from __future__ import annotations

import os
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from engine.compare import _semantic_key, _semantic_eq, compare_sheet
from engine.parser import read_group_files

SEED_DIR = Path(__file__).resolve().parent / "merge_fixtures" / "seeds"


def _ensure_seeds():
    if not (SEED_DIR / "eval_seed.xlsx").exists():
        from tests.merge_fixtures.gen_merge_seeds import gen_seeds
        gen_seeds()


def _read_eval_group():
    files = [str(SEED_DIR / "eval_seed.xlsx"),
             str(SEED_DIR / "eval_seed_1.xlsx"),
             str(SEED_DIR / "eval_seed_2.xlsx")]
    rg = read_group_files(files)
    file_sheets = {fn: tup[0] for fn, tup in rg.items()}
    file_formulas = {fn: tup[1] for fn, tup in rg.items()}
    import re
    all_fns = list(file_sheets.keys())
    base = [n for n in all_fns if not re.search(r"_\d+$", Path(n).stem)][0]
    return file_sheets, file_formulas, base


# ──────────────────────────────────────────────────────────────
# 样例1: #24 语义相等归一
# ──────────────────────────────────────────────────────────────
def sample1_semantic_eq():
    print("=" * 64)
    print("样例1 (#24 语义相等归一): eval_seed id=2  100 / '100.0' / '1e2'")
    print("=" * 64)
    _ensure_seeds()
    file_sheets, file_formulas, base = _read_eval_group()
    sn = list(file_sheets[base].keys())[0]

    # ── before: 旧 str() 比对（复刻 #24 前的逻辑）──
    id2_versions = {"base": 100, "dev1": "100.0", "dev2": "1e2"}
    base_str = str(100)
    changed_before = {fn: v for fn, v in id2_versions.items()
                      if (str(v) if v is not None else '') != base_str}
    distinct_before = {str(v) for v in changed_before.values()}
    conflict_before = len(distinct_before) > 1
    print(f"\n[before] str() 比对:")
    print(f"  base_str={base_str!r}  changed_versions={changed_before}")
    print(f"  distinct_changed={distinct_before}  → conflict={conflict_before}")
    print(f"  → id=2 被标为假冲突（false_conflict_rate=0.5）")

    # ── after: _semantic_eq 归一（#24 后）──
    base_key = _semantic_key(100)
    changed_after = {fn: v for fn, v in id2_versions.items()
                     if _semantic_key(v) != base_key}
    distinct_after = {_semantic_key(v) for v in changed_after.values()}
    conflict_after = len(distinct_after) > 1
    print(f"\n[after] _semantic_key 归一:")
    print(f"  base_key={base_key}  changed_versions={changed_after}")
    print(f"  distinct_changed={distinct_after}  → conflict={conflict_after}")
    print(f"  → id=2 自动消解为非冲突（false_conflict_rate=0.0）")

    # ── 实跑 compare_sheet 验证 ──
    r = compare_sheet(file_sheets, base, sn, file_formulas=file_formulas)
    id2_cell = None
    for row in r["rows"]:
        if str(row.get("key")) == "2":
            for c in row.get("cells", []):
                if r["headers"][c["col"]] == "value":
                    id2_cell = c
    print(f"\n[实跑 compare_sheet] id=2 value cell:")
    print(f"  conflict={id2_cell['conflict']}  changed={id2_cell['changed']}  "
          f"diff_type={id2_cell['diff_type']!r}")
    print(f"  stats: conflicts={r['stats']['conflicts']}  (预期 conflicts=1，仅 id=1)")
    assert id2_cell["conflict"] is False, "#24 后 id=2 不应是冲突"
    assert r["stats"]["conflicts"] == 1, f"预期仅 id=1 冲突，got {r['stats']['conflicts']}"
    print("\n  ✓ #24 验证通过：id=2 假冲突已消解")


# ──────────────────────────────────────────────────────────────
# 样例2: #25 splitter 跳 Step4
# ──────────────────────────────────────────────────────────────
def sample2_splitter_skip_step4():
    print("\n" + "=" * 64)
    print("样例2 (#25 splitter 跳 Step4 ai_validate_plan)")
    print("=" * 64)

    # _phase_validate 的门控条件（复刻 agent.py:4595）：
    #   if (self._ai_enhancer is not None and intent.action in ("add","set")
    #           and intent.extras.get("source") != "splitter"):
    def _validate_would_call_llm(action, source):
        return action in ("add", "set") and source != "splitter"

    cases = [
        ("普通 intent（source=nl）", "add", "nl"),
        ("splitter intent（source=splitter）", "add", "splitter"),
        ("splitter intent（source=splitter, action=set）", "set", "splitter"),
    ]
    print("\n  场景                              | action | source   | 调 ai_validate_plan?")
    print("  " + "-" * 70)
    for label, action, source in cases:
        will = _validate_would_call_llm(action, source)
        before = "是（1 次 LLM 往返）"   # #25 前无条件调
        after = "是" if will else "否（跳过，省 1 次 LLM）"
        print(f"  {label:34s} | {action:6s} | {source:8s} | before={before} | after={after}")

    print("\n  [before] splitter intent 也调 ai_validate_plan → LLM 幻觉可能改字段（与 #19/#22 同源）")
    print("  [after ] splitter intent 早返回，走规则校验，省 1 次 LLM 往返")
    # 验证门控逻辑
    assert _validate_would_call_llm("add", "nl") is True
    assert _validate_would_call_llm("add", "splitter") is False
    assert _validate_would_call_llm("set", "splitter") is False
    print("\n  ✓ #25 门控逻辑验证通过：splitter intent 不再调 ai_validate_plan")


# ──────────────────────────────────────────────────────────────
# 样例3: #33 未变更表跳过 compare
# ──────────────────────────────────────────────────────────────
def sample3_no_change_skip():
    print("\n" + "=" * 64)
    print("样例3 (#33 未变更表跳过 compare_sheet)")
    print("=" * 64)
    _ensure_seeds()
    file_sheets, file_formulas, base = _read_eval_group()

    from routers.merge_stages import _build_group
    paths = [str(SEED_DIR / "eval_seed.xlsx"),
             str(SEED_DIR / "eval_seed_1.xlsx"),
             str(SEED_DIR / "eval_seed_2.xlsx")]
    base_name = Path(paths[0]).name

    # ── before: version_meta 缺失 → 走全量 compare ──
    print("\n[before] version_meta 无 rev（非 svn 模式）→ 走全量 compare_sheet:")
    t0 = time.perf_counter()
    fg_before = _build_group(paths, base_name=base_name, group_name="eval_seed",
                             merge_base_file=base_name, version_meta={})
    elapsed_before = (time.perf_counter() - t0) * 1000
    sn = list(fg_before.sheets.keys())[0]
    print(f"  structural_status={fg_before.structural_status!r}  "
          f"sheet rows={len(fg_before.sheets[sn].rows)}  "
          f"stats={fg_before.sheets[sn].stats}")
    print(f"  耗时={elapsed_before:.1f}ms（跑了 compare_sheet）")

    # ── after: version_meta 所有衍生 rev==base rev → 跳过 compare ──
    derived = [Path(p).name for p in paths if Path(p).name != base_name]
    rev_eq = "r00010"
    version_meta = {base_name: {"rev": rev_eq, "author": "", "date": ""}}
    for fn in derived:
        version_meta[fn] = {"rev": rev_eq, "author": "", "date": ""}

    print(f"\n[after] version_meta 所有 rev=={rev_eq}（svn 未改动）→ 跳过 compare:")
    t0 = time.perf_counter()
    fg_after = _build_group(paths, base_name=base_name, group_name="eval_seed",
                            merge_base_file=base_name, version_meta=version_meta)
    elapsed_after = (time.perf_counter() - t0) * 1000
    sn = list(fg_after.sheets.keys())[0]
    print(f"  structural_status={fg_after.structural_status!r}  "
          f"sheet rows={len(fg_after.sheets[sn].rows)}  "
          f"stats={fg_after.sheets[sn].stats}")
    print(f"  耗时={elapsed_after:.1f}ms（跳过 compare_sheet，仅读文件取表头）")

    speedup = elapsed_before / elapsed_after if elapsed_after > 0 else float("inf")
    print(f"\n  对比: {elapsed_before:.1f}ms → {elapsed_after:.1f}ms  (skip 比全量快 {speedup:.1f}x)")
    assert fg_after.structural_status == "no_change", "#33 后应标 no_change"
    assert len(fg_after.sheets[sn].rows) == 0, "no_change 表不应产出比对行"
    print("\n  ✓ #33 验证通过：未变更表跳过 compare，标 no_change")


if __name__ == "__main__":
    sample1_semantic_eq()
    sample2_splitter_skip_step4()
    sample3_no_change_skip()
    print("\n" + "=" * 64)
    print("第一批 3 项改动（#24/#25/#33）前后对比样例全部通过")
    print("=" * 64)
