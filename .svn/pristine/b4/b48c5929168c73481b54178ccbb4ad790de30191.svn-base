"""三阶段合并端到端验证（add-cross-producer-consolidation）。

完整双生产者流程：
  stage1(devbranch1) + stage1(devbranch2) → stage2 跨生产者综合 → stage3 合回 trunk

验证点：
  - 各阶段 conflict_origin：inter_commit / cross_producer / merge_back
  - 产出文件：item_merged_devbranch{1,2}.xlsx / item_consolidated.xlsx / item_1.xlsx
  - 阶段依赖：跳 stage2 直接 stage3 被拒；跳 stage1 直接 stage2 被拒

用法: python -X utf8 -m server.tests.verify_three_stage
前置: 先跑 merge/scripts/build_merge_materials.py 生成干净样本。
"""
from __future__ import annotations

import asyncio
import copy
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fastapi import HTTPException

from engine.models import MergeRequest, SheetMergeData
from routers import merge_stages as ms
from routers.merge_stages import (
    Stage1CompareRequest, Stage2CrossCompareRequest, Stage3CompareRequest,
    stage1_compare, stage1_consolidate, stage2_compare, stage2_consolidate,
    stage3_compare, stage3_apply,
    DEVBRANCH_DIR, TRUNK_DIR, STAGE1_MANIFEST, STAGE2_MANIFEST,
    _intermediate_name, _consolidated_name,
)

GROUP = "item"
BRANCH1 = "devbranch1"
BRANCH2 = "devbranch2"

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    print(f"  [{'PASS' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _group_to_sheets(group, resolve: bool = True, break_one: bool = False):
    """比对分组 → MergeRequest.sheets。resolve 清 conflict；break_one 保留一个未决。"""
    sheets = []
    broke = False
    for s in group.sheets.values():
        rows = copy.deepcopy(s.rows)
        for row in rows:
            for cell in row.cells:
                if getattr(cell, "conflict", False):
                    if break_one and not broke:
                        broke = True
                        continue
                    if resolve:
                        cell.conflict = False
        sheets.append(SheetMergeData(name=s.name, headers=s.headers, rows=rows))
    if break_one and not broke:
        for s in sheets:
            if s.rows and s.rows[0].cells:
                s.rows[0].cells[0].conflict = True
                broke = True
                break
    return sheets, broke


def _clean():
    """清残留产物，保证起点干净（含 trunk 版本化产出，保证从 item_1 起）。"""
    for f in [
        DEVBRANCH_DIR / _intermediate_name(GROUP, BRANCH1),
        DEVBRANCH_DIR / _intermediate_name(GROUP, BRANCH2),
        DEVBRANCH_DIR / _consolidated_name(GROUP),
    ]:
        if f.is_file():
            f.unlink()
    for m in [STAGE1_MANIFEST, STAGE2_MANIFEST]:
        if m.is_file():
            m.unlink()
    pat = re.compile(rf"^{re.escape(GROUP)}_\d+\.xlsx$")
    if TRUNK_DIR.is_dir():
        for fp in TRUNK_DIR.iterdir():
            if fp.is_file() and pat.match(fp.name):
                fp.unlink()


async def _run():
    _clean()
    inter1 = _intermediate_name(GROUP, BRANCH1)
    inter2 = _intermediate_name(GROUP, BRANCH2)
    cons = _consolidated_name(GROUP)

    # ── 阶段依赖：跳 stage1 直接 stage2 ──
    print("\n--- 阶段依赖：未完成 stage1 → stage2 被拒 ---")
    blocked = False
    try:
        await stage2_compare(Stage2CrossCompareRequest(group_name=GROUP))
    except HTTPException as e:
        blocked = e.status_code == 400
    _check("跳 stage1 → stage2 被拒", blocked)

    # ── 阶段1：devbranch1 合并多次提交 ──
    print("\n--- 阶段1（devbranch1）：合并多次提交 ---")
    r1 = await stage1_compare(Stage1CompareRequest(branch=BRANCH1, group_name=GROUP))
    _check("conflict_origin=inter_commit", r1.conflict_origin == "inter_commit", r1.conflict_origin)
    _check("基准=item_1.xlsx", r1.groups[GROUP].base_file == f"{GROUP}_1.xlsx")
    sheets1, _ = _group_to_sheets(r1.groups[GROUP], resolve=True)
    res1 = await stage1_consolidate(MergeRequest(
        branch=BRANCH1, group_name=GROUP, sheets=sheets1,
    ))
    _check("stage1(devbranch1) 产出", res1.get("ok") is True)
    _check("中间版本 item_merged_devbranch1.xlsx 存在", (DEVBRANCH_DIR / inter1).is_file())

    # ── 阶段1：devbranch2 合并多次提交 ──
    print("\n--- 阶段1（devbranch2）：合并多次提交 ---")
    r2 = await stage1_compare(Stage1CompareRequest(branch=BRANCH2, group_name=GROUP))
    _check("conflict_origin=inter_commit", r2.conflict_origin == "inter_commit", r2.conflict_origin)
    sheets2, _ = _group_to_sheets(r2.groups[GROUP], resolve=True)
    res2 = await stage1_consolidate(MergeRequest(
        branch=BRANCH2, group_name=GROUP, sheets=sheets2,
    ))
    _check("stage1(devbranch2) 产出", res2.get("ok") is True)
    _check("中间版本 item_merged_devbranch2.xlsx 存在", (DEVBRANCH_DIR / inter2).is_file())

    # ── 阶段依赖：未完成 stage2 直接 stage3 ──
    print("\n--- 阶段依赖：未完成 stage2 → stage3 被拒 ---")
    blocked = False
    try:
        await stage3_compare(Stage3CompareRequest(group_name=GROUP))
    except HTTPException as e:
        blocked = e.status_code == 400
    _check("跳 stage2 → stage3 被拒", blocked)

    # ── 阶段2：跨生产者综合 ──
    print("\n--- 阶段2：跨生产者综合 ---")
    rc = await stage2_compare(Stage2CrossCompareRequest(group_name=GROUP))
    _check("conflict_origin=cross_producer", rc.conflict_origin == "cross_producer", rc.conflict_origin)
    gc = rc.groups[GROUP]
    _check("stage2 base=fork快照(devbranch1_item.xlsx)", gc.base_file == f"{BRANCH1}_{GROUP}.xlsx", gc.base_file)
    # 综合比对含 fork + 两个中间版本
    files_in = set(gc.files)
    _check("比对含 fork 快照", f"{BRANCH1}_{GROUP}.xlsx" in files_in)
    _check("比对含两个中间版本", inter1 in files_in and inter2 in files_in, ",".join(sorted(files_in)))

    # 跨生产者冲突阻断：保留一个未决冲突
    print("\n--- 阶段2 阻断（未决冲突 → 禁止产出综合版本）---")
    sheets_c_break, broke_c = _group_to_sheets(gc, resolve=True, break_one=True)
    blocked_c = False
    try:
        await stage2_consolidate(MergeRequest(
            group_name=GROUP, branch="", sheets=sheets_c_break,
        ))
    except HTTPException as e:
        blocked_c = e.status_code == 400
    if broke_c:
        _check("跨生产者未决冲突 → consolidate 返回 400", blocked_c)
    else:
        _check("无自然跨生产者冲突（跳过阻断验证）", True)

    # 解决后产出综合版本
    print("\n--- 阶段2 产出综合版本 ---")
    sheets_c_ok, _ = _group_to_sheets(gc, resolve=True)
    resc = await stage2_consolidate(MergeRequest(
        group_name=GROUP, branch="", sheets=sheets_c_ok,
    ))
    _check("stage2 consolidate 成功", resc.get("ok") is True)
    _check("综合版本 item_consolidated.xlsx 存在", (DEVBRANCH_DIR / cons).is_file())
    _check("stage2 manifest 记录 stage2_ok",
           ms._read_stage2_manifest().get(cons, {}).get("stage2_ok") is True)

    # ── 阶段3：合回 trunk ──
    print("\n--- 阶段3：合回 trunk ---")
    r3 = await stage3_compare(Stage3CompareRequest(group_name=GROUP))
    _check("conflict_origin=merge_back", r3.conflict_origin == "merge_back", r3.conflict_origin)
    g3 = r3.groups[GROUP]
    _check("阶段3 base=merge-base(fork快照)", g3.base_file == f"{BRANCH1}_{GROUP}.xlsx", g3.base_file)
    # 三方：merge-base + trunk head + consolidated
    f3 = set(g3.files)
    _check("三方含 fork+trunk+consolidated",
           f"{BRANCH1}_{GROUP}.xlsx" in f3 and cons in f3 and len(f3) >= 3,
           ",".join(sorted(f3)))

    # 合回阻断：保留一个未决
    print("\n--- 阶段3 阻断（未决冲突 → 禁止写回）---")
    sheets3_break, broke3 = _group_to_sheets(g3, resolve=True, break_one=True)
    blocked3 = False
    try:
        await stage3_apply(MergeRequest(
            group_name=GROUP, branch="", sheets=sheets3_break,
        ))
    except HTTPException as e:
        blocked3 = e.status_code == 400
    if broke3:
        _check("合回未决冲突 → apply 返回 400", blocked3)
    else:
        _check("无自然合回冲突（跳过阻断验证）", True)

    print("\n--- 阶段3 合回产出 ---")
    sheets3_ok, _ = _group_to_sheets(g3, resolve=True)
    res3 = await stage3_apply(MergeRequest(
        group_name=GROUP, branch="", sheets=sheets3_ok,
    ))
    out_name = res3.get("output")
    out_path = TRUNK_DIR / out_name if out_name else None
    _check("stage3 apply 成功", res3.get("ok") is True)
    _check("版本化产出 item_1.xlsx", out_name == "item_1.xlsx", out_name or "")
    _check("merge/trunk/item_1.xlsx 存在", bool(out_path and out_path.is_file()), out_name or "")
    _check("合回后综合版本已消费", cons not in ms._read_stage2_manifest(), f"archived={res3.get('archived')}")

    # 清理产物
    _clean()
    if out_path and out_path.is_file():
        out_path.unlink()


def main():
    print("=" * 60)
    print("三阶段合并端到端验证（双生产者，add-cross-producer-consolidation）")
    print("=" * 60)
    asyncio.run(_run())
    print("\n" + "=" * 60)
    print(f"结果: {_passed} 通过, {_failed} 失败")
    print("=" * 60)
    sys.exit(1 if _failed else 0)


if __name__ == "__main__":
    main()
