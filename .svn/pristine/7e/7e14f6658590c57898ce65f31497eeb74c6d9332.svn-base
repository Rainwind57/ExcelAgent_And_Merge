"""任务5.4 端到端：branch merge_back（demo，自动目标=最新 trunk）。

验证 merge_back 的两项改动：
  1. 只选源分支，目标自动取最新 trunk（demo 下=trunk_r3，模拟前端 autoTargetForMergeBack）。
  2. apply 写回所选 trunk 目标（trunk_r3），而非旧实现硬编码的 merge/trunk；
     版本化产出 {group}_{N+1}.xlsx，审计 mode=branch_merge_back。
"""
import json
import sys
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SERVER_DIR))

from engine.models import SheetMergeData
from routers.merge_branch import branch_compare, branch_apply, BranchCompareRequest, BranchApplyRequest, TableApplyItem

AUDIT_LOG = SERVER_DIR.parent / "merge" / "trunk" / "_merge_audit.json"
TGT_FILE = "ability_tgt.xlsx"


def _latest_trunk_demo():
    """镜像前端 autoTargetForMergeBack：demo 源 → 最新 trunk_rN。"""
    return "trunk_r3"


def _resolve_to_target(resp):
    for g in resp.groups.values():
        for s in g.sheets.values():
            for r in s.rows:
                for c in r.cells:
                    if c.conflict:
                        c.value = c.versions.get(TGT_FILE, c.value)
                        c.conflict = False
                        c.changed = False
                        c.diff_type = ""


def _tables_payload(resp):
    """构建 apply 负载：跳过结构增删的只读展示分组（files<=1 无比对数据，不参与写回）。"""
    items = []
    for gn, g in resp.groups.items():
        if len(g.files) <= 1:
            continue
        sheets = [SheetMergeData(name=s.name, headers=s.headers, rows=s.rows)
                  for s in g.sheets.values()]
        items.append(TableApplyItem(group_name=gn, sheets=sheets))
    return items


def main():
    src = "A_r2"
    tgt = _latest_trunk_demo()   # merge_back 自动目标
    resp = branch_compare(BranchCompareRequest(
        direction="merge_back", source_branch=src, target_branch=tgt, group_names=["ability"],
    ))
    g = resp.groups["ability"]
    print(f"[merge_back] target=auto({tgt}) base={g.base_file} files={g.files}")
    assert resp.conflict_origin == "branch_merge_back", resp.conflict_origin
    assert len(g.files) >= 3, g.files

    _resolve_to_target(resp)
    result = branch_apply(BranchApplyRequest(
        direction="merge_back", source_branch=src, target_branch=tgt, tables=_tables_payload(resp),
    ))
    print(f"apply: {json.dumps(result, ensure_ascii=False)}")
    assert result["ok"], result
    r0 = result["results"][0]
    dest = Path(r0["path"])
    assert dest.is_file(), f"落点未生成: {dest}"
    # 关键：merge_back 落点应在所选 trunk 目标 trunk_r3 下（非旧实现的 merge/trunk）
    assert "trunk_r3" in dest.parts, f"merge_back 应写回 {tgt}，实际 {dest}"
    assert dest.name.startswith("ability_"), dest.name
    print(f"PASS merge_back → {dest.name} (写回 {tgt})")

    audit = json.loads(AUDIT_LOG.read_text(encoding="utf-8")) if AUDIT_LOG.is_file() else []
    assert audit and audit[0].get("mode") == "branch_merge_back", \
        f"审计最新条目 mode 应为 branch_merge_back：{audit[0] if audit else None}"
    print("PASS 审计 mode=branch_merge_back")

    dest.unlink(missing_ok=True)
    print("=== ALL PASS branch_merge_back ===")


if __name__ == "__main__":
    main()
