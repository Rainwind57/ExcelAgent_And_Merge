"""校验路由：ID 编号段校验 + 跨表查重。"""
from fastapi import APIRouter

from config import RESOURCES_DIR
from engine.id_scope import get_id_scope_validator

router = APIRouter(prefix="/api/validate", tags=["validate"])


@router.get("/id-scope")
async def validate_id_scope():
    """全目录 ID 校验：扫所有表 ID 列做跨表查重 + id_mgr 段校验。

    返回：
      - cross_table_conflicts: 跨表冲突列表（同编号出现在多个 .xlsx）
      - segment_violations: 越界模块列表（已用段超预留段）
      - scanned_tables: 扫描表数
      - id_mgr_loaded: id_mgr.xlsx 是否加载成功
    """
    v = get_id_scope_validator()
    report = v.validate_all(RESOURCES_DIR)
    return report.to_dict()
