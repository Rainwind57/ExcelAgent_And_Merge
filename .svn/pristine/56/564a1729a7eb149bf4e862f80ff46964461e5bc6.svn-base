"""任务5.4 端到端：branch compare（absorb 场景）。

数据源：merge/svn/demo_svn/wc（真实 SVN 工作副本，trunk + branches/dev1/dev2/subdev_1）。
直接调 branch_compare 函数。覆盖：自动反查 merge-base + 三方比对 + commit_authors 透传。

注：旧数据源 merge/svn/fixture/wc 与 merge/demo 已下线，统一迁至 demo_svn/wc。
"""
import sys
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SERVER_DIR))

from routers.merge_branch import branch_compare, BranchCompareRequest

DEMO_SVN_WC = SERVER_DIR.parent / "merge" / "svn" / "demo_svn" / "wc"


def main():
    if not (DEMO_SVN_WC / "branches" / "dev1").is_dir():
        print(f"SKIP: demo_svn/wc 不存在（{DEMO_SVN_WC}），请先初始化 SVN demo")
        return
    req = BranchCompareRequest(
        direction="absorb",
        source_branch=str(DEMO_SVN_WC / "branches" / "dev1"),
        target_branch=str(DEMO_SVN_WC / "trunk"),
        group_names=["ability"],
    )
    resp = branch_compare(req)
    group = resp.groups["ability"]
    print(f"ok group={group.group_name} base={group.base_file}")
    print(f"files={group.files}")
    print(f"conflict_origin={resp.conflict_origin}")
    for sname, sd in group.sheets.items():
        print(f"  sheet={sname} rows={len(sd.rows)} stats={sd.stats}")
    assert resp.conflict_origin == "branch_absorb", resp.conflict_origin
    assert group.base_file, "base_file empty"
    assert len(group.files) >= 3, f"三方文件不足: {group.files}"
    print("PASS branch_compare absorb")


if __name__ == "__main__":
    main()
