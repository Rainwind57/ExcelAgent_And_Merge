"""R14 中英文匹配验证脚本。

覆盖：
  1. column_aliases.yaml 中英别名加载（fabao/法宝、spirit/灵根 等）
  2. 中文输入命中英文列名（"法宝类型" → fabao_type）
  3. 英文输入命中中文列名（"fabao" → 法宝类型 列，用中文列名样例）
  4. 别名双向后缀匹配（alias endswith key / key endswith alias）
  5. 中英混排值匹配（行值含 "法宝 fabao"）

用法：
    cd server
    python -m tests.verify_bilingual
"""
from __future__ import annotations

import sys
import os
from pathlib import Path
from openpyxl import Workbook, load_workbook

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.excel.column_matcher import ColumnMatcher
from agent.excel.skill_loader import ColumnAliasConfig

results: list[tuple[str, bool, str]] = []


def check(name: str, cond: bool, detail: str = ""):
    results.append((name, cond, detail))
    mark = "PASS" if cond else "FAIL"
    print(f"{mark}  {name}" + (f"  [{detail}]" if detail and not cond else ""))


SAMPLE_PATH = Path(__file__).resolve().parent.parent.parent / "resources" / "bilingual_sample.xlsx"


def build_sample_if_missing():
    """若样例表不存在则构建。"""
    if SAMPLE_PATH.is_file():
        return
    wb = Workbook()
    ws = wb.active
    ws.title = "Fabao"
    ws.append(["fabao_id", "name", "fabao_type", "spirit", "atk", "desc"])
    rows = [
        [1001, "青莲宝色旗", "attack", "gold", 8888, "攻击型法宝"],
        [1002, "乾坤图", "defense", "wood", 5000, "防御型法宝"],
        [1003, "fabao sword", "attack", "fire", 7500, "fabao attack item"],
        [1004, "linggen jin", "support", "jin", 3000, "spirit root support"],
    ]
    for r in rows:
        ws.append(r)
    wb.save(SAMPLE_PATH)


def test_alias_loading():
    """1. 中英别名加载。"""
    cfg = ColumnAliasConfig.load()
    aliases = cfg.all_aliases("bilingual_sample", "Fabao")
    # R14 别名应在全局 '*'/'*' 中
    check("别名含 fabao→fabao_type", aliases.get("fabao") == "fabao_type",
          f"got {aliases.get('fabao')!r}")
    check("别名含 法宝→fabao_type", aliases.get("法宝") == "fabao_type",
          f"got {aliases.get('法宝')!r}")
    check("别名含 spirit→灵根 或 spirit→spirit", aliases.get("spirit") in ("灵根", "spirit"),
          f"got {aliases.get('spirit')!r}")
    check("别名含 灵根→spirit", aliases.get("灵根") == "spirit",
          f"got {aliases.get('灵根')!r}")
    check("别名含 攻击→atk", aliases.get("攻击") == "atk",
          f"got {aliases.get('攻击')!r}")


def test_chinese_input_hits_english_column():
    """2. 中文输入命中英文列名。"""
    cfg = ColumnAliasConfig.load()
    aliases = cfg.all_aliases("bilingual_sample", "Fabao")
    headers = ["fabao_id", "name", "fabao_type", "spirit", "atk", "desc"]
    matcher = ColumnMatcher(headers, aliases)

    m = matcher.match("法宝类型")
    check("中文'法宝类型'命中 fabao_type", m is not None and m.column == "fabao_type",
          f"got {m}")
    m = matcher.match("法宝id")
    check("中文'法宝id'命中 fabao_id", m is not None and m.column == "fabao_id",
          f"got {m}")
    m = matcher.match("灵根")
    check("中文'灵根'命中 spirit", m is not None and m.column == "spirit",
          f"got {m}")
    m = matcher.match("攻击力")
    check("中文'攻击力'命中 atk", m is not None and m.column == "atk",
          f"got {m}")


def test_english_input_hits_chinese_column():
    """3. 英文输入命中中文列名（双向后缀匹配）。"""
    cfg = ColumnAliasConfig.load()
    aliases = cfg.all_aliases("bilingual_sample", "Fabao")
    # 中文列名样例表头
    headers_cn = ["法宝id", "名称", "法宝类型", "灵根", "攻击力", "描述"]
    matcher = ColumnMatcher(headers_cn, aliases)

    # 英文别名 fabao → fabao_type，但表头无 fabao_type 列名
    # 阶段1别名命中 fabao_type，但表头无此列 → 回退阶段2/3 子串匹配
    # 这里验证阶段2：英文"fabao"作为子串命中"法宝类型"（含"法宝"）
    m = matcher.match("fabao_type")
    check("英文'fabao_type'命中 法宝类型列", m is not None and "法宝类型" in (m.column or ""),
          f"got {m}")
    m = matcher.match("spirit")
    check("英文'spirit'命中 灵根列", m is not None and "灵根" in (m.column or ""),
          f"got {m}")


def test_birectional_suffix_match():
    """4. 别名双向后缀匹配逻辑（alias endswith key / key endswith alias）。"""
    cfg = ColumnAliasConfig.load()
    aliases = cfg.all_aliases("bilingual_sample", "Fabao")
    headers = ["fabao_id", "name", "fabao_type", "spirit", "atk", "desc"]
    matcher = ColumnMatcher(headers, aliases)

    # "法宝的" 含别名 "法宝" → key endswith? 不，alias endswith key 不成立
    # 但 _match_one 阶段1: alias == key or key.endswith(alias) or alias.endswith(key)
    # "法宝类型属性" endswith "法宝类型"? No. 但 "法宝类型" endswith "法宝类型"? yes(==)
    m = matcher.match("法宝类型")
    check("后缀匹配：'法宝类型' 精确命中别名", m is not None and m.score == 1.0,
          f"got {m}")
    # "我的fabao_type" endswith "fabao_type" → key.endswith(alias)
    m = matcher.match("我的fabao_type")
    check("后缀匹配：'我的fabao_type' 命中 fabao_type", m is not None and m.column == "fabao_type",
          f"got {m}")


def test_mixed_value_matching():
    """5. 中英混排值匹配（行值含 '法宝 fabao'）。"""
    wb = load_workbook(SAMPLE_PATH, data_only=True)
    ws = wb["Fabao"]
    rows = list(ws.iter_rows(min_row=2, values_only=True))
    # 找含中英混排的行（desc 列含 'fabao attack item'）
    mixed = [r for r in rows if r and any("fabao" in str(v).lower() or "spirit" in str(v).lower() for v in r if v)]
    check("样例表含中英混排值", len(mixed) >= 1, f"got {len(mixed)} rows")
    # 验证定位列 fabao_type 的英文值 'attack' 可被搜索
    attack_rows = [r for r in rows if r and str(r[2]).lower() == "attack"]
    check("英文值 'attack' 行数 ≥2", len(attack_rows) >= 2, f"got {len(attack_rows)}")


def main():
    build_sample_if_missing()
    print("=== R14 中英文匹配验证 ===\n")
    test_alias_loading()
    test_chinese_input_hits_english_column()
    test_english_input_hits_chinese_column()
    test_birectional_suffix_match()
    test_mixed_value_matching()

    passed = sum(1 for _, ok, _ in results if ok)
    total = len(results)
    print(f"\n=== {passed}/{total} PASS ===")
    if passed != total:
        for name, ok, detail in results:
            if not ok:
                print(f"  FAIL: {name} {detail}")
        sys.exit(1)


if __name__ == "__main__":
    main()
