"""A/B/C/D 需求验证测试套件。

覆盖：
  - A: AI 看行信息（_resolve_row_ambiguity 注入整行数据）
  - B: 日期对齐相近行（write_cell 取众数 number_format）
  - C: 搜索性能（_search_via_index 倒排索引命中）
  - D: 前端跳转（TablesView.vue 有 gotoResult + 高亮）

用法：
    cd server
    python -m tests.verify_abcd
"""
from __future__ import annotations

import sys
import os
import tempfile
import shutil
from pathlib import Path
from datetime import datetime
from openpyxl import Workbook
from openpyxl.styles import Alignment, Font

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

results: list[tuple[str, bool, str]] = []


def check(name: str, cond: bool, detail: str = ""):
    results.append((name, cond, detail))
    mark = "PASS" if cond else "FAIL"
    print(f"{mark}  {name}" + (f"  [{detail}]" if detail and not cond else ""))


# ── A: AI 看行信息 ────────────────────────────────────────
def test_a_resolve_row_ambiguity_signature():
    """_resolve_row_ambiguity 签名含 path/sheet 参数。"""
    import inspect
    from agent.excel.agent import TableAgent
    sig = inspect.signature(TableAgent._resolve_row_ambiguity)
    params = list(sig.parameters.keys())
    check("A _resolve_row_ambiguity 含 path 参数", "path" in params,
          f"params={params}")
    check("A _resolve_row_ambiguity 含 sheet 参数", "sheet" in params,
          f"params={params}")


def test_a_resolve_row_ambiguity_injects_row_data():
    """歧义时构造的 prompt 含整行数据（列名=值）。"""
    from agent.excel.agent import TableAgent, RowMatch
    from agent.excel.cli_interface import StubCodeMakerCLI

    tmp = tempfile.mkdtemp()
    try:
        ws_dir = Path(tmp)
        wb = Workbook()
        s = wb.active
        s.title = "Data"
        s.cell(1, 1, "id")
        s.cell(1, 2, "名称")
        s.cell(1, 3, "品质")
        # 两行同名"饕餮"，品质不同
        s.cell(5, 1, 10); s.cell(5, 2, "饕餮"); s.cell(5, 3, 5)
        s.cell(6, 1, 11); s.cell(6, 2, "饕餮"); s.cell(6, 3, 3)
        p = ws_dir / "amb.xlsx"
        wb.save(p)

        cli = StubCodeMakerCLI(workspace=ws_dir, header_row=1, data_start_row=5)
        agent = TableAgent(cli=cli, parser=None)

        # 拦截 _llm_disambiguate 捕获 prompt
        captured: list[str] = []
        def fake_ask(q):
            captured.append(q)
            return "10"
        agent._llm_disambiguate = fake_ask

        # 构造歧义 RowMatch
        from agent.excel.nl_parser import NLIntent
        rm = RowMatch(row=5, value="饕餮", confidence=0.5, method="test",
                      ambiguous=True,
                      alternatives=[(6, "饕餮")])
        intent = NLIntent(raw="把饕餮的品质改为5", action="set",
                          locator_value="饕餮", locator_field="名称",
                          target_field="品质", value="5")
        agent._resolve_row_ambiguity(intent, rm, p, "Data")
        check("A 消歧 prompt 被调用", len(captured) >= 1)
        if captured:
            prompt = captured[0]
            check("A prompt 含整行列名=值", "品质=" in prompt or "品质:" in prompt,
                  f"prompt={prompt[:200]}")
            check("A prompt 含候选行号", "候选行5" in prompt and "候选行6" in prompt,
                  f"prompt={prompt[:200]}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ── B: 日期对齐相近行 ────────────────────────────────────
def test_b_get_column_number_format_majority():
    """get_column_number_format_majority 取众数。"""
    from agent.excel.style_utils import get_column_number_format_majority
    tmp = tempfile.mkdtemp()
    try:
        wb = Workbook()
        ws = wb.active
        ws.title = "Data"
        # 行 5/6/7 用 mm/dd/yyyy，行 8 用 yyyy-mm-dd
        for r in range(5, 8):
            ws.cell(r, 1).number_format = "mm/dd/yyyy"
        ws.cell(8, 1).number_format = "yyyy-mm-dd"
        # 众数应为 mm/dd/yyyy
        nf = get_column_number_format_majority(ws, 1, 9, 5, n=3)
        check("B 众数取多数格式", nf == "mm/dd/yyyy", f"nf={nf}")
        # 全空返回空串
        wb2 = Workbook()
        ws2 = wb2.active
        nf2 = get_column_number_format_majority(ws2, 1, 5, 5, n=3)
        check("B 全空返回空串", nf2 == "")
    finally:
        pass  # Workbook 不需清理


def test_b_write_cell_uses_majority():
    """write_cell 写 date 时用众数格式覆盖 number_format 参数。"""
    from agent.excel.cli_interface import StubCodeMakerCLI
    tmp = tempfile.mkdtemp()
    try:
        ws_dir = Path(tmp)
        wb = Workbook()
        s = wb.active
        s.title = "Data"
        s.cell(1, 1, "活动开始时间")
        # 行 5/6/7 已有日期，格式 mm/dd/yyyy
        for r in range(5, 8):
            s.cell(r, 1, datetime(2024, 1, 1))
            s.cell(r, 1).number_format = "mm/dd/yyyy"
        p = ws_dir / "dt.xlsx"
        wb.save(p)

        cli = StubCodeMakerCLI(workspace=ws_dir, header_row=1, data_start_row=5)
        # 写入新日期，传 yaml 固定 format，但应被众数 mm/dd/yyyy 覆盖
        r = cli.write_cell(p, "Data", 8, 1, datetime(2024, 6, 15),
                           number_format="yyyy-mm-dd hh:mm:ss")
        check("B write_cell date ok", r.ok, r.error or "")
        wb2 = cli._load(p)
        c = wb2["Data"].cell(8, 1)
        check("B write_cell 用众数格式", c.number_format == "mm/dd/yyyy",
              f"format={c.number_format}")
        check("B write_cell 值正确", c.value == datetime(2024, 6, 15))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ── C: 搜索索引命中 ────────────────────────────────────────
def test_c_search_via_index():
    """_search_via_index 用倒排索引命中（需 _table_index.json 存在）。"""
    from agent.excel.cli_interface import StubCodeMakerCLI
    idx_path = Path(__file__).parent.parent / "agent" / "excel" / "_table_index.json"
    if not idx_path.exists():
        check("C _table_index.json 存在", False, str(idx_path))
        return
    # 用真实 resources 表测（ability 表有 神通id=1001 在索引）
    res_dir = Path(__file__).parent.parent.parent / "resources"
    cli = StubCodeMakerCLI(workspace=res_dir)
    p = res_dir / "ability.xlsx"
    if not p.exists():
        check("C ability.xlsx 存在", False, str(p))
        return
    # 搜索引里的值（如 1001）
    hits = cli._search_via_index(p, "1001")
    check("C 索引命中返回结果", len(hits) > 0, f"hits={len(hits)}")
    if hits:
        h = hits[0]
        check("C 命中行号 > 0", h.row > 0)
        check("C 命中 sheet 非空", bool(h.sheet))
        check("C 命中 cell_value 含关键词", "1001" in str(h.cell_value))


def test_c_search_single_uses_index():
    """_search_single 在无 sheet/col 限制时优先查索引。"""
    from agent.excel.cli_interface import StubCodeMakerCLI
    res_dir = Path(__file__).parent.parent.parent / "resources"
    cli = StubCodeMakerCLI(workspace=res_dir)
    p = res_dir / "ability.xlsx"
    if not p.exists():
        check("C ability.xlsx 存在", False)
        return
    # 搜索引里存在的值
    hits = cli._search_single(p, "1001")
    check("C _search_single 索引优先命中", len(hits) > 0)


def test_c_locate_row_via_index():
    """locate_row_via_index 用倒排索引为处理模式定位行。"""
    from agent.excel.cli_interface import StubCodeMakerCLI
    res_dir = Path(__file__).parent.parent.parent / "resources"
    cli = StubCodeMakerCLI(workspace=res_dir)
    p = res_dir / "ability.xlsx"
    if not p.exists():
        check("C ability.xlsx 存在", False, str(p))
        return
    # ability 表 Ability sheet，神通id 是列1，索引有 1001→行5
    hit = cli.locate_row_via_index(p, "Ability", 1, "1001", "exact")
    check("C locate_row_via_index exact 命中", hit is not None,
          f"hit={hit}")
    if hit:
        row_nums, col_name, matched = hit
        check("C exact 行号=5", row_nums == [5], f"rows={row_nums}")
        check("C exact col_name=神通id", col_name == "神通id", f"col_name={col_name}")
        check("C exact matched=1001", matched == "1001", f"matched={matched}")
    # startswith：1001 命中所有以 1001 开头的（1001/10010/10011...）
    hit_sw = cli.locate_row_via_index(p, "Ability", 1, "1001", "startswith")
    check("C locate_row_via_index startswith 命中", hit_sw is not None)
    if hit_sw:
        check("C startswith 含行5", 5 in hit_sw[0], f"rows={hit_sw[0]}")
    # contains：1001 子串命中
    hit_ct = cli.locate_row_via_index(p, "Ability", 1, "1001", "contains")
    check("C locate_row_via_index contains 命中", hit_ct is not None)
    # 不存在的值 → None（回退全表遍历）
    miss = cli.locate_row_via_index(p, "Ability", 1, "不存在的值99999", "exact")
    check("C 无命中返回 None", miss is None, f"miss={miss}")
    # 非索引列（如 神通描述 列3）→ None
    non_idx = cli.locate_row_via_index(p, "Ability", 3, "1001", "contains")
    check("C 非索引列返回 None", non_idx is None, f"non_idx={non_idx}")


def test_c_locate_row_agent_uses_index():
    """agent._locate_row 优先走索引快路径。"""
    from agent.excel.cli_interface import StubCodeMakerCLI
    from agent.excel.agent import TableAgent, RowMatch
    res_dir = Path(__file__).parent.parent.parent / "resources"
    cli = StubCodeMakerCLI(workspace=res_dir)
    p = res_dir / "ability.xlsx"
    if not p.exists():
        check("C ability.xlsx 存在", False)
        return
    agent = TableAgent(cli=cli, parser=None, live_index=False)
    rm = agent._locate_row(p, "Ability", 1, "1001", "exact")
    check("C _locate_row 索引快路径命中", rm is not None, f"rm={rm}")
    if rm:
        check("C 索引命中行=5", rm.row == 5, f"row={rm.row}")
        check("C 索引 method=index_exact", rm.method == "index_exact",
              f"method={rm.method}")
        check("C 索引命中 conf>=0.9", rm.confidence >= 0.9,
              f"conf={rm.confidence}")
        check("C 索引命中非歧义", not rm.ambiguous)
        check("C 索引命中 value=1001", rm.value == "1001",
              f"value={rm.value}")


# ── D: 前端跳转 ──────────────────────────────────────────
def test_d_tablesview_has_goto_result():
    """TablesView.vue 含 gotoResult 函数。"""
    p = Path(__file__).parent.parent.parent / "frontend" / "src" / "views" / "TablesView.vue"
    if not p.exists():
        check("D TablesView.vue 存在", False, str(p))
        return
    content = p.read_text(encoding="utf-8")
    check("D 含 gotoResult 函数", "function gotoResult" in content or "gotoResult(" in content)
    check("D 含 highlightedRow 状态", "highlightedRow" in content)
    check("D 搜索卡片含 @click", "@click=\"gotoResult" in content or "@click='gotoResult" in content)
    check("D tr 含 :id row-", ":id=\"`row-${ri}`\"" in content or "id='row-${ri}'" in content)
    check("D 含 row-highlight class", "row-highlight" in content)
    check("D 含 scrollIntoView", "scrollIntoView" in content)


def main():
    print("=" * 60)
    print("A/B/C/D 需求验证测试套件")
    print("=" * 60)
    print()
    print("── A AI 看行信息 ──")
    test_a_resolve_row_ambiguity_signature()
    test_a_resolve_row_ambiguity_injects_row_data()
    print()
    print("── B 日期对齐相近行 ──")
    test_b_get_column_number_format_majority()
    test_b_write_cell_uses_majority()
    print()
    print("── C 搜索索引命中 ──")
    test_c_search_via_index()
    test_c_search_single_uses_index()
    test_c_locate_row_via_index()
    test_c_locate_row_agent_uses_index()
    print()
    print("── D 前端跳转 ──")
    test_d_tablesview_has_goto_result()
    print()

    passed = sum(1 for _, ok, _ in results if ok)
    total = len(results)
    print("=" * 60)
    print(f"结果: {passed}/{total} PASS ({passed * 100 // total}%)")
    print("=" * 60)
    failed = [(n, d) for n, ok, d in results if not ok]
    if failed:
        print("失败项：")
        for n, d in failed:
            print(f"  - {n}: {d}")
    return 0 if not failed else 1


if __name__ == "__main__":
    sys.exit(main())
