#!/usr/bin/env python3
"""索引构建器：扫描 resources/ 下所有 .xlsx，生成带关键词推断的索引。

用法:
  python tools/index_builder.py                     # 生成 _table_index.json
  python tools/index_builder.py --print             # 打印索引预览
  python tools/index_builder.py --verify            # 验证索引与 resources 一致性
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path
from typing import Optional

WORKSPACE = Path(__file__).resolve().parent.parent.parent.parent
INDEX_PATH = Path(__file__).resolve().parent / "_table_index.json"
HINTS_PATH = Path(__file__).resolve().parent / "skills" / "index_builder_hints.yaml"
TABLE_CONTEXT_PATH = Path(__file__).resolve().parent / "skills" / "table_context.yaml"

# ---------- Excel 扫描 ----------

def _clean_header(h) -> str:
    if h is None:
        return ""
    s = str(h)
    s = s.replace("\n", "").replace("\r", "")
    s = re.sub(r"[（(].*?[）)]", "", s)
    s = s.split(":")[0]
    return s.strip()


def _detect_rows(ws) -> tuple[int, int]:
    """推断表头行与数据起始行。

    约定:
      - 第1行表头、第2行类型、第3-4行空/示例、第5行起数据。
      - 兼容无类型行的表：表头后紧接数据（data_start=2）。
      - 兼容说明/标题类 sheet：第1行空，真正表头在后续行（向下扫30行
        找首个≥2非空单元格行作表头，data_start=表头+1）。
    """
    upper = min(30, ws.max_row)
    top = list(ws.iter_rows(min_row=1, max_row=upper, values_only=True))
    header_row = 1
    for idx, cells in enumerate(top, start=1):
        if sum(1 for v in (cells or []) if v is not None) >= 2:
            header_row = idx
            break
    if header_row == 1:
        type_row_cells = list(top[1]) if len(top) > 1 else []
        is_type_row = any(
            isinstance(v, str) and (":" in v or re.fullmatch(r"[a-z_][a-z0-9_]*", v))
            for v in type_row_cells if v
        )
        data_start = 5 if is_type_row else 2
    else:
        data_start = header_row + 1
    return header_row, data_start


def _find_id_columns(header_names: list[str]) -> dict[int, str]:
    """找出名称/id类高频定位列的索引（0-based）。"""
    result: dict[int, str] = {}
    id_keywords = ("名称", "名字", "id", "编号", "名")
    for i, hn in enumerate(header_names):
        hn_l = hn.lower()
        for kw in id_keywords:
            if kw in hn_l:
                if not any(bad in hn_l for bad in ("描述", "icon", "图标")):
                    result[i] = hn
                    break
    return result


def _scan_sheet(ws) -> Optional[dict]:
    if ws.title.lower() == "config":
        return None
    header_row, data_start = _detect_rows(ws)
    hr = list(ws.iter_rows(min_row=header_row, max_row=header_row, values_only=True))
    if not hr:
        return None
    raw_headers = list(hr[0])
    while raw_headers and raw_headers[-1] is None:
        raw_headers.pop()
    if not raw_headers or all(v is None for v in raw_headers):
        return None
    # 类型行（仅当 data_start > header_row+1 时存在）；空表头列回退用类型行前缀翻译
    # （与 table_index._scan_sheet 保持一致，避免手动跑本脚本时生成 col1 盲索引）
    type_row = header_row + 1 if data_start > header_row + 1 else None
    type_vals: list = []
    if type_row:
        tr = list(ws.iter_rows(min_row=type_row, max_row=type_row, values_only=True))
        type_vals = list(tr[0]) if tr else []
    from .column_name_resolver import resolve_header_cell
    headers: list[str] = []
    header_names: list[str] = []
    for i in range(len(raw_headers)):
        hv = raw_headers[i]
        tv = type_vals[i] if i < len(type_vals) else None
        resolved = resolve_header_cell(hv, tv)
        headers.append(str(resolved) if resolved is not None else "")
        header_names.append(_clean_header(headers[-1]))

    # 精确计数 + 行级倒排索引
    actual_rows = 0
    row_index: dict[str, dict[str, list[int]]] = {}
    id_cols = _find_id_columns(header_names)

    for r in range(data_start, ws.max_row + 1):
        row_vals = [ws.cell(r, c).value for c in range(1, len(headers) + 1)]
        if any(v is not None for v in row_vals):
            actual_rows += 1
            for col_idx, col_name in id_cols.items():
                v = row_vals[col_idx] if col_idx < len(row_vals) else None
                if v is not None:
                    key = str(v).strip()
                    if key:
                        row_index.setdefault(col_name, {}).setdefault(key, []).append(r)

    return {
        "name": ws.title,
        "headers": headers,
        "header_names": header_names,
        "header_row": header_row,
        "data_start_row": data_start,
        "row_count": actual_rows,
        "row_index": row_index,
    }


def scan_tables(workspace: Path) -> list[dict]:
    try:
        import openpyxl
    except ImportError as e:
        raise RuntimeError("需要 openpyxl") from e

    tables = []
    for p in sorted(workspace.rglob("*.xlsx")):
        if p.name.startswith("~$"):
            continue
        try:
            wb = openpyxl.load_workbook(p, read_only=False, data_only=True)
        except Exception:
            continue
        sheets = [s for s in (_scan_sheet(ws) for ws in wb.worksheets) if s]
        if not sheets:
            wb.close()
            continue
        for s in sheets:
            pass  # samples/row_index 保留在 dict 中，写入 JSON
        tables.append({
            "path": str(p.relative_to(workspace)).replace("\\", "/"),
            "stem": p.stem,
            "sheets": sheets,
        })
        wb.close()
    return tables


# ---------- 关键词推断 ----------

def _load_hints() -> tuple[dict[str, str], dict[str, str]]:
    """从 index_builder_hints.yaml 加载关键词推断提示。"""
    try:
        import yaml
    except ImportError:
        return {}, {}
    if not HINTS_PATH.exists():
        return {}, {}
    data = yaml.safe_load(HINTS_PATH.read_text(encoding="utf-8")) or {}
    return data.get("header_to_keywords", {}), data.get("stem_to_domain", {})


def _infer_keywords_from_headers(header_names: list[str], header_to_kw: dict[str, str]) -> set[str]:
    """从表头名中推断业务关键词。

    对每个表头，若命中 header_to_kw 的某个触发词，同时加入：
      - 业务域（domain，如"灵兽宠物"）用于跨表归类
      - 触发词本身（kw，如"宠物"）用于自然语言精确子串匹配
    这样"新增一个宠物名为朱雀"才能命中 pet 表（"宠物"成为可搜索关键词）。
    """
    keywords = set()
    for h in header_names:
        if not h:
            continue
        for kw, domain in header_to_kw.items():
            if kw in h or h in kw:
                keywords.add(domain)
                if len(kw) >= 2:
                    keywords.add(kw)
                break
    return keywords


def _infer_keywords_from_stem(stem: str, stem_to_domain: dict[str, str]) -> set[str]:
    """从文件名推断业务关键词。"""
    keywords = set()
    domain = stem_to_domain.get(stem, "")
    if domain:
        keywords.add(domain)
    for seg in stem.replace("_", " ").split():
        if seg and len(seg) >= 2:
            keywords.add(seg)
    return keywords


def _load_yaml_keywords() -> dict[str, dict[str, list[str]]]:
    """从 table_context.yaml 加载手工关键词。"""
    try:
        import yaml
    except ImportError:
        return {}
    p = TABLE_CONTEXT_PATH
    if not p.exists():
        return {}
    data = yaml.safe_load(p.read_text(encoding="utf-8")) or {}
    tables = data.get("tables", {})
    result: dict[str, dict[str, list[str]]] = {}
    for stem, sheets in tables.items():
        result[stem] = {}
        for sheet_name, cfg in sheets.items():
            result[stem][sheet_name] = cfg.get("keywords", [])
    return result


def build_index(workspace: Path | None = None):
    """生成 _table_index.json。

    旧版本脚本写出无 md5/samples 的结构，与 table_index.load_index 不兼容，
    手动运行会破坏运行时索引。现统一委托 table_index.build_index 生成兼容索引
    （含 md5/samples），消除不兼容覆盖风险。关键词推断保留在 table_resolver 的
    运行时回退中（从 stem + header_names 推断），无需写入索引。
    """
    from . import table_index
    ws = Path(workspace) if workspace else (WORKSPACE / "resources")
    return table_index.build_index(ws)


# ---------- 验证 ----------

def verify_index():
    """验证索引与 resources/ 的一致性。"""
    if not INDEX_PATH.exists():
        print("索引文件不存在，请先运行 index_builder.py")
        return False
    data = json.loads(INDEX_PATH.read_text(encoding="utf-8"))
    indexed = {t["path"]: t["stem"] for t in data}

    actual = set()
    for p in (WORKSPACE / "resources").rglob("*.xlsx"):
        if not p.name.startswith("~$"):
            actual.add(str(p.relative_to(WORKSPACE / "resources")).replace("\\", "/"))

    ok = True
    for path in sorted(indexed.keys() - actual):
        print(f"  [过时] 索引中有但磁盘不存在: {path}")
        ok = False
    for path in sorted(actual - indexed.keys()):
        print(f"  [遗漏] 磁盘有但索引无: {path}")
        ok = False
    if ok:
        print(f"  索引一致: {len(indexed)} 个表")
    return ok


def print_index():
    """打印索引预览。"""
    if not INDEX_PATH.exists():
        print("索引文件不存在，请先运行 index_builder.py")
        return
    data = json.loads(INDEX_PATH.read_text(encoding="utf-8"))
    for t in data:
        sheets = " | ".join(f"{s['name']}({s['row_count']}行)" for s in t["sheets"])
        print(f"  {t['path']:40s} {'[' + ', '.join(t.get('keywords', [])) + ']':40s}")
        for s in t["sheets"]:
            kw_str = ", ".join(s.get("keywords", [])[:8])
            print(f"    └─ {s['name']:30s} [{kw_str}]")
        print()


if __name__ == "__main__":
    if "--print" in sys.argv:
        print_index()
    elif "--verify" in sys.argv:
        ok = verify_index()
        sys.exit(0 if ok else 1)
    else:
        tables = build_index()
        print(f"索引完成：{len(tables)} 个表，{sum(len(t.sheets) for t in tables)} 个 sheet")
