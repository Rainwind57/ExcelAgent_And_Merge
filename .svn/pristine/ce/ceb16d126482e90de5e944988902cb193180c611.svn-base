"""6 步流程 AI 增强层：每个 Step 都接入 LLM 能力，规则路径作为 fallback。

设计原则：
  - 每个 AI 方法返回结构化结果 + ok 标志；LLM 失败时返回 None，调用方降级走原规则
  - 复用 CodemakerClient 的 HTTP 通道（codemaker serve），不引入新依赖
  - prompt 精简聚焦，避免超时；单次调用 timeout=60s
  - session 复用（同实例跨 Step 共享），避免每步新建会话的 HTTP 往返

6 个 Step 的 AI 增强：
  Step1 解析：已有 CodemakerNLParser._parse_via_llm，本层不重复
  Step2 分区：ai_resolve_table —— 多候选表歧义时 LLM 选 + 未命中时 LLM 推断
  Step3 计划：ai_plan_operation —— 意图→结构化字段映射 + 值转换建议
  Step4 校验：ai_validate_plan —— 语义校验（业务逻辑/命名/引用）+ 修正建议
  Step5 应用：ai_analyze_failure —— 写失败 LLM 分析根因 + 修正方案
  Step6 汇总：ai_summarize —— LLM 生成自然语言总结报告
"""

from __future__ import annotations

import logging
import os
import threading
from typing import Any, Optional

from ..codemaker_client import CodemakerClient

logger = logging.getLogger(__name__)


class StepAIEnhancer:
    """6 步流程统一 AI 增强层。

    由 TableAgent 持有，各 Step 调用对应方法。LLM 失败时返回 None，
    调用方降级走原规则路径（不阻塞流程）。

    线程安全：Step3/4 并行时多线程并发调用 _call_llm。每线程独立 session
    （threading.local），避免同 session 并发请求被 serve 端串行化或状态混乱。
    串行路径（单线程）仍复用单 session，无额外创建开销。
    """

    def __init__(self, client: CodemakerClient, model: str = "",
                 directory: str = "", thinking_sink=None):
        self.client = client
        self.model = model or getattr(getattr(client, "cfg", None), "default_model", "") or "codemaker"
        self.directory = directory
        self._session_id = ""
        self._thinking_sink = thinking_sink
        # 线程局部 session：并行时每线程独立，串行时主线程复用 _session_id
        self._tls = threading.local()
        # 批次级熔断：连续失败达阈值后跳过剩余 LLM 调用，避免连环超时拖垮整批
        # 脚本环境 LLM 不可达时，N 次超时后快速降级走规则路径，省墙钟
        self._fail_count = 0
        self._fail_lock = threading.Lock()
        self._circuit_threshold = max(1, int(os.getenv("CODEMAKER_AI_CIRCUIT_THRESHOLD", "3") or "3"))

    def _think(self, phase: str, detail: str = "") -> None:
        if self._thinking_sink:
            try:
                self._thinking_sink(phase, detail)
            except Exception:
                pass

    def _ensure_session(self) -> str:
        """复用 codemaker session，避免每步新建。

        线程安全：主线程（串行路径）复用 self._session_id；工作线程（并行路径）
        用 threading.local 持有独立 session，避免同 session 并发请求冲突。
        """
        # 主线程：复用已有 session
        if threading.current_thread() is threading.main_thread():
            if self._session_id:
                return self._session_id
            sess = self.client.create_session(directory=self.directory, model=self.model)
            if not sess.ok:
                logger.warning("StepAIEnhancer 创建会话失败：%s", sess.error)
                return ""
            self._session_id = sess.session_id
            return self._session_id
        # 工作线程：线程局部 session
        sid = getattr(self._tls, "session_id", "")
        if sid:
            return sid
        sess = self.client.create_session(directory=self.directory, model=self.model)
        if not sess.ok:
            logger.warning("StepAIEnhancer 工作线程创建会话失败：%s", sess.error)
            return ""
        self._tls.session_id = sess.session_id
        return self._tls.session_id

    def _call_llm(self, prompt: str, timeout: int = 60) -> Optional[str]:
        """统一 LLM 调用入口。失败返回 None。

        超时可由环境变量 CODEMAKER_AI_TIMEOUT_SCALE 统一放大（默认 1.0）。
        脚本/弱网环境 LLM 响应慢时调大（如 2.0=翻倍），前端正常时保持默认。
        各方法的 base timeout 见调用处（30/45/60s），scale 作用于 base。

        熔断：连续失败达 CODEMAKER_AI_CIRCUIT_THRESHOLD（默认 3）后，本实例
        后续 LLM 调用直接返回 None，避免连环超时拖垮整批。脚本环境 LLM 不可达
        时快速降级走规则路径。新批次由 reset_circuit() 重置。
        """
        # 熔断检查：连续失败达阈值 → 跳过
        if self._fail_count >= self._circuit_threshold:
            return None
        sid = self._ensure_session()
        if not sid:
            return None
        try:
            scale = float(os.getenv("CODEMAKER_AI_TIMEOUT_SCALE", "1.0") or "1.0")
        except (ValueError, TypeError):
            scale = 1.0
        if scale > 0 and scale != 1.0:
            timeout = max(1, int(timeout * scale))
        try:
            resp = self.client.prompt(sid, prompt, timeout=timeout, model=self.model)
            if not resp.ok:
                logger.warning("StepAIEnhancer LLM 调用失败：%s", resp.error)
                with self._fail_lock:
                    self._fail_count += 1
                return None
            # 成功 → 重置失败计数
            with self._fail_lock:
                self._fail_count = 0
            return resp.response_text
        except Exception:
            logger.warning("StepAIEnhancer LLM 异常", exc_info=True)
            with self._fail_lock:
                self._fail_count += 1
            return None

    def reset_circuit(self) -> None:
        """重置熔断计数（新批次/新指令开始时调用）。"""
        with self._fail_lock:
            self._fail_count = 0

    # ── Step2 分区：表歧义 LLM 裁决 + 未命中 LLM 推断 ──────────────

    def ai_resolve_table(self, text: str, candidates: list[str],
                         all_tables: list[str] = None) -> Optional[str]:
        """表名歧义/未命中时，LLM 选择最合适的目标表。

        Args:
            text: 用户原始指令
            candidates: 规则匹配出的候选表 stem 列表（歧义时多个，未命中时空）
            all_tables: 全部可用表 stem（未命中时供 LLM 推断）

        Returns:
            选定的表 stem；LLM 失败返回 None（调用方降级走规则）
        """
        if not candidates and not all_tables:
            return None

        if candidates:
            scenario = "多候选歧义"
            cand_desc = "、".join(candidates)
            table_pool = cand_desc
        else:
            scenario = "规则未命中"
            cand_desc = "无"
            table_pool = "、".join(all_tables[:40]) if all_tables else ""

        prompt = f"""你是配表路由专家。根据用户指令，从候选表中选择最合适的目标表。

## 用户指令
{text}

## 场景
{scenario}：规则匹配出候选 = {cand_desc}

## 候选表池
{table_pool}

## 任务
选择一个最符合指令语义的表 stem（英文文件名，无扩展名）。
- NPC/怪物/宠物 → entity_prefab
- 建筑物 → building
- 道具/装备 → item
- 神通/技能 → ability
- 法宝 → fabao
- 邮件 → mail
- 帮派 → guild
- 交互/对话 → interaction
- 奖励 → reward
- 生成点 → spawn_world_entity
- 场景 → space
- 任务 → quest

只输出表 stem（如 entity_prefab），无其他文字。"""
        self._think("分区", f"AI 表路由裁决（{scenario}，{len(candidates)} 候选）")
        raw = self._call_llm(prompt, timeout=30)
        if not raw:
            return None
        stem = raw.strip().splitlines()[0].strip()
        # 校验 LLM 输出在候选池内（避免幻觉）
        pool = candidates if candidates else (all_tables or [])
        if pool and stem not in pool:
            # 宽松匹配：LLM 可能输出近义词，取包含关系
            for p in pool:
                if stem in p or p in stem:
                    return p
            return None
        return stem

    # ── Step3 计划：意图→结构化字段映射 + 值转换 ──────────────────

    def ai_plan_operation(self, intent_desc: str, table_stem: str,
                          sheet: str, columns: list[str],
                          intent_fields: dict = None) -> Optional[dict]:
        """LLM 把意图转为结构化操作计划（字段映射 + 值转换建议）。

        Args:
            intent_desc: 意图描述（如"新增NPC福神，model_id 1020"）
            table_stem: 目标表 stem
            sheet: 目标 sheet
            columns: 该表实际列名列表
            intent_fields: 解析阶段已提取的字段（供 LLM 参考修正）

        Returns:
            {"fields": {列名: 值}, "notes": str}；LLM 失败返回 None
        """
        cols_desc = "、".join(columns[:30]) if columns else "未知"
        fields_desc = str(intent_fields) if intent_fields else "无"

        prompt = f"""你是配表操作计划生成器。把用户意图转为结构化字段映射计划。

## 目标表
{table_stem} / {sheet}

## 该表实际列名
{cols_desc}

## 用户意图
{intent_desc}

## 解析阶段已提取字段（供参考，可能不完整或列名不准）
{fields_desc}

## 任务
1. 把意图中的值映射到正确的列名（用上方实际列名，不要自造）
2. 缺失的必填列标注为 "<auto>"（如主键/编号）
3. 枚举值保留中文原文
4. **交互效果编号列**（如名为"交互效果编号"）：根据意图语义选填效果码。
   读表头里的效果数据列名推断编码——列名形如"3001: 战斗ID"/"3002: reward ID"/"3003: 目标space ID"/"3006: 对话ID"等，
   冒号前的数字即效果码。意图含"战斗"→填 3001，"奖励/获得"→填 3002，"传送"→填 3003，"对话"→填 3006。
   效果码对应的数据列（如"3002: reward ID"）填意图里的具体值（如 reward_id）。
   无明确对应的效果码时填 "<auto>" 待补。
5. **主键列（通常第1列，名为"编号"或"id"）**：用户未指定时填 "<auto>" 走自增，绝不把效果码或其他值塞进主键列
6. 输出 JSON：{{"fields": {{"列名": "值"}}, "notes": "计划说明"}}
只输出 JSON，无其他文字。"""
        self._think("计划", f"AI 操作计划生成（{table_stem}/{sheet}，{len(columns)} 列）")
        raw = self._call_llm(prompt, timeout=45)
        if not raw:
            return None
        data = self.client.extract_json_from_response(raw)
        if isinstance(data, dict) and "fields" in data:
            # 校验 LLM 输出的列名在实际列内
            valid_cols = set(columns) if columns else set()
            if valid_cols:
                cleaned = {}
                for k, v in data["fields"].items():
                    # 宽松匹配：LLM 可能输出近义列名
                    if k in valid_cols:
                        cleaned[k] = v
                    else:
                        for vc in valid_cols:
                            if k in vc or vc in k:
                                cleaned[vc] = v
                                break
                data["fields"] = cleaned
            return data
        return None

    # ── Step4 校验：语义校验 + 修正建议 ───────────────────────────

    def ai_validate_plan(self, table_stem: str, sheet: str,
                         columns: list[str], plan_fields: dict,
                         action: str = "add") -> Optional[dict]:
        """LLM 语义校验：业务逻辑/命名规范/引用合理性 + 修正建议。

        规则校验（类型/required/unique）由 PipelineVerifier 负责，
        本方法做规则覆盖不到的语义层校验。

        Args:
            table_stem: 目标表
            sheet: 目标 sheet
            columns: 实际列名
            plan_fields: 计划写入的字段 {列名: 值}
            action: 操作类型 add/set/delete/get

        Returns:
            {"ok": bool, "issues": [str], "suggestions": [str]}；LLM 失败返回 None
        """
        cols_desc = "、".join(columns[:25]) if columns else "未知"
        fields_desc = "\n".join(f"  {k}: {v}" for k, v in (plan_fields or {}).items())

        prompt = f"""你是配表语义校验专家。检查操作计划的业务合理性。

## 目标表
{table_stem} / {sheet}（操作：{action}）

## 实际列名
{cols_desc}

## 计划写入字段
{fields_desc or "（空）"}

## 校验维度（规则校验已覆盖类型/必填/唯一，你专注语义层）
1. 命名规范：名字是否符合游戏命名习惯（如NPC名不应含特殊符号）
2. 业务逻辑：值是否合理（如等级应在 1-100，ID 不应重复）
3. 引用合理性：引用的 ID 是否可能存在（如 reward_id 应在 reward 表存在）
4. 完整性：add 操作是否漏了关键列（如 NPC 缺名字/交互id）

## 输出
JSON：{{"ok": true/false, "issues": ["问题1", ...], "suggestions": ["建议1", ...]}}
ok=true 表示语义校验通过；ok=false 表示有问题但可修正。
只输出 JSON，无其他文字。"""
        self._think("校验", f"AI 语义校验（{table_stem}/{sheet}，{action}）")
        raw = self._call_llm(prompt, timeout=45)
        if not raw:
            return None
        data = self.client.extract_json_from_response(raw)
        if isinstance(data, dict) and "ok" in data:
            return data
        return None

    # ── Step5 应用：写失败 LLM 分析根因 + 修正方案 ────────────────

    def ai_fix_field_mapping(self, error_msg: str, table_stem: str, sheet: str,
                             columns: list[str], wrong_col: str,
                             wrong_value, all_fields: dict) -> Optional[dict]:
        """类型校验失败时，LLM 判断是"列映射错误"还是"值需转换"。

        场景：add 时把"要不要"塞进 int 列"新对话ID"——这是列映射错了，
        "要不要"实际是选项文本应放"选项内容"列。LLM 推断正确列名+正确值。

        Args:
            error_msg: coerce 失败错误信息
            table_stem: 目标表
            sheet: 目标 sheet
            columns: 实际列名
            wrong_col: 被塞错值的列名
            wrong_value: 被塞错的值
            all_fields: 当前所有 fields（供 LLM 看整体映射上下文）

        Returns:
            {"correct_col": str, "correct_value": str, "reason": str}；LLM 失败返回 None
        """
        cols_desc = "、".join(columns[:30]) if columns else "未知"
        fields_desc = str(all_fields)

        prompt = f"""你是配表字段映射诊断专家。某字段类型校验失败，判断是列映射错误还是值需转换。

## 失败信息
错误：{error_msg}
目标表：{table_stem} / {sheet}
被塞错的列：{wrong_col}（该列类型不匹配）
被塞错的值：{wrong_value!r}

## 该表实际列名
{cols_desc}

## 当前所有 fields（整体映射上下文）
{fields_desc}

## 判断维度
1. **列映射错误**：值本身合理，但放错了列（如对话文本塞进 ID 列）。给出正确列名。
2. **值需转换**：列对，但值格式不对（如"3"应转 int 3）。给出转换后的值。
3. **都不对**：值语义不明，建议跳过并向用户确认。

## 输出
JSON：{{"correct_col": "正确列名或原列名", "correct_value": "正确值或转换后值", "reason": "判断理由"}}
- 列映射错误时 correct_col 填正确列名（必须在实际列名中），correct_value 填原值
- 值需转换时 correct_col 填原列名，correct_value 填转换后值
- 都不对时 correct_col 填空字符串，reason 说明需用户确认
只输出 JSON，无其他文字。"""
        self._think("校验", f"AI 字段映射诊断（{table_stem}/{sheet}，错列={wrong_col}）")
        raw = self._call_llm(prompt, timeout=30)
        if not raw:
            return None
        data = self.client.extract_json_from_response(raw)
        if isinstance(data, dict) and "correct_col" in data:
            return data
        return None

    def ai_analyze_failure(self, error_msg: str, table_stem: str,
                           sheet: str, columns: list[str],
                           attempted_fields: dict,
                           action: str = "add") -> Optional[dict]:
        """写库失败时 LLM 分析根因 + 修正方案。

        比现有 error_feedback 更智能：不只收集上下文，还主动推理根因+给修正值。

        Args:
            error_msg: 失败错误信息
            table_stem: 目标表
            sheet: 目标 sheet
            columns: 实际列名
            attempted_fields: 失败时尝试写入的字段
            action: 操作类型

        Returns:
            {"root_cause": str, "fix_fields": {列名: 值}, "strategy": str}；LLM 失败返回 None
        """
        cols_desc = "、".join(columns[:25]) if columns else "未知"
        fields_desc = str(attempted_fields)

        prompt = f"""你是配表写库故障诊断专家。分析失败根因并给出修正方案。

## 失败信息
错误：{error_msg}
目标表：{table_stem} / {sheet}（操作：{action}）

## 实际列名
{cols_desc}

## 失败时尝试写入的字段
{fields_desc}

## 任务
1. 推理根因（类型不符？列名错误？值非法？缺少必填？）
2. 给出修正后的完整 fields（用实际列名，修正值）
3. 说明修正策略

输出 JSON：{{"root_cause": "根因", "fix_fields": {{"列名": "值"}}, "strategy": "修正策略"}}
只输出 JSON，无其他文字。"""
        self._think("执行", f"AI 故障诊断（{table_stem}/{sheet}，{action}）")
        raw = self._call_llm(prompt, timeout=45)
        if not raw:
            return None
        data = self.client.extract_json_from_response(raw)
        if isinstance(data, dict) and "root_cause" in data:
            return data
        return None

    # ── Step6 汇总：LLM 生成自然语言总结 ──────────────────────────

    def ai_summarize(self, results: list[dict],
                     user_text: str = "") -> Optional[str]:
        """LLM 生成自然语言总结报告。

        Args:
            results: 各子任务结果列表，每项 {"table", "sheet", "action", "ok", "detail", "row"}
            user_text: 原始用户指令（供 LLM 对照）

        Returns:
            自然语言总结字符串；LLM 失败返回 None
        """
        if not results:
            return None
        lines = []
        for i, r in enumerate(results, 1):
            status = "✅" if r.get("ok") else "❌"
            tbl = r.get("table", "?")
            act = r.get("action", "?")
            detail = r.get("detail", "")
            row = r.get("row", "")
            row_str = f" 行{row}" if row else ""
            lines.append(f"{i}. {status} {act} {tbl}{row_str}：{detail}")
        results_desc = "\n".join(lines)

        prompt = f"""你是配表操作总结助手。把执行结果汇总为简洁的自然语言报告。

## 用户原始指令
{user_text or "（未提供）"}

## 执行结果
{results_desc}

## 任务
生成简洁的中文总结报告：
1. 概述整体成功/失败
2. 逐条列出关键结果（成功写了什么/失败原因）
3. 如有失败，给出后续建议
4. 控制在 200 字内，用 markdown 列表格式

直接输出报告，无前言。"""
        self._think("汇总", f"AI 总结生成（{len(results)} 条结果）")
        raw = self._call_llm(prompt, timeout=30)
        if not raw:
            return None
        return raw.strip()

    # ── Step1 解析：规则拆分结果 AI 校验 + 补充 ──────────────────────

    def ai_verify_intents(self, user_text: str,
                          rule_intents: list[dict]) -> Optional[dict]:
        """规则拆分后的 AI 校验：检查拆分是否合理、是否漏意图、字段映射明显错误。

        规则为主，AI 提供补充占比：AI 发现漏意图/明显错列时返回修正建议，
        调用方合并；AI 失败或认为无问题时返回 ok=True 不改。

        开关：CODEMAKER_AI_ASSIST=0 时跳过（脚本环境 LLM 超时时关闭，避免加剧墙钟）。

        Args:
            user_text: 用户原始指令
            rule_intents: 规则拆分出的意图摘要列表，每项
                {action, table_hint, locator_value, fields_keys: [列名]}

        Returns:
            {"ok": bool, "missing": [意图描述], "corrections": [{idx, field, reason}]}
            LLM 失败返回 None（调用方保持规则结果不变）
        """
        if os.getenv("CODEMAKER_AI_ASSIST", "1") == "0":
            return None
        if not rule_intents:
            return None
        ints_desc = "\n".join(
            f"  {i}. action={it.get('action','?')} table={it.get('table_hint','?')} "
            f"locator={it.get('locator_value','无')} fields={it.get('fields_keys','无')}"
            for i, it in enumerate(rule_intents)
        )

        prompt = f"""你是配表意图解析校验器。规则拆分器已把用户指令拆成多条意图，请校验合理性。

## 用户原始指令
{user_text}

## 规则拆分结果（{len(rule_intents)} 条）
{ints_desc}

## 校验维度
1. 完整性：用户指令中的每个操作是否都被拆出？有无遗漏（如"同时修改名称"被规则漏掉）
2. 字段合理性：fields 里的列名是否与 action/table 语义匹配？有无明显错列（如把交互文本塞进 id 列）
3. 表路由：table_hint 是否符合指令语义

## 输出
JSON：{{"ok": true/false, "missing": ["遗漏的意图描述"], "corrections": [{{"idx": 0, "field": "列名", "reason": "应改为X列"}}]}}
- ok=true 表示规则拆分合理无需修正
- ok=false 时给出具体 missing/corrections
- 不确定时返回 ok=true（规则优先，避免 AI 过度干预）
只输出 JSON，无其他文字。"""
        self._think("解析", f"AI 意图校验（{len(rule_intents)} 条规则拆分）")
        raw = self._call_llm(prompt, timeout=30)
        if not raw:
            return None
        data = self.client.extract_json_from_response(raw)
        if isinstance(data, dict) and "ok" in data:
            return data
        return None

    # ── Step2 分区：规则命中后 AI 二次确认 ──────────────────────────

    def ai_confirm_table(self, user_text: str, rule_stem: str,
                         all_tables: list[str] = None) -> Optional[str]:
        """规则命中目标表后的 AI 二次确认：规则为主，AI 提供占比。

        规则已命中 stem 时仍跑一次轻量 AI 确认，避免纯规则错误
        （如关键词歧义把"灵兽"误路由到 guild 而非 pet）。
        AI 确认与规则一致 → 返回 rule_stem；不一致 → 返回 AI 纠正的 stem；
        AI 失败 → 返回 None（调用方保持规则结果）。

        Args:
            user_text: 用户原始指令（或该子意图片段）
            rule_stem: 规则命中的表 stem
            all_tables: 全部可用表（供 AI 在纠正时选择）

        Returns:
            确认/纠正的 stem；LLM 失败返回 None
        """
        if os.getenv("CODEMAKER_AI_ASSIST", "1") == "0":
            return None
        if not rule_stem:
            return None
        pool_desc = "、".join((all_tables or [])[:40]) if all_tables else "（未提供全表）"

        prompt = f"""你是配表路由确认器。规则已把指令路由到某表，请二次确认是否正确。

## 用户指令
{user_text}

## 规则路由结果
{rule_stem}

## 可用表池
{pool_desc}

## 任务
判断 {rule_stem} 是否为该指令的正确目标表。
- 正确 → 输出原 stem：{rule_stem}
- 错误 → 输出正确表 stem（必须在可用表池内）
- 不确定 → 输出原 stem（规则优先）

只输出表 stem（英文文件名），无其他文字。"""
        self._think("分区", f"AI 表路由二次确认（规则={rule_stem}）")
        raw = self._call_llm(prompt, timeout=20)
        if not raw:
            return None
        stem = raw.strip().splitlines()[0].strip()
        # 校验：AI 输出须在表池内或在规则 stem 上下文合理
        if all_tables and stem not in all_tables:
            for p in all_tables:
                if stem in p or p in stem:
                    return p
            # 不在池内 → 视为幻觉，返回规则结果
            return rule_stem
        return stem
