"""三阶段合并手动验证脚本（add-cross-producer-consolidation 回归）。

端到端验证形态隔离（单生产者：devbranch1，stage2 单生产者退化为直接拷贝）：
  1. 阶段1 比对 → conflict_origin=inter_commit
  2. 阶段门禁 → 未 consolidate 直接调阶段3 被拒（跳 stage2）
  3. 阶段1 阻断 → 存在未决冲突 cell → consolidate 返回 400
  4. 阶段1 产出 → 无冲突 → 产出中间版本 + 写 manifest
  5. 阶段2 综合 → conflict_origin=cross_producer，单生产者退化拷贝产 consolidated
  6. 阶段3 比对 → conflict_origin=merge_back
  7. 阶段3 合回 → 版本化产出 {group}_{N+1}.xlsx 到 trunk

用法:
    python -X utf8 -m server.tests.verify_two_stage_merge
"""
from __future__ import annotations

import asyncio
import copy
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fastapi import HTTPException

from engine.models import MergeRequest, SheetMergeData
from routers import merge_stages as ms
from routers.merge_stages import (
    Stage1CompareRequest, Stage2CrossCompareRequest, Stage3CompareRequest,
    stage1_compare, stage1_consolidate, stage2_compare, stage2_consolidate,
    stage3_compare, stage3_apply,
    DEVBRANCH_DIR, TRUNK_DIR, STAGE1_MANIFEST, STAGE2_MANIFEST,
    _intermediate_name, _consolidated_name,
)

BRANCH = "devbranch1"
GROUP = "item"

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    print(f"  [{'PASS' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _group_to_sheets(group, resolve: bool, break_one: bool = False):
    """把比对分组转成 MergeRequest.sheets。resolve=清所有 conflict 标记（模拟用户解决）。
    break_one=保留/强制一个 conflict cell（验证阻断）。"""
    sheets = []
    broke = False
    for s in group.sheets.values():
        rows = copy.deepcopy(s.rows)
        for row in rows:
            for cell in row.cells:
                if getattr(cell, "conflict", False):
                    if break_one and not broke:
                        broke = True  # 保留这一个未决
                        continue
                    if resolve:
                        cell.conflict = False
        sheets.append(SheetMergeData(name=s.name, headers=s.headers, rows=rows))
    # 无自然冲突时，强制在首个可用 cell 造一个未决冲突以验证阻断
    if break_one and not broke:
        for s in sheets:
            if s.rows and s.rows[0].cells:
                s.rows[0].cells[0].conflict = True
                broke = True
                break
    return sheets, broke


async def _run():
    # ── 1. 阶段1 比对 ──
    print("\n--- 1. 阶段1 比对（合并多次提交）---")
    resp1 = await stage1_compare(Stage1CompareRequest(branch=BRANCH, group_name=GROUP))
    _check("返回 inter_commit 来源", resp1.conflict_origin == "inter_commit", resp1.conflict_origin)
    _check("分组含目标 group", GROUP in resp1.groups)
    group1 = resp1.groups[GROUP]
    _check("基准=最小版本号提交", group1.base_file == f"{GROUP}_1.xlsx", group1.base_file)

    inter_name = _intermediate_name(GROUP, BRANCH)
    cons_name = _consolidated_name(GROUP)

    # ── 2. 阶段门禁：未 consolidate 直接调阶段3 ──
    print("\n--- 2. 阶段门禁（未完成阶段2 → 拒绝阶段3）---")
    # 先确保干净状态：删除可能残留的 manifest 条目
    if STAGE1_MANIFEST.is_file():
        STAGE1_MANIFEST.unlink()
    if STAGE2_MANIFEST.is_file():
        STAGE2_MANIFEST.unlink()
    if (DEVBRANCH_DIR / inter_name).is_file():
        (DEVBRANCH_DIR / inter_name).unlink()
    if (DEVBRANCH_DIR / cons_name).is_file():
        (DEVBRANCH_DIR / cons_name).unlink()
    blocked = False
    try:
        await stage3_compare(Stage3CompareRequest(group_name=GROUP))
    except HTTPException as e:
        blocked = e.status_code == 400
    _check("跳过阶段2 → 阶段3 被拒", blocked)

    # ── 3. 阶段1 阻断：存在未决冲突 ──
    print("\n--- 3. 阶段1 阻断（未决冲突 → 禁止产出）---")
    sheets_broken, broke = _group_to_sheets(group1, resolve=True, break_one=True)
    if broke:
        blocked1 = False
        try:
            await stage1_consolidate(MergeRequest(
                branch=BRANCH, group_name=GROUP, sheets=sheets_broken,
            ))
        except HTTPException as e:
            blocked1 = e.status_code == 400
        _check("未决冲突 → consolidate 返回 400", blocked1)
    else:
        _check("样本无冲突 cell（跳过阻断验证）", True, "item_1 vs item_2 无 conflict")

    # ── 4. 阶段1 产出中间版本 ──
    print("\n--- 4. 阶段1 产出中间版本 ---")
    sheets_ok, _ = _group_to_sheets(group1, resolve=True)
    res = await stage1_consolidate(MergeRequest(
        branch=BRANCH, group_name=GROUP, sheets=sheets_ok,
    ))
    _check("consolidate 成功", res.get("ok") is True)
    _check("产出中间版本文件存在", (DEVBRANCH_DIR / inter_name).is_file(), inter_name)
    _check("manifest 记录 stage1_ok", ms._read_manifest().get(inter_name, {}).get("stage1_ok") is True)

    # ── 5. 阶段2 综合（跨生产者，单生产者退化拷贝）──
    print("\n--- 5. 阶段2 综合（跨生产者，单生产者退化）---")
    resp2 = await stage2_compare(Stage2CrossCompareRequest(group_name=GROUP))
    _check("返回 cross_producer 来源", resp2.conflict_origin == "cross_producer", resp2.conflict_origin)
    group2 = resp2.groups[GROUP]
    _check("阶段2 基准=merge-base(fork快照)", group2.base_file == f"{BRANCH}_{GROUP}.xlsx", group2.base_file)
    # 单生产者退化：consolidate 直接拷，请求 sheets 传空 list 即可
    res2 = await stage2_consolidate(MergeRequest(
        group_name=GROUP, branch="", sheets=[],
    ))
    _check("stage2 consolidate 成功", res2.get("ok") is True)
    _check("产出综合版本文件存在", (DEVBRANCH_DIR / cons_name).is_file(), cons_name)
    _check("stage2 manifest 记录 stage2_ok",
           ms._read_stage2_manifest().get(cons_name, {}).get("stage2_ok") is True)

    # ── 6. 阶段3 比对（合回 trunk）──
    print("\n--- 6. 阶段3 比对（合回 trunk）---")
    resp3 = await stage3_compare(Stage3CompareRequest(group_name=GROUP))
    _check("返回 merge_back 来源", resp3.conflict_origin == "merge_back", resp3.conflict_origin)
    group3 = resp3.groups[GROUP]
    _check("阶段3 基准=merge-base(fork快照)", group3.base_file == f"{BRANCH}_{GROUP}.xlsx", group3.base_file)

    # ── 7. 阶段3 合回 ──
    print("\n--- 7. 阶段3 合回产出 ---")
    sheets3, _ = _group_to_sheets(group3, resolve=True)
    res3 = await stage3_apply(MergeRequest(
        group_name=GROUP, branch="", sheets=sheets3,
    ))
    out_name = res3.get("output")
    out_path = TRUNK_DIR / out_name if out_name else None
    _check("apply 成功", res3.get("ok") is True)
    _check("版本化产出到 trunk", bool(out_path and out_path.is_file()), out_name or "")
    _check("合回后综合版本已消费（stage2 manifest 无记录）",
           cons_name not in ms._read_stage2_manifest(), f"archived={res3.get('archived')}")

    # ── 清理产物 ──
    if (DEVBRANCH_DIR / inter_name).is_file():
        (DEVBRANCH_DIR / inter_name).unlink()
    if (DEVBRANCH_DIR / cons_name).is_file():
        (DEVBRANCH_DIR / cons_name).unlink()
    if STAGE1_MANIFEST.is_file():
        STAGE1_MANIFEST.unlink()
    if STAGE2_MANIFEST.is_file():
        STAGE2_MANIFEST.unlink()
    if out_path and out_path.is_file():
        out_path.unlink()


def main():
    print("=" * 60)
    print("三阶段合并端到端验证（单生产者，add-cross-producer-consolidation）")
    print("=" * 60)
    asyncio.run(_run())
    print("\n" + "=" * 60)
    print(f"结果: {_passed} 通过, {_failed} 失败")
    print("=" * 60)
    sys.exit(1 if _failed else 0)


if __name__ == "__main__":
    main()
