"""公式引用位移器单元测试。

纯函数测试，不依赖具体 xlsx 文件——验证 Excel 删/插行列引用重写规则。
任何表格通用性的根基：规则正确即可泛化。
"""
from server.agent.formula_ref_shifter import (
    shift_formula, shift_workbook_formulas, ShiftReport,
)


def _f(f, axis, idx, amount, target, cur=None):
    return shift_formula(f, axis, idx, amount, target, current_sheet=cur)


# ============ 删行：单点 ============
def test_delete_row_point():
    t = "S"
    # 删第5行
    assert _f("=C5", "row", 5, -1, t, t) == ("=#REF!", True, False)
    assert _f("=C6", "row", 5, -1, t, t) == ("=C5", False, False)
    assert _f("=C4", "row", 5, -1, t, t) == ("=C4", False, False)
    # 绝对引用同样位移
    assert _f("=$A$6", "row", 5, -1, t, t) == ("=$A$5", False, False)
    assert _f("=$A$5", "row", 5, -1, t, t) == ("=#REF!", True, False)
    # 混合
    assert _f("=B$6", "row", 5, -1, t, t) == ("=B$5", False, False)
    print("  test_delete_row_point PASS")


# ============ 删行：范围收缩 ============
def test_delete_row_range():
    t = "S"
    # SUM(F3:F14) 删第5行 → F3:F13（下界收缩）
    assert _f("=SUM(F3:F14)", "row", 5, -1, t, t) == ("=SUM(F3:F13)", False, False)
    # 删第3行 → F3 被删收口到3，F14→13 → F3:F13
    assert _f("=SUM(F3:F14)", "row", 3, -1, t, t) == ("=SUM(F3:F13)", False, False)
    # 删第14行 → 下界13
    assert _f("=SUM(F3:F14)", "row", 14, -1, t, t) == ("=SUM(F3:F13)", False, False)
    # 删第2行（范围上方）→ 整体-1 → F2:F13
    assert _f("=SUM(F3:F14)", "row", 2, -1, t, t) == ("=SUM(F2:F13)", False, False)
    # 删第15行（范围下方）→ 不变
    assert _f("=SUM(F3:F14)", "row", 15, -1, t, t) == ("=SUM(F3:F14)", False, False)
    # 范围完全被删：删第3-5行(共3行) → F3:F5 整体在删除区？范围F3:F14含删除区不全删
    assert _f("=SUM(F3:F14)", "row", 3, -3, t, t) == ("=SUM(F3:F11)", False, False)
    # 整列引用删行不变
    assert _f("=SUM(A:A)", "row", 5, -1, t, t) == ("=SUM(A:A)", False, False)
    print("  test_delete_row_range PASS")


# ============ 插行：范围扩展 ============
def test_insert_row_range():
    t = "S"
    # SUM(F3:F14) 插第5行 → F3:F15（范围扩展含新行）
    assert _f("=SUM(F3:F14)", "row", 5, 1, t, t) == ("=SUM(F3:F15)", False, False)
    # 插第2行（范围上方）→ 整体+1 → F4:F15
    assert _f("=SUM(F3:F14)", "row", 2, 1, t, t) == ("=SUM(F4:F15)", False, False)
    # 插第15行（范围下方）→ 不变
    assert _f("=SUM(F3:F14)", "row", 15, 1, t, t) == ("=SUM(F3:F14)", False, False)
    # 单点插行
    assert _f("=C5", "row", 5, 1, t, t) == ("=C6", False, False)
    assert _f("=C4", "row", 5, 1, t, t) == ("=C4", False, False)
    print("  test_insert_row_range PASS")


# ============ 删列 ============
def test_delete_col():
    t = "S"
    # =C5*D5 删C列(第3列) → C被删#REF!，D→C → #REF!*C5
    assert _f("=C5*D5", "col", 3, -1, t, t) == ("=#REF!*C5", True, False)
    # =A1+B1 删C列 → 不变
    assert _f("=A1+B1", "col", 3, -1, t, t) == ("=A1+B1", False, False)
    # 范围 B:D 删C → B:C
    assert _f("=SUM(B5:D5)", "col", 3, -1, t, t) == ("=SUM(B5:C5)", False, False)
    # 整行引用 1:1 删列不变
    assert _f("=SUM(1:1)", "col", 3, -1, t, t) == ("=SUM(1:1)", False, False)
    print("  test_delete_col PASS")


# ============ 跨 sheet 引用 ============
def test_cross_sheet():
    # 公式在 MatchDan：VLOOKUP(B5,DanRef!A:C,...)
    # 删 MatchDan 第5行 → B5位移，DanRef!A:C不动
    r = _f("=VLOOKUP(B5,DanRef!A:C,2,FALSE)", "row", 5, -1,
           target="MatchDan", cur="MatchDan")
    assert r == ("=VLOOKUP(#REF!,DanRef!A:C,2,FALSE)", True, False), r
    # 删 DanRef 第5行 → B5不动(无前缀但cur=MatchDan≠DanRef)，A:C整列删行不动
    r = _f("=VLOOKUP(B5,DanRef!A:C,2,FALSE)", "row", 5, -1,
           target="DanRef", cur="MatchDan")
    assert r == ("=VLOOKUP(B5,DanRef!A:C,2,FALSE)", False, False), r
    # 跨sheet单点：=DanRef!A6 删DanRef第5行 → DanRef!A5
    r = _f("=DanRef!A6", "row", 5, -1, target="DanRef", cur="MatchDan")
    assert r == ("=DanRef!A5", False, False), r
    print("  test_cross_sheet PASS")


# ============ 字符串字面量 / 动态函数 ============
def test_string_and_dynamic():
    t = "S"
    # 字符串里的 A1 不被误改
    r = _f('=IF(F3=0,0,C3/F3)&"-文本A1不应改"', "row", 5, -1, t, t)
    assert r == ('=IF(F3=0,0,C3/F3)&"-文本A1不应改"', False, False), r
    # 删第3行 → F3/C3 受影响，字符串不动
    r = _f('=IF(F3=0,0,C3/F3)&"-文本A1不应改"', "row", 3, -1, t, t)
    assert r == ('=IF(#REF!=0,0,#REF!/#REF!)&"-文本A1不应改"', True, False), r
    # 动态函数 → 跳过原样返回
    r = _f("=OFFSET(A1,1,0)", "row", 5, -1, t, t)
    assert r == ("=OFFSET(A1,1,0)", False, True), r
    r = _f("=INDIRECT(\"A1\")", "row", 5, -1, t, t)
    assert r == ('=INDIRECT("A1")', False, True), r
    print("  test_string_and_dynamic PASS")


# ============ 工作簿级批量 ============
def test_workbook_batch(tmp_path):
    import openpyxl
    p = tmp_path / "wb.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Data"
    ws["A1"] = "h"
    ws["A2"] = 1
    ws["A3"] = 2
    ws["A4"] = 3
    ws["A5"] = "=SUM(A2:A4)"   # 求和 6
    ws["A6"] = "=A3+A4"        # 5
    # 删第3行（Data sheet）：物理移动后原 A5→A4、原 A6→A5
    ws.delete_rows(3)
    report = shift_workbook_formulas(wb, "Data", "row", 3, -1)
    # 原 SUM(A2:A4) 现在A4位 → 删第3行 A3被删收口 → A2:A3
    assert ws["A4"].value == "=SUM(A2:A3)", ws["A4"].value
    # 原 A3+A4 现在A5位 → A3被删#REF!，A4→A3 → #REF!+A3
    assert ws["A5"].value == "=#REF!+A3", ws["A5"].value
    assert report.ref_errors >= 1
    assert report.needs_manual_fix
    print("  test_workbook_batch PASS")


if __name__ == "__main__":
    import tempfile, pathlib
    test_delete_row_point()
    test_delete_row_range()
    test_insert_row_range()
    test_delete_col()
    test_cross_sheet()
    test_string_and_dynamic()
    with tempfile.TemporaryDirectory() as d:
        test_workbook_batch(pathlib.Path(d))
    print("\n=== 全部位移器单测 PASS ===")
