"""文件监听与自动刷新机制（基于 watchdog）。

监听 data/（默认 resources/）目录的文件变更事件：
  - 防抖机制（默认 1 秒延迟）：避免 Excel 保存时连续触发多次回调。
  - 文件变更时自动调用 table_index.refresh_if_changed 刷新元数据，
    并通过 on_refresh 回调通知上层（AI 上下文已更新）。

watchdog 未安装时，start() 抛出 RuntimeError 提示安装；
仍可调用 refresh_now() 手动触发一次增量刷新。
"""

from __future__ import annotations

import threading
from pathlib import Path
from typing import Callable, Optional

from .table_index import refresh_if_changed, RefreshResult


def has_watchdog() -> bool:
    """是否已安装 watchdog 库。"""
    try:
        import watchdog  # noqa: F401
        return True
    except ImportError:
        return False


class TableFileWatcher:
    """resources/ 目录文件变更监听器，带防抖与自动刷新。

    Args:
        workspace: 监听的资源根目录（如 resources/）。
        on_refresh: 刷新完成后的回调，签名 (RefreshResult) -> None；可选。
        debounce: 防抖延迟秒数，默认 1.0。
        patterns: 监听的文件模式，默认 ("*.xlsx",)。
    """

    def __init__(self, workspace: Path | str,
                 on_refresh: Optional[Callable[[RefreshResult], None]] = None,
                 debounce: float = 1.0,
                 patterns: tuple[str, ...] = ("*.xlsx",)):
        self.workspace = Path(workspace)
        self.on_refresh = on_refresh
        self.debounce = debounce
        self.patterns = patterns
        self._observer = None
        self._timer: Optional[threading.Timer] = None
        self._lock = threading.Lock()
        self._running = False

    @property
    def running(self) -> bool:
        return self._running

    def start(self) -> None:
        """启动后台监听线程。watchdog 未安装时抛 RuntimeError。"""
        if self._running:
            return
        if not has_watchdog():
            raise RuntimeError(
                "未安装 watchdog：python -m pip install watchdog。"
                "或调用 refresh_now() 手动触发刷新。"
            )
        from watchdog.observers import Observer
        from watchdog.events import FileSystemEventHandler, PatternMatchingEventHandler

        handler = _DebouncedHandler(
            callback=self._trigger_refresh,
            debounce=self.debounce,
            patterns=self.patterns,
        )
        self._observer = Observer()
        self._observer.schedule(handler, str(self.workspace), recursive=True)
        self._observer.daemon = True
        self._observer.start()
        self._running = True

    def stop(self) -> None:
        """停止监听并取消待执行的防抖定时器。"""
        if self._timer is not None:
            self._timer.cancel()
            self._timer = None
        if self._observer is not None:
            self._observer.stop()
            self._observer.join(timeout=5)
            self._observer = None
        self._running = False

    def refresh_now(self) -> RefreshResult:
        """手动触发一次增量刷新（无需 watchdog）。"""
        return self._trigger_refresh()

    # ── 内部 ─────────────────────────────────────────────────

    def _trigger_refresh(self) -> RefreshResult:
        """执行 refresh_if_changed 并通知回调。受锁保护避免并发刷新。"""
        with self._lock:
            result = refresh_if_changed(self.workspace)
        if result.refreshed and self.on_refresh is not None:
            try:
                self.on_refresh(result)
            except Exception:
                pass  # 回调失败不影响刷新主流程
        return result


# 动态选择基类：watchdog 可用时继承 PatternMatchingEventHandler 以支持 patterns 过滤，
# 否则退化为普通 object，on_any_event 自行过滤。
if has_watchdog():
    from watchdog.events import PatternMatchingEventHandler as _HandlerBase
else:
    _HandlerBase = object


class _DebouncedHandler(_HandlerBase):
    """防抖事件处理器：收到变更事件后，延迟 debounce 秒再触发回调；
    延迟期内再有事件则重置计时器。
    """

    def __init__(self, callback: Callable[[], None], debounce: float,
                 patterns: tuple[str, ...]):
        if has_watchdog():
            _HandlerBase.__init__(self, patterns=list(patterns))
        self._callback = callback
        self._debounce = debounce
        self._timer: Optional[threading.Timer] = None
        self._lock = threading.Lock()

    def _schedule(self) -> None:
        """（重）设置防抖定时器。"""
        with self._lock:
            if self._timer is not None:
                self._timer.cancel()
            self._timer = threading.Timer(self._debounce, self._fire)
            self._timer.daemon = True
            self._timer.start()

    def _fire(self) -> None:
        try:
            self._callback()
        except Exception:
            pass

    # watchdog 事件回调（仅 watchdog 可用时被调用）
    def on_any_event(self, event):  # type: ignore[override]
        # 忽略临时文件（~$ 开头）与目录事件
        src = getattr(event, "src_path", "") or ""
        if not src or Path(src).name.startswith("~$"):
            return
        if getattr(event, "is_directory", False):
            return
        self._schedule()

    def on_modified(self, event):
        self.on_any_event(event)

    def on_created(self, event):
        self.on_any_event(event)

    def on_deleted(self, event):
        self.on_any_event(event)

    def on_moved(self, event):
        self.on_any_event(event)


if __name__ == "__main__":
    ws = Path(__file__).resolve().parent.parent.parent / "resources"
    w = TableFileWatcher(ws, on_refresh=lambda r: print(f"[回调] 刷新完成: 变更{len(r.changed)} 新增{len(r.added)} 删除{len(r.removed)}"))
    if not has_watchdog():
        print("watchdog 未安装，执行手动刷新：")
        r = w.refresh_now()
        print(f"  refreshed={r.refreshed} total={r.total}")
    else:
        print("watchdog 已安装，启动监听 10 秒...")
        w.start()
        import time
        time.sleep(10)
        w.stop()
        print("已停止")
