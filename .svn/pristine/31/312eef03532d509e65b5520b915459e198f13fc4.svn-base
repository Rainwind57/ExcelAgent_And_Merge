"""error_classifier 单测：覆盖每类 ErrorType 分类与 verify 门控优先级。

capability: error-classification-repair
"""
from __future__ import annotations

import os
import sys
import types

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.excel.error_classifier import (
    ClassifiedError,
    ErrorType,
    VerifyResult,
    classify,
)


def _result(steps=None, message=""):
    """构造最小 AgentResult-like 对象。"""
    return types.SimpleNamespace(steps=steps or [], message=message)


def _step(name, ok, detail=""):
    return types.SimpleNamespace(name=name, ok=ok, detail=detail)


def test_verify_cross_ref_broken_high_confidence():
    """verify 门控 dangling → cross_ref_broken，置信度高。"""
    vr = VerifyResult(
        passed=False,
        failed_kind=ErrorType.CROSS_REF_BROKEN,
        dangling_refs=[{"col_header": "灵兽id", "value": "999"}],
        checked=12,
    )
    err = classify(None, _result(), vr)
    assert err.error_type is ErrorType.CROSS_REF_BROKEN
    assert err.confidence >= 0.9
    assert err.failed_col == "灵兽id"
    assert err.verify_signals["dangling_refs"]


def test_verify_type_issue_from_verify():
    vr = VerifyResult(
        passed=False,
        failed_kind=ErrorType.TYPE_MISMATCH,
        type_issues=[{"column": "等级", "value": "abc"}],
    )
    err = classify(None, _result(), vr)
    assert err.error_type is ErrorType.TYPE_MISMATCH
    assert err.failed_col == "等级"


def test_step_detail_type_mismatch():
    """step.detail 含 '类型为 int...无法转为' → type_mismatch。"""
    res = _result(steps=[_step("write", False, "列[等级]类型为 int，值'abc'无法转为整数")])
    err = classify(None, res)
    assert err.error_type is ErrorType.TYPE_MISMATCH
    assert err.failed_col == "等级"
    assert err.confidence >= 0.8


def test_step_detail_column_not_found():
    res = _result(steps=[_step("locate_col", False, "列[灵兽名称]不存在")])
    err = classify(None, res)
    assert err.error_type is ErrorType.COLUMN_NOT_FOUND


def test_column_not_found_via_headers_context():
    """failed_col 不在 ctx.headers → column_not_found。"""
    res = _result(steps=[_step("write", False, "列[灵兽名]值'小白' 写入失败")])
    err = classify(None, res, context={"headers": ["灵兽名称", "等级"]})
    assert err.error_type is ErrorType.COLUMN_NOT_FOUND


def test_step_detail_row_not_found():
    res = _result(steps=[_step("locate_row", False, "行未找到：零命中")])
    err = classify(None, res)
    assert err.error_type is ErrorType.ROW_NOT_FOUND


def test_step_detail_id_conflict():
    res = _result(steps=[_step("write", False, "主键 1001 重复")])
    err = classify(None, res)
    assert err.error_type is ErrorType.ID_CONFLICT


def test_step_detail_formula_error():
    res = _result(steps=[_step("formula", False, "公式 #REF! 引用断裂")])
    err = classify(None, res)
    assert err.error_type is ErrorType.FORMULA_ERROR


def test_pk_misplaced_via_context_signal():
    res = _result(steps=[_step("write", False, "主键误塞")])
    err = classify(None, res, context={"pk_misplaced": True, "pk_value": "效果码"})
    assert err.error_type is ErrorType.PK_MISPLACED
    assert err.failed_val == "效果码"


def test_anti_pattern_block_step():
    res = _result(steps=[_step("anti_pattern_block", False, "反模式拦截删除")])
    err = classify(None, res)
    assert err.error_type is ErrorType.UNKNOWN
    assert err.verify_signals.get("anti_pattern_block") is True


def test_unknown_fallback():
    res = _result(steps=[_step("write", False, "某些未知错误")])
    err = classify(None, res)
    assert err.error_type is ErrorType.UNKNOWN
    assert err.confidence <= 0.5


def test_verify_priority_over_step_detail():
    """verify 门控信号优先于 step.detail 模式。"""
    vr = VerifyResult(passed=False, failed_kind=ErrorType.ID_CONFLICT, id_issues=[{"value": "1001"}])
    res = _result(steps=[_step("write", False, "列[等级]类型为 int，值'abc'无法转为整数")])
    err = classify(None, res, vr)
    assert err.error_type is ErrorType.ID_CONFLICT


def test_as_feedback_structure():
    err = ClassifiedError(error_type=ErrorType.TYPE_MISMATCH, confidence=0.85, failed_col="等级", failed_val="abc")
    fb = err.as_feedback()
    assert fb["error_type"] == "type_mismatch"
    assert fb["failed_col"] == "等级"
    assert "confidence" in fb
