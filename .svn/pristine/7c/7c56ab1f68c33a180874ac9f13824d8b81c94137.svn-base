"""R23 新增二段提交（dry-run 预览）验证脚本。

验证点：
  A. dry_run=true 返回预览不写盘 — ok=True, dry_run=True, inserted_values 非空, new_row=None
  B. dry_run=true 校验失败 — ok=False, 不写盘
  C. dry_run=false 真写盘 — ok=True, dry_run=False, new_row 非 None
  D. dry_run 后表行数不变（未写盘），dry_run=false 后行数+1
  E. 预览值含类型转换（int 列传字符串转数字）

注意：会真实写盘，测前备份 fabao.xlsx，测后还原。
"""
from __future__ import annotations

import os
import sys
import shutil
from pathlib import Path

sys.path.insert(0, str(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from services.agent_service import get_agent_service
from models.agent_models import FormCommitRequest

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def main():
    svc = get_agent_service()
    stem, sheet = "fabao", "Fabao"
    res_path = Path("resources/fabao.xlsx")
    backup = Path("resources/_fabao_backup_r23.xlsx")
    shutil.copy2(res_path, backup)
    print(f"已备份 fabao.xlsx → {backup.name}")

    try:
        # 原始行数
        data0 = svc.get_sheet_data(stem, sheet, page=1, page_size=100)
        n0 = data0.total_rows
        print(f"原始行数: {n0}")

        print("[A] dry_run=true 返回预览不写盘")
        r = svc.commit_add_row(FormCommitRequest(
            table_stem=stem, sheet=sheet, dry_run=True,
            values={"1": "999", "2": "测试dryrun法宝", "3": "Icon_dry.png"}))
        _check("ok=True", r.ok, f"msg={r.message}")
        _check("dry_run=True", r.dry_run is True)
        _check("inserted_values 非空", len(r.inserted_values) > 0, str(r.inserted_values))
        _check("new_row=None（未写盘）", r.new_row is None)
        # 表行数不变
        data1 = svc.get_sheet_data(stem, sheet, page=1, page_size=100)
        _check("行数不变", data1.total_rows == n0, f"{n0}→{data1.total_rows}")

        print("[B] dry_run=true 校验失败")
        # 法宝id=1 已存在 → 校验应失败（pk 冲突）
        r = svc.commit_add_row(FormCommitRequest(
            table_stem=stem, sheet=sheet, dry_run=True,
            values={"1": "1", "2": "重复id测试"}))
        _check("ok=False（校验失败）", not r.ok)
        _check("dry_run=True", r.dry_run is True)
        data2 = svc.get_sheet_data(stem, sheet, page=1, page_size=100)
        _check("行数不变", data2.total_rows == n0)

        print("[C] dry_run=false 真写盘")
        r = svc.commit_add_row(FormCommitRequest(
            table_stem=stem, sheet=sheet, dry_run=False,
            values={"1": "888", "2": "测试真写法宝", "3": "Icon_real.png"}))
        _check("ok=True", r.ok, f"msg={r.message}")
        _check("dry_run=False", r.dry_run is False)
        _check("new_row 非 None（已写盘）", r.new_row is not None, f"new_row={r.new_row}")
        data3 = svc.get_sheet_data(stem, sheet, page=1, page_size=100)
        _check("行数+1", data3.total_rows == n0 + 1, f"{n0}→{data3.total_rows}")

        print("[D] dry_run 不写盘 vs dry_run=false 写盘对比")
        _check("dry_run 后行数不变", data1.total_rows == n0)
        _check("dry_run=false 后行数+1", data3.total_rows == n0 + 1)

        print("[E] 预览值含类型转换")
        r = svc.commit_add_row(FormCommitRequest(
            table_stem=stem, sheet=sheet, dry_run=True,
            values={"1": "777", "2": "类型转换测试"}))
        _check("ok=True", r.ok)
        if r.ok and r.inserted_values:
            v1 = r.inserted_values.get("1") or r.inserted_values.get(1)
            _check("id 列转为 int", v1 == 777 or str(v1) == "777", str(v1))

    finally:
        shutil.copy2(backup, res_path)
        backup.unlink()
        print(f"\n已还原 fabao.xlsx（删除 {backup.name}）")

    print(f"\n{'='*40}")
    print(f"R23 验证结果: {_passed} PASS / {_failed} FAIL")
    return 0 if _failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
