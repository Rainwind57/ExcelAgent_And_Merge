"""R5 验证：仅跑 skill=on 轮（cases 106-111），对照 v5 on baseline。
跑完输出 per-case + aggregate + vs v5 delta。临时脚本，验证后可删。
"""
from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

# 与 v5 一致的测试配置
os.environ.setdefault("CODEMAKER_VERIFY_REPAIR_MAX_ROUNDS", "1")
os.environ.setdefault("CODEMAKER_STEP5_TRACE", "1")
os.environ["TABLE_CASE_EVAL_RUNNING"] = "1"

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from tests.table_case_eval import (
    RES, DEFAULT_CASES_FILE, run_one_case, aggregate, load_cases,
)

V5_JSON = Path(__file__).resolve().parent / "reports" / "new6_v5" / "table_case_eval_latest.json"
OUT_DIR = Path(__file__).resolve().parent / "reports" / "new6_v6"
OUT_DIR.mkdir(parents=True, exist_ok=True)

START, END = 106, 111


def main() -> None:
    cases_all = load_cases(DEFAULT_CASES_FILE)
    on_results = []
    run_cases = []
    v5_on = {}
    if V5_JSON.exists():
        try:
            v5 = json.loads(V5_JSON.read_text(encoding="utf-8"))
            v5_on = v5.get("on") or v5.get("summary") or {}
        except Exception:
            pass

    print(f"R5 on-only 验证：cases {START}-{END}，skill=on 单轮")
    print(f"v5 on baseline: locate={v5_on.get('locate_rate','?')} "
          f"cov={v5_on.get('coverage','?')} acc={v5_on.get('field_accuracy','?')}")
    print("=" * 60)

    for i, case in enumerate(cases_all, start=1):
        if i < START or i > END:
            continue
        print(f"[{i}/{len(cases_all)}] (on) {case['input'][:60]}")
        t0 = time.time()
        r = run_one_case(i, case, enable_skill=True, legacy=False)
        print(f"        ok={r.ok} cov={r.coverage:.2f} acc={r.field_accuracy:.2f} "
              f"locate={r.locate_rate:.2f} {r.elapsed_ms:.0f}ms "
              f"(总耗时 {time.time()-t0:.1f}s) err={r.error_type or '-'}")
        if r.error:
            print(f"        错误: {r.error[:120]}")
        on_results.append(r)
        run_cases.append(case)

    print("\n" + "=" * 60)
    on_agg = aggregate(on_results)
    print(f"v6 on 汇总（cases {START}-{END}）：")
    print(f"  定位={on_agg['locate_rate']:.4f} 覆盖={on_agg['coverage']:.4f} "
          f"精准={on_agg['field_accuracy']:.4f} 严格通过={on_agg['strict_pass_rate']:.4f} "
          f"ok率={on_agg['ok_rate']:.4f}")
    print(f"  耗时: avg={on_agg['avg_elapsed_ms']:.0f}ms 总计={on_agg['total_elapsed_s']:.1f}s")
    print(f"  ErrorType 分布: {on_agg.get('error_type_distribution', {})}")
    print(f"  LLM 调用: total={on_agg.get('total_llm_calls',0)} "
          f"avg={on_agg.get('avg_llm_calls',0)} tokens={on_agg.get('total_tokens',0)}")

    if v5_on:
        print("\nvs v5 on baseline（正=提升）：")
        for k, label in [("locate_rate", "定位"), ("coverage", "覆盖"),
                         ("field_accuracy", "精准"), ("strict_pass_rate", "严格通过"),
                         ("ok_rate", "ok率")]:
            v5v = v5_on.get(k)
            if v5v is None:
                continue
            delta = on_agg.get(k, 0) - v5v
            print(f"  {label}: v5={v5v:.4f} → v6={on_agg.get(k,0):.4f} ({delta:+.4f})")
        v5t = v5_on.get("avg_elapsed_ms")
        if v5t:
            print(f"  平均耗时: v5={v5t:.0f}ms → v6={on_agg['avg_elapsed_ms']:.0f}ms "
                  f"({on_agg['avg_elapsed_ms']-v5t:+.0f}ms)")

    # 落盘
    out_json = OUT_DIR / "table_case_eval_latest.json"
    out_json.write_text(json.dumps({
        "summary": on_agg, "round": "on-only", "cases": f"{START}-{END}",
        "vs_v5_on": v5_on,
    }, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"\n已保存: {out_json}")
    print("=" * 60)


if __name__ == "__main__":
    main()
