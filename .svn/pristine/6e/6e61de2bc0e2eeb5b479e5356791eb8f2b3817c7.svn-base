"""merge 公式缓存接入手动验证脚本（M2）。

独立可运行，产出对比报告，证明 merge 导出路径公式缓存保护生效：
  A. 裸 openpyxl save（未接保护）→ 公式缓存丢失（data_only 读到 None）
  B. merge 导出（走 _save_with_formula_cache）→ libreoffice 重算 → 缓存恢复

用法:
    python -m server.tests.verify_merge_formula_cache
    python -X utf8 -m server.tests.verify_merge_formula_cache   # Windows 中文输出
"""
from __future__ import annotations

import os
import sys
import shutil
import tempfile
from pathlib import Path

import openpyxl

# 确保 server/ 在 sys.path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.excel.formula_cache_validator import (
    FormulaCacheValidator, _has_formulas, snapshot_formulas,
)
from routers.diff import _save_with_formula_cache

ROOT = Path(__file__).resolve().parents[2]
FS = ROOT / "resources/qa_test/formula_merge_samples"
BASE = FS / "match_stat.xlsx"

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _cache_summary(path: Path) -> tuple[int, int]:
    """返回 (公式总数, 有缓存值数)。"""
    snap = snapshot_formulas(path)
    total = len(snap)
    cached = sum(1 for v in snap.values() if v is not None)
    return total, cached


def main():
    print("=" * 60)
    print("merge 公式缓存接入手动验证（M2）")
    print("=" * 60)

    if not BASE.is_file():
        print(f"[ERR] 样本不存在：{BASE}")
        print("      先运行: python -m server.tests.build_merge_formula_samples")
        sys.exit(1)

    v = FormulaCacheValidator()
    print(f"\nlibreoffice 可用: {v.libreoffice_available}")
    print(f"样本前缀分组: {FS.name}/match_stat*.xlsx（按文件名前缀判同源）")

    # 准备基准副本并预重算建缓存（模拟原始 match_dan.xlsx 缓存全在）
    work = Path(tempfile.mkdtemp(prefix="verify_merge_"))
    base = work / "match_stat.xlsx"
    shutil.copy2(BASE, base)
    if v.libreoffice_available:
        v._runner.recalculate(base)
    total, cached = _cache_summary(base)
    print(f"\n基准 match_stat.xlsx: 公式 {total} 个, 有缓存 {cached}/{total}")
    _check("基准公式缓存完好", cached == total, f"{cached}/{total}")

    # ── A. 裸 openpyxl save（未接保护）→ 缓存应丢失 ──
    print("\n--- A. 裸 openpyxl save（未接公式缓存保护）---")
    broken = work / "match_stat_broken.xlsx"
    wb = openpyxl.load_workbook(base, data_only=False)
    wb["SeasonStat"].cell(row=3, column=2, value=99)  # 改 season1 c1
    wb.save(broken)
    wb.close()
    t, c = _cache_summary(broken)
    print(f"  产物 {broken.name}: 公式 {t}, 有缓存 {c}/{t}")
    _check("裸 save 清空公式缓存", c == 0, f"丢失 {t - c}/{t}")

    # ── B. merge 导出（走 _save_with_formula_cache）→ 缓存应恢复 ──
    print("\n--- B. merge 导出（走 _save_with_formula_cache）---")
    fixed = work / "match_stat_3.xlsx"  # 导出产物共享公用前缀 match_stat
    wb = openpyxl.load_workbook(base, data_only=False)
    wb["SeasonStat"].cell(row=3, column=2, value=99)
    info = _save_with_formula_cache(wb, base, fixed)
    print(f"  产物 {fixed.name}: needs_manual_fix={info['needs_manual_fix']}")
    print(f"  cache_message: {info['cache_message']}")
    t, c = _cache_summary(fixed)
    print(f"  公式 {t}, 有缓存 {c}/{t}")
    _check("merge 导出恢复公式缓存", c == t, f"{c}/{t}")
    _check("导出文件名共享公用前缀", fixed.stem.rsplit('_', 1)[0] == "match_stat", fixed.name)
    _check("无需人工修复", not info["needs_manual_fix"])

    # ── C. 非公式表 fast-path ──
    print("\n--- C. 非公式表 fast-path（性能不退化）---")
    item_src = ROOT / "resources/item/item.xlsx"
    if item_src.is_file():
        nf = work / "item.xlsx"
        shutil.copy2(item_src, nf)
        nf_out = work / "item_1.xlsx"
        wb = openpyxl.load_workbook(nf, data_only=False)
        wb["ItemBase"].cell(row=2, column=1, value=999999)
        info = _save_with_formula_cache(wb, nf, nf_out)
        print(f"  {nf_out.name}: needs_manual_fix={info['needs_manual_fix']}  msg='{info['cache_message']}'")
        _check("非公式表 fast-path 跳过重算", "fast-path" in info["cache_message"])
    else:
        print("  [SKIP] resources/item/item.xlsx 不存在")

    shutil.rmtree(work, ignore_errors=True)
    print("\n" + "=" * 60)
    print(f"结果: {_passed} 通过, {_failed} 失败")
    print("=" * 60)
    sys.exit(1 if _failed else 0)


if __name__ == "__main__":
    main()
