import sys
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SERVER_DIR))

from openpyxl import load_workbook

fp = SERVER_DIR.parent / "merge" / "demo" / "trunk_r4" / "match_stat_s2.xlsx"
wb = load_workbook(fp)
ws = wb["SeasonStat"]
ws.cell(4, 2).value = 200   # 行4 c1：与子目录冲突（base=s1 的 20）
ws.cell(6, 2).value = 40    # 行6 c1：trunk 未改（仅子目录改 444，单向变更）
wb.save(fp)
wb.close()
wb = load_workbook(fp, data_only=True)
print("restored s2:", [wb["SeasonStat"].cell(r, 2).value for r in range(3, 7)])
wb.close()
