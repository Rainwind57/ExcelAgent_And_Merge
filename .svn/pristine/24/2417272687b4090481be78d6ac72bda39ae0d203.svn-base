"""M3 漏行检测 + M5 表头结构 diff + M6 sheet 集合 diff 验证。

样本：merge/trunk/ability.xlsx (base) + merge/src/devbranch1/ability_missing.xlsx (derived)
      merge/trunk/item.xlsx (base) + merge/src/devbranch1/item_missing.xlsx (derived)
"""
import sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from pathlib import Path
from engine.parser import read_excel, read_formulas, find_trunk_baseline, get_sheet_diff, get_common_sheets
from engine.compare import compare_sheet

PROJECT = Path(__file__).resolve().parent.parent.parent
TRUNK = PROJECT / 'merge' / 'trunk'
DEV = PROJECT / 'merge' / 'src' / 'devbranch1'

passed = 0
failed = 0


def check(name, cond, detail=''):
    global passed, failed
    if cond:
        passed += 1
        print(f'  PASS  {name}')
    else:
        failed += 1
        print(f'  FAIL  {name}  {detail}')


print('=== M3: find_trunk_baseline ===')
p = find_trunk_baseline('ability_missing.xlsx', [str(TRUNK), str(PROJECT / 'resources')])
check('trunk ability 定位', p is not None and p.endswith('ability.xlsx'), p)
p = find_trunk_baseline('item_missing.xlsx', [str(TRUNK), str(PROJECT / 'resources')])
check('trunk item 定位', p is not None and p.endswith('item.xlsx'), p)
p = find_trunk_baseline('ability_2.xlsx', [str(TRUNK), str(PROJECT / 'resources')])
check('trunk ability_2 定位', p is not None and p.endswith('ability.xlsx'), p)
p = find_trunk_baseline('nonexistent.xlsx', [str(TRUNK)])
check('不存在返回 None', p is None, p)

print('=== M3: missing_row 检测 (ability) ===')
base_fp = str(TRUNK / 'ability.xlsx')
dev_fp = str(DEV / 'ability_missing.xlsx')
base_name = 'ability.xlsx'
dev_name = 'ability_missing.xlsx'
file_sheets = {base_name: read_excel(base_fp), dev_name: read_excel(dev_fp)}
file_formulas = {base_name: read_formulas(base_fp), dev_name: read_formulas(dev_fp)}
common = get_common_sheets(file_sheets)
check('ability common sheets 含 Ability', 'Ability' in common, common)

merged = compare_sheet(file_sheets, base_name, 'Ability', file_formulas, detect_missing=True)
missing = [r for r in merged['rows'] if r['row_type'] == 'missing_row']
pks = sorted(r['key'] for r in missing)
check('检测到 2 个 missing_row', len(missing) == 2, f'实际 {len(missing)}: {pks}')
check('missing pk = [1002, 7013]', pks == ['1002', '7013'], pks)
check('stats.missing_rows = 2', merged['stats']['missing_rows'] == 2, merged['stats'])
check('missing_rows 摘要长度 2', len(merged['missing_rows']) == 2, merged['missing_rows'])
check('摘要含 sheet 字段', all(m['sheet'] == 'Ability' for m in merged['missing_rows']))

# 对比：detect_missing=False → 同样行标 deleted 而非 missing_row
merged_off = compare_sheet(file_sheets, base_name, 'Ability', file_formulas, detect_missing=False)
deleted_off = [r for r in merged_off['rows'] if r['row_type'] == 'deleted']
missing_off = [r for r in merged_off['rows'] if r['row_type'] == 'missing_row']
check('detect_missing=False → deleted 行', len(deleted_off) == 2, f'deleted={len(deleted_off)}')
check('detect_missing=False → 无 missing_row', len(missing_off) == 0, f'missing={len(missing_off)}')

print('=== M3: 多 sheet missing_row (item) ===')
base_fp = str(TRUNK / 'item.xlsx')
dev_fp = str(DEV / 'item_missing.xlsx')
base_name = 'item.xlsx'
dev_name = 'item_missing.xlsx'
file_sheets = {base_name: read_excel(base_fp), dev_name: read_excel(dev_fp)}
file_formulas = {base_name: read_formulas(base_fp), dev_name: read_formulas(dev_fp)}

# ItemBase 漏 10001
m_itembase = compare_sheet(file_sheets, base_name, 'ItemBase', file_formulas, detect_missing=True)
miss_ib = [r for r in m_itembase['rows'] if r['row_type'] == 'missing_row']
check('ItemBase missing 10001', sorted(r['key'] for r in miss_ib) == ['10001'], [r['key'] for r in miss_ib])

# Equipment 漏 15001, 15051
m_equip = compare_sheet(file_sheets, base_name, 'Equipment', file_formulas, detect_missing=True)
miss_eq = [r for r in m_equip['rows'] if r['row_type'] == 'missing_row']
check('Equipment missing [15001, 15051]', sorted(r['key'] for r in miss_eq) == ['15001', '15051'], [r['key'] for r in miss_eq])

print('=== M3: 部分衍生有不算漏行 ===')
# 模拟：base 有 id=X，衍生 A 有，衍生 B 无 → 不算 missing_row
fake_base = {'S': [['id', 'name'], ['1', 'a'], ['2', 'b'], ['3', 'c']]}
fake_a = {'S': [['id', 'name'], ['1', 'a'], ['2', 'b']]}  # 缺 3
fake_b = {'S': [['id', 'name'], ['1', 'a'], ['3', 'c']]}  # 缺 2
fs = {'base.xlsx': fake_base, 'a.xlsx': fake_a, 'b.xlsx': fake_b}
m = compare_sheet(fs, 'base.xlsx', 'S', None, detect_missing=True)
miss = [r for r in m['rows'] if r['row_type'] == 'missing_row']
check('部分衍生有 → 无 missing_row', len(miss) == 0, [r['key'] for r in miss])

# base 有 + 全衍生无 → missing_row
fake_c = {'S': [['id', 'name'], ['1', 'a']]}  # 缺 2 和 3
fs2 = {'base.xlsx': fake_base, 'c.xlsx': fake_c}
m2 = compare_sheet(fs2, 'base.xlsx', 'S', None, detect_missing=True)
miss2 = [r for r in m2['rows'] if r['row_type'] == 'missing_row']
check('全衍生无 → 2 个 missing_row', len(miss2) == 2, [r['key'] for r in miss2])

print('=== M5: structure_diff 检测 ===')
# 同表头 → None
sd = compare_sheet(fs, 'base.xlsx', 'S', None)
check('同表头 → structure_diff None', sd['structure_diff'] is None, sd['structure_diff'])

# 衍生加列
fake_add = {'S': [['id', 'name', 'extra'], ['1', 'a', 'x']]}
fs3 = {'base.xlsx': fake_base, 'add.xlsx': fake_add}
sd3 = compare_sheet(fs3, 'base.xlsx', 'S', None)
check('加列 → structure_diff 非空', sd3['structure_diff'] is not None, sd3['structure_diff'])
if sd3['structure_diff']:
    f3 = sd3['structure_diff']['files'].get('add.xlsx', {})
    check('加列 → added_cols=[extra]', f3.get('added_cols') == ['extra'], f3)

# 衍生删列
fake_del = {'S': [['id'], ['1']]}
fs4 = {'base.xlsx': fake_base, 'del.xlsx': fake_del}
sd4 = compare_sheet(fs4, 'base.xlsx', 'S', None)
check('删列 → structure_diff 非空', sd4['structure_diff'] is not None)
if sd4['structure_diff']:
    f4 = sd4['structure_diff']['files'].get('del.xlsx', {})
    check('删列 → removed_cols 含 name', 'name' in f4.get('removed_cols', []), f4)

print('=== M6: get_sheet_diff ===')
fs_sheets = {
    'base.xlsx': {'Sheet1': [], 'Sheet2': [], 'CONFIG': []},
    'a.xlsx': {'Sheet1': [], 'Sheet2': []},  # 缺 CONFIG
    'b.xlsx': {'Sheet1': [], 'Sheet2': [], 'CONFIG': [], 'Extra': []},  # 多 Extra
}
sdi = get_sheet_diff(fs_sheets, 'base.xlsx')
check('common = [Sheet1, Sheet2]（交集，CONFIG 缺于 a）', sorted(sdi['common']) == ['Sheet1', 'Sheet2'], sdi['common'])
check('missing_in_derived 含 CONFIG', any(m['sheet'] == 'CONFIG' for m in sdi['missing_in_derived']), sdi['missing_in_derived'])
check('extra_in_derived 含 Extra', 'Extra' in sdi['extra_in_derived'], sdi['extra_in_derived'])
# CONFIG 缺失在 a.xlsx
cfg = next(m for m in sdi['missing_in_derived'] if m['sheet'] == 'CONFIG')
check('CONFIG 缺失在 a.xlsx', cfg['missing_in'] == ['a.xlsx'], cfg)

print('=== M3: missing_row cells 含 trunk 值（供 restore 复用）===')
m_restore = compare_sheet(file_sheets, 'item.xlsx', 'ItemBase', file_formulas, detect_missing=True)
miss_row = next(r for r in m_restore['rows'] if r['row_type'] == 'missing_row' and r['key'] == '10001')
check('missing_row 有 cells', len(miss_row['cells']) > 0)
first_cell = miss_row['cells'][0]
check('cell.versions 含 trunk 基准值', 'item.xlsx' in first_cell['versions'], first_cell['versions'])
check('cell.value = trunk 值', first_cell['value'] == first_cell['versions']['item.xlsx'])

print(f'\n=== 结果：{passed} PASS / {failed} FAIL ===')
sys.exit(1 if failed else 0)
