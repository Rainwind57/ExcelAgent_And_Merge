"""公式引用位移器：增删行列后重写公式内的单元格引用。

泛化设计：纯按 sheet 名 + 公式 token 工作，**不依赖任何具体表名**。
任何含公式的 xlsx 增删行列都自动适用。

基于 openpyxl.formula.tokenizer 的 token 流，仅重写 OPERAND/RANGE token，
字符串字面量(TEXT)/数字/运算符等其他 token 原样保留——避免正则误伤字符串
里的 "A1" 等伪引用（这是纯正则方案的致命伤）。

复刻 Excel 删/插行列的引用重写规则：
  - 删行 idx(共 k 行)：引用行 r∈[idx, idx+k) → #REF!；r>=idx+k → r-k；r<idx → 不变
  - 插行 idx(共 k 行)：引用行 r>=idx → r+k；r<idx → 不变
  - 列同理（按列号）
  - 范围引用按区间收缩(删)/扩展(插)
  - 跨 sheet 引用：仅当其目标 sheet == 被操作 sheet 时才位移
  - 绝对引用($)同样位移（$只挡拖拽平移，不挡行列删除）
  - 整列引用(A:C)删行不动；整行引用(1:2)删列不动
  - 含 OFFSET/INDIRECT 动态函数 → 不重写，标记需人工（保守降级）

时序约定：先调 openpyxl delete_rows/cols/insert_cols 完成物理移动，
再对本 wb 调 shift_workbook_formulas 重写公式文本，最后 save。
"""
from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Any

from openpyxl.formula.tokenizer import Tokenizer
from openpyxl.utils import column_index_from_string, get_column_letter

logger = __import__("logging").getLogger(__name__)

_DYNAMIC_FUNCS = {"OFFSET", "INDIRECT"}

# sheet 限定符：'带空格的名'! 或 裸名!
_SHEET_PREFIX = re.compile(
    r"^(?:(?P<qsheet>'[^']+')|(?P<nsheet>[A-Za-z_][A-Za-z0-9_.]*))!(?P<body>.+)$",
    re.DOTALL,
)
# 单坐标段：$A$1 / A1 / $A / A / $1 / 1
_SEG = re.compile(r"^(?P<col>\$?[A-Za-z]{1,3})?(?P<row>\$?\d+)?$")


@dataclass
class ShiftReport:
    """位移器执行报告。"""
    rewritten_cells: int = 0       # 文本被改写的公式单元格数
    ref_errors: int = 0            # 产生 #REF! 的引用数
    skipped_dynamic: int = 0       # 因含动态函数跳过的公式数
    needs_manual_fix: bool = False
    message: str = ""

    def merge_into(self, cache_info: dict) -> dict:
        """把位移报告合并进 _save_with_cache_check 返回的 cache_info。"""
        if not self.needs_manual_fix and self.skipped_dynamic == 0 and self.ref_errors == 0:
            return cache_info
        fix = cache_info.get("needs_manual_fix", False) or self.needs_manual_fix
        msg = cache_info.get("cache_message", "")
        extra = self.message
        if extra:
            msg = f"{msg} | {extra}" if msg else extra
        return {"needs_manual_fix": fix, "cache_message": msg}


# ------------------------------------------------------------------
# 坐标位移原语
# ------------------------------------------------------------------
def _shift_point(n: int, idx: int, amount: int) -> tuple[int, bool]:
    """单点位移。返回 (新值, 是否被删)。

    amount>0 插入：n>=idx → n+amount；n<idx → 不变。
    amount<0 删除(k=-amount)：n∈[idx,idx+k) → 被删；n>=idx+k → n-k；n<idx → 不变。
    """
    if amount > 0:
        return (n + amount, False) if n >= idx else (n, False)
    k = -amount
    if idx <= n < idx + k:
        return (n, True)
    if n >= idx + k:
        return (n + amount, False)  # n - k
    return (n, False)


def _shift_range(a: int, b: int, idx: int, amount: int) -> tuple[int, int, bool]:
    """范围[a,b]位移（a<=b）。返回 (新a, 新b, 是否塌缩为#REF!)。"""
    if amount > 0:
        na = a + amount if a >= idx else a
        nb = b + amount if b >= idx else b
        return na, nb, False
    k = -amount
    lo, hi = idx, idx + k - 1  # 删除闭区间
    # 完全落在删除区 → 整体 #REF!
    if a >= lo and b <= hi:
        return 0, 0, True
    # 端点落入删除区 → 收口
    new_a = a
    if lo <= a <= hi:
        new_a = lo
    elif a > hi:
        new_a = a - k
    new_b = b
    if lo <= b <= hi:
        new_b = lo - 1
    elif b > hi:
        new_b = b - k
    if new_a > new_b:
        return 0, 0, True
    return new_a, new_b, False


# ------------------------------------------------------------------
# 引用 token 解析 / 格式化
# ------------------------------------------------------------------
def _parse_seg(seg: str) -> dict | None:
    m = _SEG.match(seg)
    if not m:
        return None
    col, row = m.group("col"), m.group("row")
    col_letters, row_num = None, None
    col_abs = row_abs = False
    if col:
        col_abs = col.startswith("$")
        col_letters = col.lstrip("$").upper()
    if row:
        row_abs = row.startswith("$")
        row_num = int(row.lstrip("$"))
    if col_letters is None and row_num is None:
        return None
    return {"col": col_letters, "row": row_num, "col_abs": col_abs, "row_abs": row_abs}


def _parse_ref(token: str) -> dict | None:
    """解析 RANGE token。返回结构化引用，失败返回 None。"""
    has_sheet = False
    sheet = None
    body = token
    m = _SHEET_PREFIX.match(token)
    if m:
        has_sheet = True
        sheet = m.group("qsheet") or m.group("nsheet")
        if sheet.startswith("'") and sheet.endswith("'"):
            sheet = sheet[1:-1]
        body = m.group("body")
    parts = body.split(":")
    if len(parts) > 2:
        return None
    seg1 = _parse_seg(parts[0])
    if seg1 is None:
        return None
    seg2 = None
    if len(parts) == 2:
        seg2 = _parse_seg(parts[1])
        if seg2 is None:
            return None
    return {"sheet": sheet, "has_sheet": has_sheet,
            "seg1": seg1, "seg2": seg2, "is_range": seg2 is not None}


def _format_seg(seg: dict) -> str:
    out = ""
    if seg["col"] is not None:
        out += "$" if seg["col_abs"] else ""
        out += seg["col"]
    if seg["row"] is not None:
        out += "$" if seg["row_abs"] else ""
        out += str(seg["row"])
    return out


def _format_ref(ref: dict) -> str:
    out = ""
    if ref["has_sheet"]:
        s = ref["sheet"]
        if re.search(r"[^\w]", s):
            out += f"'{s}'!"
        else:
            out += f"{s}!"
    out += _format_seg(ref["seg1"])
    if ref["is_range"]:
        out += ":" + _format_seg(ref["seg2"])
    return out


def _apply_shift(ref: dict, axis: str, idx: int, amount: int) -> bool:
    """对解析后的引用就地位移。返回是否产生 #REF!（整体塌缩/单点被删）。"""
    s1, s2 = ref["seg1"], ref["seg2"]
    if not ref["is_range"]:
        if axis == "row":
            if s1["row"] is None:
                return False  # 整列引用 A，删行不影响
            nr, deleted = _shift_point(s1["row"], idx, amount)
            if deleted:
                return True
            s1["row"] = nr
        else:
            if s1["col"] is None:
                return False  # 整行引用 1，删列不影响
            nr, deleted = _shift_point(column_index_from_string(s1["col"]), idx, amount)
            if deleted:
                return True
            s1["col"] = get_column_letter(nr)
        return False
    # 范围
    if axis == "row":
        r1, r2 = s1["row"], s2["row"]
        if r1 is None or r2 is None:
            return False  # 整列范围 A:C 或混合开区间，行维不动
        na, nb, deleted = _shift_range(r1, r2, idx, amount)
        if deleted:
            return True
        s1["row"], s2["row"] = na, nb
    else:
        c1, c2 = s1["col"], s2["col"]
        if c1 is None or c2 is None:
            return False  # 整行范围 1:2，列维不动
        n1, n2 = column_index_from_string(c1), column_index_from_string(c2)
        lo, hi = (n1, n2) if n1 <= n2 else (n2, n1)
        na, nb, deleted = _shift_range(lo, hi, idx, amount)
        if deleted:
            return True
        if n1 <= n2:
            s1["col"], s2["col"] = get_column_letter(na), get_column_letter(nb)
        else:
            s1["col"], s2["col"] = get_column_letter(nb), get_column_letter(na)
    return False


# ------------------------------------------------------------------
# 单条公式重写
# ------------------------------------------------------------------
def _has_dynamic_func(formula: str) -> bool:
    """检测公式是否含 OFFSET/INDIRECT 动态函数（基于 token，不误伤字符串）。"""
    try:
        for t in Tokenizer(formula).items:
            if t.type == "FUNC" and t.subtype == "OPEN":
                name = t.value.rstrip("(").upper()
                if name in _DYNAMIC_FUNCS:
                    return True
    except Exception:
        return False
    return False


def shift_formula(
    formula: str,
    axis: str,
    idx: int,
    amount: int,
    target_sheet: str,
    current_sheet: str | None = None,
) -> tuple[str, bool, bool]:
    """重写单条公式内的引用。

    Args:
        formula: 公式文本（以 = 开头）。
        axis: 'row' 或 'col'。
        idx: 操作起始行列号（1-based）。
        amount: 正=插入数量，负=删除数量。
        target_sheet: 被操作的 sheet 名（删/插发生的 sheet）。
        current_sheet: 公式所在 sheet 名。无 sheet 前缀的引用按此判定归属。

    Returns:
        (新公式文本, 是否含#REF!, 是否因动态函数跳过未改)。
    """
    if _has_dynamic_func(formula):
        return formula, False, True

    try:
        tokens = Tokenizer(formula).items
    except Exception:
        return formula, False, False

    out: list[str] = []
    has_err = False
    for t in tokens:
        if t.type == "OPERAND" and t.subtype == "RANGE":
            new_val, err = _rewrite_ref_token(
                t.value, axis, idx, amount, target_sheet, current_sheet)
            if err:
                has_err = True
            out.append(new_val)
        else:
            out.append(t.value)
    new_body = "".join(out)
    new_formula = ("=" + new_body) if formula.startswith("=") else new_body
    return new_formula, has_err, False


def permute_formula_rows(
    formula: str,
    row_map: dict[int, int],
    target_sheet: str,
    current_sheet: str | None = None,
) -> tuple[str, bool, bool]:
    """按行置换映射重写公式内的行引用（排序场景）。

    与 shift_formula 的整体偏移不同：排序是任意置换，每行 old→new 独立映射。
    仅重写落在 row_map 内的行引用；区外行号不变。

    用于排序后重写"数据区内"公式：行内计算随行搬移，引用的 old_row 需替换为
    new_row（内容跟随语义）。区外公式（如汇总行）不应调用本函数——其引用物理
    行号，纯排序不改变物理行号。

    Args:
        formula: 公式文本（以 = 开头）。
        row_map: {old_row: new_row} 置换映射（通常为数据区行）。
        target_sheet: 数据所在 sheet 名。
        current_sheet: 公式所在 sheet 名。无 sheet 前缀的引用按此判定归属。

    Returns:
        (新公式文本, 是否含#REF!, 是否因动态函数跳过)。
    """
    if not row_map:
        return formula, False, False
    if _has_dynamic_func(formula):
        return formula, False, True
    try:
        tokens = Tokenizer(formula).items
    except Exception:
        return formula, False, False

    out: list[str] = []
    has_err = False
    for t in tokens:
        if t.type == "OPERAND" and t.subtype == "RANGE":
            new_val, err = _permute_ref_token(
                t.value, row_map, target_sheet, current_sheet)
            if err:
                has_err = True
            out.append(new_val)
        else:
            out.append(t.value)
    new_body = "".join(out)
    new_formula = ("=" + new_body) if formula.startswith("=") else new_body
    return new_formula, has_err, False


def _permute_ref_token(
    token: str, row_map: dict[int, int],
    target_sheet: str, current_sheet: str | None,
) -> tuple[str, bool]:
    """按 row_map 重写单个 RANGE token。返回 (新token, 是否#REF!)。"""
    ref = _parse_ref(token)
    if ref is None:
        return token, False
    if ref["has_sheet"]:
        if ref["sheet"] != target_sheet:
            return token, False  # 指向他表，不动
    else:
        if current_sheet != target_sheet:
            return token, False  # 无前缀但公式不在被操作 sheet
    _apply_permute(ref, row_map)
    return _format_ref(ref), False


def _apply_permute(ref: dict, row_map: dict[int, int]) -> None:
    """就地按 row_map 替换引用行号。

    单点：行在 row_map 则替换。范围：两端各自映射后重排序（置换可能反转）。
    整列引用(A:C，row 为 None)不动。
    """
    s1, s2 = ref["seg1"], ref["seg2"]
    if not ref["is_range"]:
        if s1["row"] is not None and s1["row"] in row_map:
            s1["row"] = row_map[s1["row"]]
        return
    r1, r2 = s1["row"], s2["row"]
    if r1 is None or r2 is None:
        return  # 整列范围，行维不动
    nr1 = row_map.get(r1, r1)
    nr2 = row_map.get(r2, r2)
    s1["row"], s2["row"] = min(nr1, nr2), max(nr1, nr2)


def _rewrite_ref_token(
    token: str, axis: str, idx: int, amount: int,
    target_sheet: str, current_sheet: str | None,
) -> tuple[str, bool]:
    """重写单个 RANGE token。返回 (新token, 是否#REF!)。"""
    ref = _parse_ref(token)
    if ref is None:
        return token, False  # 解析失败，原样保留
    # 目标 sheet 归属判定
    if ref["has_sheet"]:
        if ref["sheet"] != target_sheet:
            return token, False  # 指向他表，不动
    else:
        if current_sheet != target_sheet:
            return token, False  # 无前缀但公式不在被操作 sheet
    deleted = _apply_shift(ref, axis, idx, amount)
    if deleted:
        return "#REF!", True
    return _format_ref(ref), False


# ------------------------------------------------------------------
# 工作簿级批量重写
# ------------------------------------------------------------------
def shift_workbook_formulas(
    wb, target_sheet: str, axis: str, idx: int, amount: int,
) -> ShiftReport:
    """遍历 wb 所有 sheet 的公式单元格，重写指向 target_sheet 的引用。

    泛化：扫描整个工作簿（跨 sheet 引用也在内），按目标 sheet 过滤。
    与具体表名无关，任何 xlsx 通用。
    """
    report = ShiftReport()
    for ws in wb.worksheets:
        for row in ws.iter_rows():
            for cell in row:
                v = cell.value
                if not (isinstance(v, str) and v.startswith("=")):
                    continue
                new_v, has_err, dynamic = shift_formula(
                    v, axis, idx, amount, target_sheet, current_sheet=ws.title)
                if dynamic:
                    report.skipped_dynamic += 1
                    report.needs_manual_fix = True
                    continue
                if new_v != v:
                    cell.value = new_v
                    report.rewritten_cells += 1
                if has_err:
                    report.ref_errors += 1
                    report.needs_manual_fix = True

    parts: list[str] = []
    if report.rewritten_cells:
        parts.append(f"重写{report.rewritten_cells}个公式引用")
    if report.ref_errors:
        parts.append(f"产生{report.ref_errors}个#REF!(被删行/列正被引用)")
    if report.skipped_dynamic:
        parts.append(f"{report.skipped_dynamic}个含OFFSET/INDIRECT动态函数需人工核对")
    report.message = "；".join(parts)
    if report.needs_manual_fix and not report.message:
        report.message = "公式引用位移后需人工核对"
    return report
