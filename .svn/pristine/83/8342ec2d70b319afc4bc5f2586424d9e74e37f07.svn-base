"""R18 clone 路径 inserted 行按 id 排序插入中间位置 验证脚本。

验证点：
  A. 单条 inserted 行插入中间位置（主键落在已存在行之间，非追加表末）
  B. 单条 inserted 行追加末尾（主键比所有已存在大）
  C. 多条 inserted 行混合（中间 + 末尾）
  D. 已存在公式单元格行引用 shift（insert_rows 引起行下移后公式仍指向正确数据行）
  E. inserted 行自身公式重写为实际行号（行内相对公式）
  F. 主键批注（编号重映射 + 新增来源）合并写入

用法:
    python -m server.tests.verify_r18_inserted_position
    python -X utf8 -m server.tests.verify_r18_inserted_position   # Windows 中文输出
"""
from __future__ import annotations

import os
import sys
import shutil
import tempfile
from pathlib import Path

import openpyxl

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from routers.diff import _apply_edits_to_workbook, _pk_sort_key, _plan_inserted_row_positions
from engine.models import MergeRequest, SheetMergeData, RowData, CellData

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _make_cell(col: int, value, versions=None, diff_type="", formula_text="") -> CellData:
    from openpyxl.utils import get_column_letter
    return CellData(
        col=col,
        col_letter=get_column_letter(col + 1),
        value=value,
        versions=versions or {},
        diff_type=diff_type,
        formula_text=formula_text,
    )


def _build_simple_ws(ws, pks_vals):
    """写表头 + 数据行。pks_vals: [(pk, [v1, v2, ...]), ...]"""
    ws.cell(1, 1, "id")
    ws.cell(1, 2, "name")
    ws.cell(1, 3, "val")
    for i, (pk, vals) in enumerate(pks_vals):
        r = i + 2
        ws.cell(r, 1, pk)
        for ci, v in enumerate(vals):
            ws.cell(r, ci + 2, v)


def _read_rows(ws):
    """读所有数据行 [(pk, [v1, v2, ...]), ...]"""
    rows = []
    for r in range(2, ws.max_row + 1):
        pk = ws.cell(r, 1).value
        vals = [ws.cell(r, c).value for c in range(2, ws.max_column + 1)]
        rows.append((pk, vals, r))
    return rows


# ─────────────────────────────────────────────────────────────
# A. 单条 inserted 中间插入
# ─────────────────────────────────────────────────────────────
def test_a_single_middle_insert():
    print("\n--- A. 单条 inserted 行插入中间位置 ---")
    work = Path(tempfile.mkdtemp(prefix="r18_a_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    _build_simple_ws(ws, [(1, ["a", 10]), (2, ["b", 20]), (4, ["d", 40]), (5, ["e", 50])])
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "name", "val"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, "a"), _make_cell(2, 10)]),
                RowData(key="2", row_type="matched", cells=[_make_cell(0, 2), _make_cell(1, "b"), _make_cell(2, 20)]),
                RowData(key="3", row_type="inserted", cells=[
                    _make_cell(0, 3, versions={"derived.xlsx": 3}),
                    _make_cell(1, "c", versions={"derived.xlsx": "c"}),
                    _make_cell(2, 30, versions={"derived.xlsx": 30}),
                ]),
                RowData(key="4", row_type="matched", cells=[_make_cell(0, 4), _make_cell(1, "d"), _make_cell(2, 40)]),
                RowData(key="5", row_type="matched", cells=[_make_cell(0, 5), _make_cell(1, "e"), _make_cell(2, 50)]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("PK 3 插入到 2 和 4 之间", pks_in_order == [1, 2, 3, 4, 5], f"实际: {pks_in_order}")
    _check("PK 3 不在末尾", rows[-1][0] != 3, f"末尾 PK: {rows[-1][0]}")
    # 定位 PK 3 的行号
    pk3_row = next(r[2] for r in rows if r[0] == 3)
    _check("PK 3 在第 4 行（表头第1行，1/2 在 2/3 行）", pk3_row == 4, f"PK 3 行号: {pk3_row}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# B. 单条 inserted 追加末尾
# ─────────────────────────────────────────────────────────────
def test_b_single_end_append():
    print("\n--- B. 单条 inserted 行追加末尾 ---")
    work = Path(tempfile.mkdtemp(prefix="r18_b_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    _build_simple_ws(ws, [(1, ["a", 10]), (2, ["b", 20]), (3, ["c", 30])])
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "name", "val"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, "a"), _make_cell(2, 10)]),
                RowData(key="2", row_type="matched", cells=[_make_cell(0, 2), _make_cell(1, "b"), _make_cell(2, 20)]),
                RowData(key="3", row_type="matched", cells=[_make_cell(0, 3), _make_cell(1, "c"), _make_cell(2, 30)]),
                RowData(key="9", row_type="inserted", cells=[
                    _make_cell(0, 9, versions={"d.xlsx": 9}),
                    _make_cell(1, "i", versions={"d.xlsx": "i"}),
                    _make_cell(2, 90, versions={"d.xlsx": 90}),
                ]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("PK 9 追加到末尾", pks_in_order == [1, 2, 3, 9], f"实际: {pks_in_order}")
    _check("PK 9 在最后一行", rows[-1][0] == 9, f"末尾 PK: {rows[-1][0]}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# C. 多条 inserted 混合（中间 + 末尾）
# ─────────────────────────────────────────────────────────────
def test_c_multiple_mixed():
    print("\n--- C. 多条 inserted 行混合（中间 + 末尾） ---")
    work = Path(tempfile.mkdtemp(prefix="r18_c_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    # 已存在: 1, 2, 5, 7
    _build_simple_ws(ws, [(1, ["a", 10]), (2, ["b", 20]), (5, ["e", 50]), (7, ["g", 70])])
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "name", "val"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, "a"), _make_cell(2, 10)]),
                RowData(key="2", row_type="matched", cells=[_make_cell(0, 2), _make_cell(1, "b"), _make_cell(2, 20)]),
                # inserted: 3 (中间), 4 (中间), 6 (中间), 8 (末尾), 9 (末尾)
                RowData(key="3", row_type="inserted", cells=[_make_cell(0, 3, versions={"d": 3}), _make_cell(1, "c", versions={"d": "c"}), _make_cell(2, 30, versions={"d": 30})]),
                RowData(key="4", row_type="inserted", cells=[_make_cell(0, 4, versions={"d": 4}), _make_cell(1, "d", versions={"d": "d"}), _make_cell(2, 40, versions={"d": 40})]),
                RowData(key="5", row_type="matched", cells=[_make_cell(0, 5), _make_cell(1, "e"), _make_cell(2, 50)]),
                RowData(key="6", row_type="inserted", cells=[_make_cell(0, 6, versions={"d": 6}), _make_cell(1, "f", versions={"d": "f"}), _make_cell(2, 60, versions={"d": 60})]),
                RowData(key="7", row_type="matched", cells=[_make_cell(0, 7), _make_cell(1, "g"), _make_cell(2, 70)]),
                RowData(key="8", row_type="inserted", cells=[_make_cell(0, 8, versions={"d": 8}), _make_cell(1, "h", versions={"d": "h"}), _make_cell(2, 80, versions={"d": 80})]),
                RowData(key="9", row_type="inserted", cells=[_make_cell(0, 9, versions={"d": 9}), _make_cell(1, "i", versions={"d": "i"}), _make_cell(2, 90, versions={"d": 90})]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("多 inserted 混合后整体升序", pks_in_order == [1, 2, 3, 4, 5, 6, 7, 8, 9], f"实际: {pks_in_order}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# D. 已存在公式单元格行引用 shift
# ─────────────────────────────────────────────────────────────
def test_d_formula_ref_shift():
    print("\n--- D. 已存在公式单元格行引用 shift ---")
    work = Path(tempfile.mkdtemp(prefix="r18_d_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    # 表头: id, val, sum
    ws.cell(1, 1, "id")
    ws.cell(1, 2, "val")
    ws.cell(1, 3, "sum")
    # 数据行（行号 2-5）: PK 1, 2, 4, 5；每行 sum 列公式 =B{r}+B{r}（自引用，行内相对）
    # 同时加一个跨行引用：PK 4 行的 sum 引用 PK 2 行（=B3+B5）
    ws.cell(2, 1, 1); ws.cell(2, 2, 10); ws.cell(2, 3, "=B2+B2")
    ws.cell(3, 1, 2); ws.cell(3, 2, 20); ws.cell(3, 3, "=B3+B3")
    ws.cell(4, 1, 4); ws.cell(4, 2, 40); ws.cell(4, 3, "=B3+B4")  # 跨行引用 PK 2 (行3) + 自身
    ws.cell(5, 1, 5); ws.cell(5, 2, 50); ws.cell(5, 3, "=B5+B5")
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "val", "sum"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, 10), _make_cell(2, 20, diff_type="formula", formula_text="=B2+B2")]),
                RowData(key="2", row_type="matched", cells=[_make_cell(0, 2), _make_cell(1, 20), _make_cell(2, 40, diff_type="formula", formula_text="=B3+B3")]),
                # inserted PK 3 → 插入到行 4（原 PK 4 在行 4，下移到行 5）
                RowData(key="3", row_type="inserted", cells=[_make_cell(0, 3, versions={"d": 3}), _make_cell(1, 30, versions={"d": 30})]),
                RowData(key="4", row_type="matched", cells=[_make_cell(0, 4), _make_cell(1, 40), _make_cell(2, 60, diff_type="formula", formula_text="=B3+B4")]),
                RowData(key="5", row_type="matched", cells=[_make_cell(0, 5), _make_cell(1, 50), _make_cell(2, 100, diff_type="formula", formula_text="=B5+B5")]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("PK 顺序正确 [1,2,3,4,5]", pks_in_order == [1, 2, 3, 4, 5], f"实际: {pks_in_order}")

    # 读各行的公式（sum 列，第 3 列）
    formulas = {}
    for r in range(2, ws.max_row + 1):
        pk = ws.cell(r, 1).value
        formulas[pk] = ws.cell(r, 3).value
    print(f"  各 PK 的 sum 公式: {formulas}")

    # PK 1 行号 2（未下移）→ 公式应仍 =B2+B2
    _check("PK 1 公式不变（行 2 未下移）", formulas[1] == "=B2+B2", f"实际: {formulas.get(1)}")
    # PK 2 行号 3（未下移）→ 公式应仍 =B3+B3
    _check("PK 2 公式不变（行 3 未下移）", formulas[2] == "=B3+B3", f"实际: {formulas.get(2)}")
    # PK 4 原行 4，inserted PK 3 插在行 4 → PK 4 下移到行 5
    # 原公式 =B3+B4：B3 指 PK 2（行 3，未下移）→ 仍 B3；B4 指自身（原行 4，下移到行 5）→ B5
    _check("PK 4 公式 shift: =B3+B4 → =B3+B5", formulas[4] == "=B3+B5", f"实际: {formulas.get(4)}")
    # PK 5 原行 5，下移到行 6 → 公式 =B5+B5 → =B6+B6
    _check("PK 5 公式 shift: =B5+B5 → =B6+B6", formulas[5] == "=B6+B6", f"实际: {formulas.get(5)}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# E. inserted 行自身公式重写为实际行号
# ─────────────────────────────────────────────────────────────
def test_e_inserted_formula_rewrite():
    print("\n--- E. inserted 行自身公式重写为实际行号 ---")
    work = Path(tempfile.mkdtemp(prefix="r18_e_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    ws.cell(1, 1, "id"); ws.cell(1, 2, "v1"); ws.cell(1, 3, "v2"); ws.cell(1, 4, "total")
    ws.cell(2, 1, 1); ws.cell(2, 2, 10); ws.cell(2, 3, 20); ws.cell(2, 4, "=B2+C2")
    ws.cell(3, 1, 5); ws.cell(3, 2, 50); ws.cell(3, 3, 60); ws.cell(3, 4, "=B3+C3")
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    # inserted PK 3 插到行 3（原 PK 5 在行 3，下移到行 4）
    # inserted 行的公式模板 =B{r}+C{r}（来自衍生文件，formula_text 用占位行号）
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "v1", "v2", "total"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, 10), _make_cell(2, 20), _make_cell(3, 30, diff_type="formula", formula_text="=B2+C2")]),
                RowData(key="3", row_type="inserted", cells=[
                    _make_cell(0, 3, versions={"d": 3}),
                    _make_cell(1, 30, versions={"d": 30}),
                    _make_cell(2, 40, versions={"d": 40}),
                    _make_cell(3, 70, diff_type="formula", formula_text="=B2+C2"),  # 模板，会被重写为实际行号
                ]),
                RowData(key="5", row_type="matched", cells=[_make_cell(0, 5), _make_cell(1, 50), _make_cell(2, 60), _make_cell(3, 110, diff_type="formula", formula_text="=B3+C3")]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("PK 顺序 [1, 3, 5]", pks_in_order == [1, 3, 5], f"实际: {pks_in_order}")

    # inserted PK 3 应在行 3，公式 =B3+C3（重写为实际行号 3）
    pk3_row = next(r[2] for r in rows if r[0] == 3)
    pk3_formula = ws.cell(pk3_row, 4).value
    print(f"  PK 3 行号 {pk3_row}, 公式: {pk3_formula}")
    _check("inserted PK 3 公式重写为 =B3+C3", pk3_formula == "=B3+C3", f"实际: {pk3_formula}")

    # PK 5 原行 3，下移到行 4，公式 =B3+C3 → =B4+C4
    pk5_row = next(r[2] for r in rows if r[0] == 5)
    pk5_formula = ws.cell(pk5_row, 4).value
    print(f"  PK 5 行号 {pk5_row}, 公式: {pk5_formula}")
    _check("PK 5 公式 shift: =B3+C3 → =B4+C4", pk5_formula == "=B4+C4", f"实际: {pk5_formula}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# F. 主键批注（编号重映射 + 新增来源）合并写入
# ─────────────────────────────────────────────────────────────
def test_f_notes_merged():
    print("\n--- F. 主键批注（编号重映射 + 新增来源）合并写入 ---")
    work = Path(tempfile.mkdtemp(prefix="r18_f_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    _build_simple_ws(ws, [(1, ["a", 10]), (5, ["e", 50])])
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "name", "val"],
            rows=[
                RowData(key="1", row_type="matched", cells=[_make_cell(0, 1), _make_cell(1, "a"), _make_cell(2, 10)]),
                # inserted PK 3，id_remapped（原 5 → 3），source_file/version 标注
                RowData(
                    key="3", row_type="inserted",
                    cells=[_make_cell(0, 3, versions={"d": 3}), _make_cell(1, "c", versions={"d": "c"}), _make_cell(2, 30, versions={"d": 30})],
                    id_remapped=True, original_pk="5",
                    source_file="derived_2.xlsx", source_version="2",
                ),
                RowData(key="5", row_type="matched", cells=[_make_cell(0, 5), _make_cell(1, "e"), _make_cell(2, 50)]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    _check("PK 顺序 [1, 3, 5]", pks_in_order == [1, 3, 5], f"实际: {pks_in_order}")

    pk3_row = next(r[2] for r in rows if r[0] == 3)
    pk_cell = ws.cell(pk3_row, 1)
    comment = pk_cell.comment
    _check("PK 3 主键单元格有批注", comment is not None, f"comment: {comment}")
    if comment:
        text = comment.text
        print(f"  批注内容: {text!r}")
        _check("批注含编号重映射信息", "原先编号：5" in text and "merge冲突修改为：3" in text, f"实际: {text}")
        _check("批注含新增来源信息", "新增来源：v2（derived_2.xlsx）" in text, f"实际: {text}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# G. 字符串主键自然排序（含字母前缀，base 已排序）
# ─────────────────────────────────────────────────────────────
def test_g_string_pk_natural_sort():
    print("\n--- G. 字符串主键自然排序 ---")
    work = Path(tempfile.mkdtemp(prefix="r18_g_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    # base 已按自然排序: item_1, item_2, item_10
    _build_simple_ws(ws, [("item_1", ["a", 10]), ("item_2", ["c", 30]), ("item_10", ["b", 20])])
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    # inserted: item_5（应插到 item_2 和 item_10 之间，自然排序）
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="Sheet1",
            headers=["id", "name", "val"],
            rows=[
                RowData(key="item_1", row_type="matched", cells=[_make_cell(0, "item_1"), _make_cell(1, "a"), _make_cell(2, 10)]),
                RowData(key="item_2", row_type="matched", cells=[_make_cell(0, "item_2"), _make_cell(1, "c"), _make_cell(2, 30)]),
                RowData(key="item_5", row_type="inserted", cells=[_make_cell(0, "item_5", versions={"d": "item_5"}), _make_cell(1, "e", versions={"d": "e"}), _make_cell(2, 50, versions={"d": 50})]),
                RowData(key="item_10", row_type="matched", cells=[_make_cell(0, "item_10"), _make_cell(1, "b"), _make_cell(2, 20)]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["Sheet1"]
    rows = _read_rows(ws)
    pks_in_order = [r[0] for r in rows]
    print(f"  导出后 PK 顺序: {pks_in_order}")
    # 自然排序: item_1, item_2, item_5, item_10
    _check("字符串 PK 自然排序（item_5 在 item_2 和 item_10 之间）",
           pks_in_order == ["item_1", "item_2", "item_5", "item_10"], f"实际: {pks_in_order}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


# ─────────────────────────────────────────────────────────────
# H. 字段类型行场景（真实配表结构：row1 表头 + row2 字段类型 + row3+ 数据）
# ─────────────────────────────────────────────────────────────
def test_h_field_type_row():
    print("\n--- H. 字段类型行场景（PK 含 ':' 排除定位） ---")
    work = Path(tempfile.mkdtemp(prefix="r18_h_"))
    base_path = work / "base.xlsx"
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "ItemBase"
    # row 1: 表头
    ws.cell(1, 1, "物品编号"); ws.cell(1, 2, "名称"); ws.cell(1, 3, "品质")
    # row 2: 字段类型行（PK = "item_id:int"）
    ws.cell(2, 1, "item_id:int"); ws.cell(2, 2, "name:string"); ws.cell(2, 3, "quality:int")
    # row 3: 约束行（第一列为空，被 key_to_row 跳过）
    ws.cell(3, 1, None); ws.cell(3, 2, None); ws.cell(3, 3, "required:1")
    # row 4-6: 数据行 PK 10001, 10002, 10004
    ws.cell(4, 1, 10001); ws.cell(4, 2, "剑"); ws.cell(4, 3, 1)
    ws.cell(5, 1, 10002); ws.cell(5, 2, "刀"); ws.cell(5, 3, 2)
    ws.cell(6, 1, 10004); ws.cell(6, 2, "枪"); ws.cell(6, 3, 4)
    wb.save(base_path)
    wb.close()

    wb = openpyxl.load_workbook(base_path)
    # inserted PK 10003（应插到 10002 和 10004 之间，即 row 6，而非 row 2 字段类型行前）
    req = MergeRequest(
        group_name="base",
        base_file="base.xlsx",
        sheets=[SheetMergeData(
            name="ItemBase",
            headers=["物品编号", "名称", "品质"],
            rows=[
                RowData(key="item_id:int", row_type="matched", cells=[_make_cell(0, "item_id:int"), _make_cell(1, "name:string"), _make_cell(2, "quality:int")]),
                RowData(key="10001", row_type="matched", cells=[_make_cell(0, 10001), _make_cell(1, "剑"), _make_cell(2, 1)]),
                RowData(key="10002", row_type="matched", cells=[_make_cell(0, 10002), _make_cell(1, "刀"), _make_cell(2, 2)]),
                RowData(key="10003", row_type="inserted", cells=[_make_cell(0, 10003, versions={"d": 10003}), _make_cell(1, "弓", versions={"d": "弓"}), _make_cell(2, 3, versions={"d": 3})]),
                RowData(key="10004", row_type="matched", cells=[_make_cell(0, 10004), _make_cell(1, "枪"), _make_cell(2, 4)]),
            ],
        )],
    )
    _apply_edits_to_workbook(wb, req)
    out_path = work / "out.xlsx"
    wb.save(out_path)
    wb.close()

    wb = openpyxl.load_workbook(out_path)
    ws = wb["ItemBase"]
    # 读所有行（含字段类型行）
    all_rows = []
    for r in range(1, ws.max_row + 1):
        all_rows.append((r, ws.cell(r, 1).value))
    print(f"  导出后各行 PK: {[(r, v) for r, v in all_rows]}")

    # 字段类型行应在 row 2（未被插入行推下）
    _check("字段类型行仍在 row 2", all_rows[1] == (2, "item_id:int"), f"实际 row 2: {all_rows[1]}")

    # 数据行顺序（跳过 row 1 表头 + row 2 字段类型 + row 3 约束行）
    data_pks = [v for r, v in all_rows if r >= 4 and v is not None]
    print(f"  数据行 PK 顺序: {data_pks}")
    _check("inserted 10003 插到 10002 和 10004 之间",
           data_pks == [10001, 10002, 10003, 10004], f"实际: {data_pks}")

    # 10003 不在 row 2（字段类型行前）
    pk10003_row = next(r for r, v in all_rows if v == 10003)
    _check("10003 不在字段类型行之前（row >= 4）", pk10003_row >= 4, f"实际 row: {pk10003_row}")
    wb.close()
    shutil.rmtree(work, ignore_errors=True)


def main():
    print("=" * 60)
    print("R18 clone 路径 inserted 行按 id 排序插入中间位置 验证")
    print("=" * 60)

    test_a_single_middle_insert()
    test_b_single_end_append()
    test_c_multiple_mixed()
    test_d_formula_ref_shift()
    test_e_inserted_formula_rewrite()
    test_f_notes_merged()
    test_g_string_pk_natural_sort()
    test_h_field_type_row()

    print("\n" + "=" * 60)
    print(f"结果: {_passed} 通过, {_failed} 失败")
    print("=" * 60)
    sys.exit(1 if _failed else 0)


if __name__ == "__main__":
    main()
