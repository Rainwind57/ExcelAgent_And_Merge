"""模式二：同分支目录合并 API。

把私有开发子目录 X 的若干次提交合并回任意指定的 Y 目录（一般 trunk 本体）。
以"子目录创建时刻的 Y 目录快照"为 merge-base，X 当前内容（source）与 Y 当前内容
（target）三方比对，复用 compare_sheet + commit_authors（同作者自动合并）+
formula_notice 规则——总体逻辑与模式一（merge_branch）完全一致，区别仅：

  - merge-base 来源：反查 source_dir（子目录）的 copyfrom/首次提交版本号，
    取该版本号对应的 target_dir 快照（`svn cat -r`）作 base。
  - 无 direction（只有 X→Y 一个方向）。
  - apply 落点固定写回 target_dir，版本化命名 {group}_{N+1}.xlsx（同 merge_back），
    mode="subdir"。

对应 openspec change `merge-svn-dual-mode` 任务 6.1-6.4。
"""
import json
import re
import shutil
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from functools import partial
from pathlib import Path
from typing import Dict, List, Optional, Any, Tuple

from fastapi import APIRouter, HTTPException, Response
from openpyxl import load_workbook
from pydantic import BaseModel

from config import MERGE_DIR
from engine.models import CompareResponse, FileGroup
from engine.parallel_compare import parallel_map_tables
from routers.merge_stages import (
    _build_group, _unresolved_conflicts, _sheets_stats,
    _collect_changes, _append_audit, _validate_apply_refs,
)
from routers.svn_history import _resolve_branch_path, _resolve_branch_point
from routers.diff import (
    _apply_edits_and_save, _save_with_formula_cache, get_next_merge_version,
)
from engine.fast_apply import collect_disk_sheet_pks
from routers.structural import compute_structural_changes, build_display_group, build_display_sheet
# 复用模式一的 SVN 辅助函数，不重复实现（见 HANDOFF §3 复用约定）
from routers.merge_branch import (
    _resolve_demo_or_wc, _list_branch_files, _svn_cat,
    _latest_author, _latest_revision_info, TableApplyItem,
    _flat_group_name, _group_path_in_dir, _locate_group_files,
    _fmt_rev, _rev_info_cached, _svn_export_dir, _dir_sheet_sets,
    _prefill_rev_cache,
)

router = APIRouter(prefix="/api/merge/subdir", tags=["merge-subdir"])

# list_subdir_dirs 扫描时跳过的目录：
#  - repo/：真实 SVN 仓库库体（svnadmin 产物，非工作副本）
#  - 其余为与目录合并语义无关的中间产物/legacy 目录
_SKIP_PARTS = {"history", "mergebase", ".snapshots", "src", "repo", "samples", "legacy", "scripts"}

# /dirs 结果缓存：全量 MERGE_DIR.rglob 扫描在文件多时是进页面最慢的一步，TTL 内复用；
# apply 产出新文件后由 merge_branch.invalidate_dirs_cache() 顺带失效本缓存。
_SUBDIR_DIRS_CACHE: Dict[str, Any] = {"ts": 0.0, "data": None}
_SUBDIR_DIRS_CACHE_TTL = 30.0

def invalidate_dirs_cache():
    """apply 成功后调，让下次 /dirs 重新扫描。"""
    _SUBDIR_DIRS_CACHE["ts"] = 0.0
    _SUBDIR_DIRS_CACHE["data"] = None


@router.get("/dirs")
def list_subdir_dirs():
    """列出可选目录（merge 下含 xlsx 的目录，含嵌套子目录），供前端下拉。

    与模式一 list_branch_dirs 的区别：目录合并需要选嵌套路径（如
    svn/demo_svn/wc/trunk/subdir_x_copied），故对 merge/ 做递归扫描而非只列顶层。
    真实 SVN 工作副本由 merge/svn/ 递归扫描（repo 库体除外）。
    """
    now = time.time()
    if _SUBDIR_DIRS_CACHE["data"] is not None and now - _SUBDIR_DIRS_CACHE["ts"] < _SUBDIR_DIRS_CACHE_TTL:
        return _SUBDIR_DIRS_CACHE["data"]
    dirs = []
    seen_paths = set()

    # merge 下真实 SVN 工作副本/目标目录（递归；排除 svn 仓库 repo 等无关目录）
    wc_dirs: List[Path] = []
    for fp in MERGE_DIR.rglob("*.xlsx"):
        if fp.name.startswith("~$") or fp.name.startswith("_"):
            continue
        if any(part in _SKIP_PARTS for part in fp.parts):
            continue
        parent = fp.parent.resolve()
        if parent in seen_paths or parent in {p.resolve() for p in wc_dirs}:
            continue
        wc_dirs.append(parent)
    for p in sorted(wc_dirs):
        rel = p.relative_to(MERGE_DIR.resolve()).as_posix()
        tables = sorted(_collect_subdir_table_keys(p))
        dirs.append({"name": rel, "type": "wc", "tables": tables,
                     "copyfrom": "", "note": ""})

    data = {"dirs": dirs}
    _SUBDIR_DIRS_CACHE["ts"] = time.time()
    _SUBDIR_DIRS_CACHE["data"] = data
    return data


_TABLE_SUFFIX_RE = re.compile(r"(?:_s\d+|_\d+)$")   # 时间点 _sN 或提交 _N 后缀


def _table_prefix(stem: str) -> str:
    """剥离版本后缀（时间点 _sN 或提交 _N：match_stat_s1 / match_stat_1 → match_stat），
    无后缀原样返回。

    子目录内表格用规范名 match_stat.xlsx 或多次提交 match_stat_1/_2（_N=提交序号），
    目标内带时间点后缀 match_stat_s1/s2；按前缀匹配才能把同一张表归并比对。
    """
    return _TABLE_SUFFIX_RE.sub("", stem)


@router.get("/tables")
def list_common_tables(source_dir: str, target_dir: str):
    """返回 source/target 两目录的交集表名（按前缀匹配），供前端下拉选择。

    支持嵌套子文件夹：表名为相对目录的 posix 路径（如 'config/balance/skill'），
    嵌套路径不做 _sN 后缀剥离（按相对路径精确匹配）；扁平表名仍按 _table_prefix 剥后缀。
    """
    src_dir = _resolve_demo_or_wc(source_dir)
    tgt_dir = _resolve_demo_or_wc(target_dir)
    if not src_dir.is_dir() or not tgt_dir.is_dir():
        raise HTTPException(400, "source_dir / target_dir 必须为目录")
    src_tables = _collect_subdir_table_keys(src_dir)
    tgt_tables = _collect_subdir_table_keys(tgt_dir)
    common = sorted(src_tables & tgt_tables)
    return {"common_tables": common, "source_only": sorted(src_tables - tgt_tables),
            "target_only": sorted(tgt_tables - src_tables)}


def _collect_subdir_table_keys(base_dir: Path) -> set:
    """收集目录下所有 xlsx 的表名 key（支持嵌套相对路径 + 扁平版本后缀剥离）。

    嵌套表（如 config/balance/skill.xlsx）→ 'config/balance/skill'（保留相对路径）；
    扁平表（如 match_stat_s1.xlsx / match_stat_1.xlsx）→ 'match_stat'（_table_prefix 裂后缀）。
    """
    keys = set()
    if not base_dir.is_dir():
        return keys
    for fp in base_dir.rglob("*.xlsx"):
        if fp.name.startswith("~$") or fp.name.startswith("_"):
            continue
        rel = fp.relative_to(base_dir)
        if len(rel.parts) == 1:  # 扁平：直接在 base_dir 下
            keys.add(_table_prefix(fp.stem))
        else:  # 嵌套：相对父路径 + _table_prefix(leaf)（剥版本后缀）
            parent_rel = rel.parent.as_posix()
            key_leaf = _table_prefix(fp.stem)
            keys.add(f"{parent_rel}/{key_leaf}")
    return keys


def _bp_cached(path: str, bp_cache: Optional[Dict[str, dict]] = None) -> dict:
    """请求级缓存 _resolve_branch_point 结果（M9）：同一次 compare 内 src_dir 不变，
    N 张表原会触发 N 次 svn log --stop-on-copy。传入 bp_cache 复用首次结果，N 次 → 1 次。
    """
    if bp_cache is not None and path in bp_cache:
        return bp_cache[path]
    result = _resolve_branch_point(path=path)
    if bp_cache is not None:
        bp_cache[path] = result
    return result


def _prepare_base_export_subdir(src_dir: Path, tgt_dir: Path, base_rev: Optional[int],
                                 tmp: Path, bp_cache: Dict[str, dict]) -> Optional[Path]:
    """一次性 svn export 整个 target_dir@rev 到本地，供 N 张表从本地拷贝 base。

    base_rev 指定时取 base_rev；否则反查 source 子目录 copyfrom_rev。子目录合并是单源 fork，
    base = target_dir @ copyfrom_rev。导出失败返回 None（回退 per-table svn cat）。

    inferred（子目录随父提交一起创建，copyfrom_rev=首次rev-1）：该 rev 时父目录文件可能
    尚不存在（如 subdev_1 与 trunk 文件在 r2 同时创建，r1 时 trunk 无文件），导出空目录会导致
    三方 base 全空→所有行误判 inserted。故 inferred 时优先用 log_entry.rev（首次提交 rev 本身，
    子目录继承的是父在该 rev 的内容），svn export 失败再回退 copyfrom_rev。
    """
    rev = base_rev
    bp = None
    if rev is None:
        bp = _bp_cached(str(src_dir), bp_cache)
        if bp.get("ok"):
            if bp.get("inferred") and bp.get("log_entry", {}).get("rev"):
                rev = bp["log_entry"]["rev"]
            else:
                rev = bp.get("copyfrom_rev")
    if rev is None:
        return None
    dest = tmp / f"base_export_r{rev}"
    if _svn_export_dir(tgt_dir, rev, dest):
        return dest
    # inferred 场景：log_entry.rev 导出失败（文件可能更晚才加入），回退 copyfrom_rev
    if bp and bp.get("ok") and rev != bp.get("copyfrom_rev"):
        rev2 = bp.get("copyfrom_rev")
        if rev2 is not None:
            dest2 = tmp / f"base_export_r{rev2}"
            if _svn_export_dir(tgt_dir, rev2, dest2):
                return dest2
    return None


def _resolve_base_for_subdir(src_dir: Path, tgt_dir: Path, group_name: str,
                             override: Optional[str], tmp: Path,
                             bp_cache: Optional[Dict[str, dict]] = None,
                             base_rev: Optional[int] = None,
                             base_export_dir: Optional[Path] = None) -> Path:
    """定位 source/target 的 merge-base 文件：子目录创建时刻继承的 target 版本。

    优先级：merge_base_override > base_export_dir 批量导出 > SVN 真实反查 svn cat。

    SVN 真实模式：base_rev 指定时直接 svn cat -r base_rev 取 target_dir/<group> 作 base
    （不查 copyfrom）；否则反查 source_dir（子目录）的 copyfrom/首次提交版本号 N，取 target_dir/<group>
    @ N 作 base。子目录合回 trunk 是单源 fork，单侧 copyfrom 即 base，不需双方 LCA。

    base_export_dir（批量导出优化）：subdir_compare 入口已一次性 svn export 整个 target_dir@rev
    到本地，本函数优先从该目录拷贝 {group}.xlsx，跳过 per-table svn cat。

    group_name 支持嵌套相对路径（如 'config/balance/skill'）：base 文件取目标 HEAD（_sN
    最大版本），tmp 内中间文件名用扁平化片段避免子目录问题。
    """
    flat = _flat_group_name(group_name)
    if override:
        base_src = _resolve_branch_path(override)
        if not base_src.is_file():
            raise HTTPException(400, f"merge_base_override 文件不存在: {base_src}")
        base_path = tmp / f"{flat}_base.xlsx"
        shutil.copy2(base_src, base_path)
        return base_path

    def _base_from_export(rev: int) -> Optional[Path]:
        """从批量导出的 base_export_dir 取本地 target 文件，失败返回 None 回退 svn cat。"""
        if base_export_dir is None:
            return None
        local = _target_head_file(base_export_dir, group_name)
        if local is None or not local.is_file():
            return None
        dest = tmp / f"{flat}_base_r{rev}.xlsx"
        try:
            shutil.copy2(local, dest)
            return dest
        except OSError:
            return None

    # 1a. base_rev 显式指定 → 直接 svn cat -r base_rev 取 target_dir/<group> 作 base
    if base_rev is not None:
        cached = _base_from_export(base_rev)
        if cached is not None:
            return cached
        base_wc = _target_head_file(tgt_dir, group_name)
        if base_wc is None:
            raise HTTPException(400, f"target_dir 下未找到 {group_name} 目标文件")
        base_path = tmp / f"{flat}_base_r{base_rev}.xlsx"
        try:
            _svn_cat(base_wc, base_rev, base_path)
            return base_path
        except HTTPException:
            pass  # svn cat 失败，回退到自动推断 rev（r1 等空仓库 rev 无文件）
    # 1b. 自动反查 source_dir（子目录）派生点，取 target_dir @ copyfrom_rev
    bp = _bp_cached(str(src_dir), bp_cache)
    if bp.get("ok"):
        # inferred（子目录随父提交一起创建，无独立 copyfrom）：copyfrom_rev=首次rev-1，
        # 但该 rev 时父目录文件可能尚不存在（如 subdev_1 与 trunk 文件在 r2 同时创建，
        # r1 时 trunk 无文件）。此时 base 应取首次提交 rev 本身（子目录继承的是父在该 rev
        # 的内容），故 inferred 时优先用 log_entry.rev，svn cat 失败再回退 copyfrom_rev。
        if bp.get("inferred") and bp.get("log_entry", {}).get("rev"):
            use_rev = bp["log_entry"]["rev"]
        else:
            use_rev = bp["copyfrom_rev"]
        cached = _base_from_export(use_rev)
        if cached is not None:
            return cached
        base_wc = _target_head_file(tgt_dir, group_name)
        if base_wc is None:
            raise HTTPException(400, f"target_dir 下未找到 {group_name} 目标文件")
        base_path = tmp / f"{flat}_base_r{use_rev}.xlsx"
        try:
            _svn_cat(base_wc, use_rev, base_path)
            return base_path
        except HTTPException:
            pass  # svn cat 失败，尝试回退 rev
        if use_rev != bp["copyfrom_rev"]:
            # inferred 场景：首次提交 rev 失败，回退 copyfrom_rev（rev-1）重试
            cached2 = _base_from_export(bp["copyfrom_rev"])
            if cached2 is not None:
                return cached2
            try:
                _svn_cat(base_wc, bp["copyfrom_rev"], base_path)
                return base_path
            except HTTPException:
                pass  # svn cat 失败
    raise HTTPException(
        400,
        f"无法自动定位 merge-base（SVN 反查失败：{bp.get('message', 'svn 不可用')}），"
        f"请通过 merge_base_override 手工指定基准"
    )


def _compare_one_table(src_dir: Path, tgt_dir: Path, group_name: str,
                       override: Optional[str], tmp: Path,
                       bp_cache: Optional[Dict[str, dict]] = None,
                       source_rev: Optional[int] = None,
                       base_rev: Optional[int] = None,
                       rev_cache: Optional[Dict[str, tuple]] = None,
                       base_export_dir: Optional[Path] = None) -> FileGroup:
    """单个表的多方比对，返回 FileGroup。

    SVN 真实模式：base=svn cat -r N（base_rev 指定或 source copyfrom 反查），source=子目录文件
    （source_rev 指定时 svn cat -r rev 取历史版本），target=目标工作副本文件。
    提交作者 + rev/date 由 svn log 取，触发"同作者自动合并"（与模式一一致）。
    """
    src_files = _list_branch_files(src_dir, group_name)
    if not src_files:
        raise HTTPException(400, f"源子目录 {src_dir.name} 下未找到 {group_name} 文件")

    flat = _flat_group_name(group_name)
    leaf = group_name.rsplit("/", 1)[-1]

    # 目标侧文件：SVN 模式取工作副本文件
    tgt_files = _list_branch_files(tgt_dir, group_name)
    if not tgt_files:
        raise HTTPException(400, f"目标目录 {tgt_dir.name} 下未找到 {group_name} 文件")

    base_path = _resolve_base_for_subdir(
        src_dir, tgt_dir, group_name, override, tmp, bp_cache,
        base_rev=base_rev, base_export_dir=base_export_dir)
    base_name = base_path.name
    paths: List[str] = [str(base_path)]
    commit_authors: Dict[str, str] = {}
    version_meta: Dict[str, Dict[str, Any]] = {}

    # base 版本元信息：从 base 文件名 _base_r<rev>.xlsx 解析 copyfrom_rev
    m = re.search(r"_base_r(\d+)\.xlsx$", base_name)
    if m:
        version_meta[base_name] = {"rev": _fmt_rev(m.group(1)), "author": "", "date": ""}

    for tag, files in (("src", src_files), ("tgt", tgt_files)):
        rev = source_rev if tag == "src" else None
        for fp in files:
            stem = fp.stem
            if stem.startswith(leaf):
                suffix = stem[len(leaf):].lstrip("_")
                new_name = (f"{flat}_{tag}_{suffix}.xlsx" if suffix
                            else f"{flat}_{tag}.xlsx")
            else:
                new_name = f"{stem}_{tag}.xlsx"
            dest = tmp / new_name
            if rev is not None and tag == "src":
                # SVN 真实模式 + source_rev 指定：svn cat -r rev 取历史版本
                _svn_cat(fp, rev, dest)
            else:
                shutil.copy2(fp, dest)
            paths.append(str(dest))
            # SVN：按 svn log 取提交作者 + rev/date（复用 rev_cache 避免重复 subprocess）
            if rev is not None and tag == "src":
                _, author, date = _rev_info_cached(fp, rev_cache)
                version_meta[new_name] = {"rev": _fmt_rev(rev), "author": author, "date": date}
                commit_authors[new_name] = author
            else:
                info = _latest_revision_info(fp, rev_cache)
                version_meta[new_name] = info
                commit_authors[new_name] = info.get("author", "")

    # demo_svn 单用户演示仓库禁用同作者合并（同 author，否则双方改动互相吸收看不到冲突）
    use_authors = commit_authors
    if "demo_svn" in str(src_dir) or "demo_svn" in str(tgt_dir):
        use_authors = {}
    return _build_group(
        paths,
        base_name=base_name,
        group_name=group_name,
        merge_base_file=base_name,
        commit_authors=use_authors,
        version_meta=version_meta,
    )


def _compare_one_table_proc(group_name, src_dir, tgt_dir, override, tmp,
                            bp_cache, source_rev, base_rev, rev_cache, base_export_dir):
    """#32 ProcessPool worker：单表 compare 全在子进程跑。module-level 保 pickle。
    与 merge_branch 同构，仅无 target_rev（子目录模式单方向）。"""
    return group_name, _compare_one_table(
        src_dir, tgt_dir, group_name, override, tmp, bp_cache,
        source_rev=source_rev, base_rev=base_rev,
        rev_cache=rev_cache, base_export_dir=base_export_dir)


class SubdirCompareRequest(BaseModel):
    source_dir: str                            # 私有开发子目录（相对 MERGE_DIR 的 SVN 工作副本路径）
    target_dir: str                            # 合回目标目录（一般 trunk）
    group_names: Optional[List[str]] = None    # 要比对的表名，None=自动取两目录交集全部比对
    merge_base_override: Optional[str] = None  # 基准文件路径，覆盖自动反查
    source_rev: Optional[int] = None          # source 子目录指定 SVN revision（None=HEAD）
    base_rev: Optional[int] = None            # 共同祖先 base 指定 revision（None=自动反查 source copyfrom）


def subdir_compare(req: SubdirCompareRequest):
    """同分支子目录三方对比：base(子目录创建时刻 target 快照) + source(子目录 HEAD) + target(Y 目录 HEAD)。

    一次性比对多个表（group_names 为空时自动取两目录交集全部表），返回 CompareResponse.groups。
    structural_changes 暂不计算（与模式一一致）。HTTP 入口见 subdir_compare_http（手动序列化绕开慢编码器）。
    """
    src_dir = _resolve_demo_or_wc(req.source_dir)
    tgt_dir = _resolve_demo_or_wc(req.target_dir)
    if not src_dir.is_dir() or not tgt_dir.is_dir():
        raise HTTPException(400, "source_dir / target_dir 必须为目录")
    if src_dir == tgt_dir:
        raise HTTPException(400, "source_dir 与 target_dir 不能相同")

    if req.group_names:
        table_names = req.group_names
    else:
        src_tables = _collect_subdir_table_keys(src_dir)
        tgt_tables = _collect_subdir_table_keys(tgt_dir)
        table_names = sorted(src_tables & tgt_tables)
    if not table_names:
        raise HTTPException(400, "两目录无交集表名，无法比对")

    tmp = Path(tempfile.mkdtemp(prefix="merge_subdir_"))
    try:
        groups = {}
        bp_cache: Dict[str, dict] = {}  # M9: 复用 svn log 结果，避免每表重复反查
        rev_cache: Dict[str, tuple] = {}  # 复用 svn log -l 1 的 (rev,author,date)
        # base 批量导出优化：一次性 svn export 整个 target_dir@rev，N 张表从本地拷贝，
        # 避免 N 次 per-table svn cat。失败回退 per-table svn cat。
        base_export_dir: Optional[Path] = None
        if not req.merge_base_override:
            try:
                base_export_dir = _prepare_base_export_subdir(
                    src_dir, tgt_dir, req.base_rev, tmp, bp_cache)
            except Exception:
                base_export_dir = None
        # 预填充 bp_cache：src/tgt 两目录 branch_point 各跑一次 svn log，避免表级并行时
        # N 表并发各跑一次（重复 subprocess）。
        _bp_cached(str(src_dir), bp_cache)
        _bp_cached(str(tgt_dir), bp_cache)
        # 批量预填充 rev_cache：一次 svn info -R 取 src/tgt 目录所有文件 (rev,author,date)，
        # 替代 N 表×多文件逐个 svn log -l 1。_rev_info_cached 命中后跳过 subprocess。
        _prefill_rev_cache(src_dir, rev_cache)
        _prefill_rev_cache(tgt_dir, rev_cache)

        # 表级并行：_compare_one_table 内部 read_group_files(lxml 释放 GIL) + svn subprocess
        # 均释放 GIL，多表并发压缩总耗时（N 表串行 → 并行）。rev_cache 多线程重复 miss
        # 只产生冗余 svn log（结果一致），不破坏正确性。
        # #32: 表数 >= 4 时切 ProcessPool（compare_sheet 真并行），失败回退 ThreadPool。
        _table_worker = partial(
            _compare_one_table_proc,
            src_dir=src_dir, tgt_dir=tgt_dir, override=req.merge_base_override,
            tmp=tmp, bp_cache=bp_cache, source_rev=req.source_rev,
            base_rev=req.base_rev, rev_cache=rev_cache, base_export_dir=base_export_dir)
        for gn, fg in parallel_map_tables(_table_worker, table_names):
            groups[gn] = fg
        # 结构增删标注：base/src/tgt 三方 {group: set(sheet)} 对比
        try:
            base_sheets = _dir_sheet_sets(base_export_dir) if base_export_dir else {}
            src_sheets = _dir_sheet_sets(src_dir)
            tgt_sheets = _dir_sheet_sets(tgt_dir)
            # 子目录模式：src 只含其开发的表，"in_base 且仅 tgt 有"（目标既有表）
            # 不算删除（out of scope）。src_scope_only=True 跳过 source_deleted/both_deleted，
            # 否则会把 trunk 有而子目录没有的表全误报为删除（实测 69 假 source_deleted）。
            structural = compute_structural_changes(
                base_sheets, src_sheets, tgt_sheets, src_scope_only=True)
        except Exception:
            structural = []
        return CompareResponse(
            groups=groups,
            session_id="",
            conflict_origin="subdir",
            structural_changes=structural,
        )
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


@router.post("/compare")
async def subdir_compare_http(req: SubdirCompareRequest):
    """HTTP 入口：大响应（10w 行级）手动序列化——FastAPI jsonable_encoder 对嵌套
    CellData 模型逐字段编码 ~5s/50MB，model_dump_json 仅 ~0.3s，故绕开编码器。
    内部 subdir_compare 仍返回 CompareResponse（供测试/复用直接调用）。

    异步化 + 全链路异常捕获：避免同步函数内未处理异常导致空 body 引发前端
    "Unexpected end of JSON input"。
    """
    import asyncio
    import traceback as _tb
    try:
        result = await asyncio.to_thread(subdir_compare, req)
    except HTTPException:
        raise
    except Exception as e:
        _tb.print_exc()
        raise HTTPException(500, f"比对内部错误：{e}")

    try:
        content = result.model_dump_json()
    except Exception as e:
        _tb.print_exc()
        raise HTTPException(500, f"序列化响应失败（数据量可能过大，请尝试缩小目录范围）：{e}")

    return Response(content=content, media_type="application/json")


def _sheet_names(fp: Path) -> set:
    """读 xlsx 的 sheet 名集合（轻量读取）。

    优先 python-calamine（Rust，解析 10w 行文件 <0.1s，openpyxl read_only 需 0.3-0.5s/文件），
    不可用时回退 openpyxl。read_only 工作簿持有文件句柄直至 close()——漏关会锁死 Windows 上
    被扫描的 demo 文件（如 demo 快照重建时 rmtree 报 WinError 32），故回退路径必须显式关闭。
    """
    try:
        from python_calamine import CalamineWorkbook
        return set(CalamineWorkbook.from_path(fp).sheet_names)
    except Exception:
        pass
    wb = None
    try:
        wb = load_workbook(fp, read_only=True, data_only=True)
        return set(wb.sheetnames)
    except Exception:
        return set()
    finally:
        if wb is not None:
            wb.close()


def _under_nested_snapshot(fp: Path, base_dir: Path) -> bool:
    """fp 是否位于 base_dir 内某个嵌套 demo 快照目录下（该目录含 _meta.json）。

    目标目录含私有子目录（demo 快照，如 trunk_r4/subdir_copied）时，子目录内的 xlsx
    不应计为目标目录自身的内容（否则会被误判 target_added）。
    """
    try:
        rel = fp.relative_to(base_dir.resolve())
    except (ValueError, OSError):
        return False
    for part in rel.parent.parts:
        if (base_dir / part / "_meta.json").is_file():
            return True
    return False


def _collect_subdir_table_keys_with_sheets(base_dir: Path, skip_nested_snaps: bool = False) -> Dict[str, set]:
    """收集目录下 {table_key: {sheet_names}}（支持嵌套相对路径 key）。

    嵌套表 key 为相对路径 posix（如 'config/skill'）；扁平表 key 用 _table_prefix 裂版本后缀。
    同一 key 多文件（如 match_stat_s1/s2 或 match_stat_1/2）合并 sheet 名集合。
    skip_nested_snaps=True 时跳过位于嵌套 demo 快照目录（含 _meta.json）内的文件。
    """
    out: Dict[str, set] = {}
    if not base_dir.is_dir():
        return out
    for p in base_dir.rglob("*.xlsx"):
        if p.name.startswith("~$") or p.name.startswith("_"):
            continue
        if skip_nested_snaps and _under_nested_snapshot(p, base_dir):
            continue
        rel = p.relative_to(base_dir)
        if len(rel.parts) == 1:
            key = _table_prefix(p.stem)
        else:
            parent_rel = rel.parent.as_posix()
            key = f"{parent_rel}/{_table_prefix(p.stem)}"
        out.setdefault(key, set()).update(_sheet_names(p))
    return out


def _subdir_display_file(src_dir: Path, tgt_dir: Path, group: str, base_suffix: str, status: str) -> Optional[Path]:
    """结构增删展示内容来源：新增/删除方取尚存一侧的文件（支持嵌套相对路径 group）。

    source_added/target_deleted → 源子目录 HEAD（提交后缀 _N 最大者）；target_added/source_deleted → 目标 HEAD；
    both_deleted 子目录模式不出现。
    """
    if status in ("source_added", "target_deleted"):
        return _src_head_file(src_dir, group)
    if status in ("target_added", "source_deleted"):
        return _target_head_file(tgt_dir, group)
    return None


def _attach_display_entries(groups: dict, structural: list, src_dir: Path, tgt_dir: Path, base_suffix: str) -> None:
    """把"仅一侧存在"的表/sheet 以只读展示分组挂进 groups，前端可直接点击查看内容。

    - 表级：source_added/target_added 等不在 groups 内的表 → 构建单侧展示 FileGroup 追加。
    - sheet 级：common/both_added 表内仅一侧有的 sheet → 构建单侧展示 SheetDiff 补进该表。
    both_added（双方各新增，有真实比对数据）跳过；both_deleted 子目录模式不出现。
    """
    from engine.parser import read_excel
    for c in structural:
        if c["status"] in ("common", "both_added"):
            continue
        fp = _subdir_display_file(src_dir, tgt_dir, c["table"], base_suffix, c["status"])
        if fp is None:
            continue
        if c["kind"] == "table":
            if c["table"] not in groups:
                groups[c["table"]] = build_display_group(c["table"], fp, c["status"], c["origin"])
        else:
            g = groups.get(c["table"])
            if g is None or c["sheet"] in g.sheets:
                continue
            rows = read_excel(str(fp)).get(c["sheet"])
            if rows is not None:
                g.sheets[c["sheet"]] = build_display_sheet(fp, c["sheet"], rows, c["status"], c["origin"])


def _src_head_file(src_dir: Path, group: str) -> Optional[Path]:
    """源子目录 HEAD 文件：提交后缀 _N 最大者（如 match_stat_3）；无则规范名 {group}.xlsx。

    支持嵌套 group（如 'config/skill'）：按相对路径定位子目录，在子目录内找 _N 变体或规范名。
    """
    is_nested = "/" in group or "\\" in group
    leaf = group.rsplit("/", 1)[-1]
    if is_nested:
        parts = group.replace("\\", "/").split("/")
        sub_dir = src_dir.joinpath(*parts[:-1])
    else:
        sub_dir = src_dir
    if not sub_dir.is_dir():
        return None
    v_versions = []
    for p in sub_dir.glob("*.xlsx"):
        if p.name.startswith("~$") or p.name.startswith("_"):
            continue
        m = re.match(rf"^{re.escape(leaf)}_(\d+)$", p.stem)
        if m:
            v_versions.append((int(m.group(1)), p))
    if v_versions:
        return max(v_versions, key=lambda x: x[0])[1]
    canonical = sub_dir / f"{leaf}.xlsx"
    return canonical if canonical.is_file() else None


def _target_head_file(tgt_dir: Path, group: str) -> Optional[Path]:
    """目标 HEAD 文件：时间点后缀 _sN 最大者（如 match_stat_s2）；无则规范名 {group}.xlsx。

    支持嵌套 group（如 'config/skill'）：按相对路径定位子目录，在子目录内找 _sN 变体或规范名。
    """
    is_nested = "/" in group or "\\" in group
    leaf = group.rsplit("/", 1)[-1]
    if is_nested:
        parts = group.replace("\\", "/").split("/")
        sub_dir = tgt_dir.joinpath(*parts[:-1])
    else:
        sub_dir = tgt_dir
    if not sub_dir.is_dir():
        return None
    s_versions = []
    for p in sub_dir.glob("*.xlsx"):
        if p.name.startswith("~$") or p.name.startswith("_"):
            continue
        m = re.match(rf"^{re.escape(leaf)}_s(\d+)$", p.stem)
        if m:
            s_versions.append((int(m.group(1)), p))
    if s_versions:
        return max(s_versions, key=lambda x: x[0])[1]
    canonical = sub_dir / f"{leaf}.xlsx"
    return canonical if canonical.is_file() else None


def _next_target_version_name(tgt_dir: Path, group: str) -> str:
    """下一个版本名：有 _sN 时间点后缀则 _s{max+1}（s2→s3）；否则回退数值 {leaf}_{N+1}.xlsx。

    支持嵌套 group：在 group 所在子目录内扫描版本号；返回纯文件名（不含路径）。
    """
    is_nested = "/" in group or "\\" in group
    leaf = group.rsplit("/", 1)[-1]
    if is_nested:
        parts = group.replace("\\", "/").split("/")
        sub_dir = tgt_dir.joinpath(*parts[:-1])
    else:
        sub_dir = tgt_dir
    s_versions = []
    if sub_dir.is_dir():
        for p in sub_dir.glob("*.xlsx"):
            if p.name.startswith("~$") or p.name.startswith("_"):
                continue
            m = re.match(rf"^{re.escape(leaf)}_s(\d+)$", p.stem)
            if m:
                s_versions.append(int(m.group(1)))
    if s_versions:
        return f"{leaf}_s{max(s_versions) + 1}.xlsx"
    return get_next_merge_version(sub_dir, leaf)


def _rollback_written(written: List[Tuple[Path, Optional[Path]]]) -> None:
    """apply 失败时按写入记账还原 target 目录：已存在的文件恢复备份，新建的文件删除。

    written 元素为 (dest, backup)：backup 非空表示该 dest 在本次写入前已存在，
    需用备份覆盖回原文件；backup 为空表示本次新建，删除即可避免残留半成品。
    """
    for dest, backup in written:
        try:
            if backup is not None and backup.is_file():
                shutil.copy2(backup, dest)
            elif dest.exists():
                dest.unlink()
        except OSError:
            pass


class SubdirApplyRequest(BaseModel):
    """subdir apply 请求：多表批量应用。"""
    source_dir: str
    target_dir: str
    tables: List[TableApplyItem]
    apply_mode: str = "new_version"   # "new_version"(产生新版本 s{N+1}) | "overwrite"(覆盖目标最新)
    merge_base_override: Optional[str] = None
    commit_name: str = ""             # 本次合并的提交名称（可空，审计/历史记录展示用）
    source_rev: Optional[int] = None  # source 子目录指定 SVN revision（None=HEAD）；与 compare 保持一致
    base_rev: Optional[int] = None    # 共同祖先 base 指定 revision（None=自动反查）；与 compare 保持一致


@router.post("/apply")
def subdir_apply(req: SubdirApplyRequest):
    """应用人工解决结果（多表批量），写回 target_dir。

    apply_mode：
      - "overwrite"：覆盖目标最新表格（dest = 目标 HEAD 同名，内容为合并结果）
      - "new_version"（默认）：产生新版本（dest = {group}_s{N+1}.xlsx，迭代次数+1）
    ours = 目标 HEAD；未决冲突阻断写回；审计 mode 标注 overwrite / new_version。
    """
    src_dir = _resolve_demo_or_wc(req.source_dir)
    tgt_dir = _resolve_demo_or_wc(req.target_dir)
    if not src_dir.is_dir() or not tgt_dir.is_dir():
        raise HTTPException(400, "source_dir / target_dir 必须为目录")
    if req.apply_mode not in ("overwrite", "new_version"):
        raise HTTPException(400, "apply_mode 必须为 overwrite 或 new_version")

    from engine.models import MergeRequest as _MR

    # 1) 预检查：全部表格零未决冲突才继续
    mrs = {}
    for item in req.tables:
        mr = _MR(group_name=item.group_name, sheets=item.sheets)
        unresolved = _unresolved_conflicts(mr)
        if unresolved:
            raise HTTPException(
                400,
                f"表 {item.group_name} 存在 {len(unresolved)} 处未决冲突："
                + json.dumps(unresolved, ensure_ascii=False),
            )
        mrs[item.group_name] = mr

    results = []
    audit_tables = []          # 一次合并（多表）只写一条审计记录，表级明细收进 tables
    tmp = Path(tempfile.mkdtemp(prefix="merge_subdir_apply_"))
    # 回滚记账：记录每张表写入前 dest 的存在性与备份路径，失败时还原 target_dir 状态
    written: List[Tuple[Path, Optional[Path]]] = []
    try:
        for item in req.tables:
            mr = mrs[item.group_name]

            head = _target_head_file(tgt_dir, item.group_name)
            if head is None:
                raise HTTPException(400, f"target_dir 下未找到 {item.group_name} 目标文件")
            ours_path = head
            # 嵌套表：dest_dir 到 group_name 所在子目录；扁平表 dest_dir = tgt_dir
            gn = item.group_name
            if "/" in gn or "\\" in gn:
                parts = gn.replace("\\", "/").split("/")[:-1]
                dest_dir = (tgt_dir.joinpath(*parts)).resolve()
            else:
                dest_dir = tgt_dir
            if req.apply_mode == "overwrite":
                dest_name = head.name                 # 覆盖目标最新（同名）
                mode_tag = "subdir_overwrite"
            else:
                dest_name = _next_target_version_name(tgt_dir, item.group_name)  # 新版本 s{N+1}
                mode_tag = "subdir_new_version"
            dest_dir.mkdir(parents=True, exist_ok=True)
            dest = dest_dir / dest_name

            # 写入前预记账：dest 已存在则备份到 tmp，便于失败时恢复原文件
            backup: Optional[Path] = None
            if dest.exists() and dest.is_file():
                backup = tmp / f"{item.group_name}_backup_{dest_name}"
                shutil.copy2(dest, backup)
            written.append((dest, backup))

            cache_info = _apply_edits_and_save(ours_path, dest, mr)
            # 前端只传差异行，跨表主键集合以落盘表为准（calamine 快读）
            ref_report = _validate_apply_refs(mr, extra_pks=collect_disk_sheet_pks(ours_path))

            stats = _sheets_stats(item.sheets)
            changes, truncated = _collect_changes(item.sheets, ours_path.name)
            audit_tables.append({
                "group": item.group_name,
                "base": ours_path.name,
                "output": dest_name,
                "stats": stats,
                "changes": changes,
                "changes_truncated": truncated,
                "cache_message": cache_info["cache_message"],
            })

            results.append({
                "group": item.group_name,
                "ok": True,
                "output": dest_name,
                "path": str(dest),
                "apply_mode": req.apply_mode,
                "needs_manual_fix": cache_info["needs_manual_fix"],
                "cache_message": cache_info["cache_message"],
                "ref_integrity": ref_report,
            })

        # 一次合并一条审计记录（多表明细收进 tables；group/output 汇总供列表展示）
        _append_audit({
            "time": datetime.now().isoformat(timespec="seconds"),
            "mode": "subdir_overwrite" if req.apply_mode == "overwrite" else "subdir_new_version",
            "source_dir": req.source_dir,
            "target_dir": req.target_dir,
            "commit_name": req.commit_name,
            "group": ", ".join(t["group"] for t in audit_tables),
            "output": ", ".join(t["output"] for t in audit_tables),
            "tables": audit_tables,
        })

        invalidate_dirs_cache()
        return {
            "ok": True,
            "results": results,
            "ref_warning": "；".join(r["ref_integrity"]["warning"] for r in results if r["ref_integrity"]["warning"]),
        }
    except HTTPException:
        _rollback_written(written)
        raise
    except Exception as e:
        _rollback_written(written)
        raise HTTPException(500, f"应用合并失败：{e}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
