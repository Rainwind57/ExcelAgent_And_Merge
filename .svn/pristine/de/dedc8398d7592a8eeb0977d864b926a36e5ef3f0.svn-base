"""构造 P0 验证样本：
1. 三张公式表（match_dan 等价物，多方验证公式缓存修复）
2. id_mgr.xlsx（基于 resources 实际 id 分布构造编号段表）
3. merge 漏行样本（补 ability/item 漏行场景，现有 merge 只有新增无漏行）

写表铁律：load_workbook → 改单元格 → save，禁用 Workbook() 重建。
公式注入：直接 cell.value = "=..." 写公式文本，缓存值靠后续 libreoffice 重算补。
"""
import openpyxl
from openpyxl.utils import get_column_letter
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[2]
RES = ROOT / "resources"
MERGE = ROOT / "merge"
TEST_RES = RES / "qa_test" / "formula_samples"
TEST_RES.mkdir(parents=True, exist_ok=True)


# ============================================================
# 1. 三张公式表（match_dan.xlsx 等价物）
# ============================================================
def build_formula_tables():
    """构造三张含公式的表，模拟 match_dan.xlsx 公式缓存问题。

    表1 formula_basic.xlsx: 基础算术公式（SUM/+-*/），单 sheet
    表2 formula_lookup.xlsx: VLOOKUP 跨表引用公式，双 sheet（主表+查表）
    表3 formula_nested.xlsx: 嵌套 IF + 文本拼接，模拟复杂业务公式
    """
    # ---- 表1 基础算术 ----
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "DanConfig"
    # 表头（第1行中文，第2行字段定义）
    ws.append(["段位编号", "段位名称", "基础分", "难度系数", "最终分数"])
    ws.append(["dan_id:int", "dan_name:string", "base_score:int", "diff_coef:float", "final_score:int"])
    # 数据：10 行
    for i in range(1, 11):
        base = i * 100
        coef = 1 + i * 0.1
        ws.append([i, f"测试段位{i}", base, coef, f"=C{2+i}*D{2+i}"])  # final = base * coef
    wb.save(TEST_RES / "formula_basic.xlsx")
    wb.close()

    # ---- 表2 VLOOKUP 跨 sheet 引用 ----
    wb = openpyxl.Workbook()
    ws_main = wb.active
    ws_main.title = "MatchDan"
    ws_ref = wb.create_sheet("DanRef")
    # 参考表
    ws_ref.append(["dan_id", "dan_name", "base_score"])
    ws_ref.append(["int", "string", "int"])
    for i in range(1, 11):
        ws_ref.append([i, f"参考段位{i}", i * 100])
    # 主表
    ws_main.append(["match_id", "player_dan", "dan_name_vlookup", "score_lookup"])
    ws_main.append(["match_id:int", "player_dan:int", "dan_name:string", "score:int"])
    for i in range(1, 11):
        ws_main.append([1000 + i, i, f"=VLOOKUP(B{2+i},DanRef!A:C,2,FALSE)", f"=VLOOKUP(B{2+i},DanRef!A:C,3,FALSE)"])
    wb.save(TEST_RES / "formula_lookup.xlsx")
    wb.close()

    # ---- 表3 嵌套 IF + 文本拼接 ----
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "RewardCalc"
    ws.append(["奖励编号", "段位", "胜场", "败场", "总场数", "胜率", "奖励等级"])
    ws.append(["reward_id:int", "dan:int", "win:int", "lose:int", "total:int", "win_rate:float", "reward_tier:int"])
    for i in range(1, 16):
        win = i * 2
        lose = i
        # total = win+lose, win_rate = win/total, reward_tier = IF(win_rate>0.8, 3, IF(>0.5,2,1))
        r = 2 + i
        ws.append([
            i, i, win, lose,
            f"=C{r}+D{r}",  # total = win+lose，引用 E 列自身？不对，total 在 E 列
            f"=IF(E{r}=0,0,C{r}/E{r})",  # win_rate = win/total（E 列）
            f'=IF(E{r}=0,1,IF(C{r}/E{r}>0.8,3,IF(C{r}/E{r}>0.5,2,1)))',  # reward_tier 嵌套 IF
        ])
    wb.save(TEST_RES / "formula_nested.xlsx")
    wb.close()

    # ---- 表4 SUM 聚合计算 ----
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "SeasonStat"
    ws.append(["赛季编号", "场次1", "场次2", "场次3", "场次4", "总场次", "平均场次", "最高单场"])
    ws.append(["season_id:int", "c1:int", "c2:int", "c3:int", "c4:int", "total:int", "avg:float", "max:int"])
    for i in range(1, 13):
        r = 2 + i
        c1, c2, c3, c4 = i * 10, i * 10 + 5, i * 10 + 3, i * 10 + 8
        ws.append([
            i, c1, c2, c3, c4,
            f"=SUM(B{r}:E{r})",  # 总场次 = 4 场求和
            f"=AVERAGE(B{r}:E{r})",  # 平均场次
            f"=MAX(B{r}:E{r})",  # 最高单场
        ])
    # 末行加跨行 SUM（模拟汇总行）
    last = 14
    ws.append([99, "", "", "", "", f"=SUM(F3:F{last})", f"=AVERAGE(F3:F{last})", f"=MAX(F3:F{last})"])
    wb.save(TEST_RES / "formula_sum.xlsx")
    wb.close()
    print(f"[OK] 四张公式表 -> {TEST_RES}/formula_*.xlsx")


# ============================================================
# 2. id_mgr.xlsx（基于 resources 实际 id 分布）
# ============================================================
def build_id_mgr():
    """构造 id_mgr.xlsx，4 sheet：说明/CONFIG/SETTING/各模块编号占段表。
    占段表按 resources 扫描结果填充，预留段 + 已用段。
    """
    out = RES / "id_mgr.xlsx"
    wb = openpyxl.Workbook()

    # sheet1 说明
    ws = wb.active
    ws.title = "说明"
    ws["A1"] = "ID 编号管理总表（模拟 ca/id_mgr.xlsm）"
    ws["A2"] = "用途：人工维护各模块 ID 占段，新系统可程序化读取校验"
    ws["A3"] = "整理日期: 2026-07-15"
    ws["A4"] = "数据来源: resources/ 实际扫描"

    # sheet2 CONFIG（编表配置，仿真实表）
    ws2 = wb.create_sheet("CONFIG")
    ws2.append(["表名", "ID编号管理总表"])
    ws2.append(["说明", "各模块编号占段表"])
    ws2.append(["额外配置", 0, "", "", ""])
    ws2.append(["生成文件数量", 1])
    ws2.append(["生成文件1", "id_mgr.pat", "SHEET_GEN", "utf-8", "id_mgr"])
    ws2.append(["表单配置", "ALL_SHEETS", 1])
    ws2.append(["列配置", "module", "TEXT", "NOT_EMPTY"])
    ws2.append(["", "id_min", "INT", "NOT_EMPTY"])
    ws2.append(["", "id_max", "INT", "NOT_EMPTY"])
    ws2.append(["", "used_min", "INT"])
    ws2.append(["", "used_max", "INT"])
    ws2.append(["", "status", "TEXT"])

    # sheet3 SETTING（占段表，核心数据）
    ws3 = wb.create_sheet("SETTING")
    # 表头
    ws3.append(["模块", "编号下限", "编号上限", "已用下限", "已用上限", "状态"])
    # 基于 resources 扫描结果构造占段
    segments = [
        # (模块, min, max, used_min, used_max, 状态)
        ("item.ItemBase", 10000, 29999, 10001, 28650, "正常"),
        ("item.Chest", 11000, 11999, 11001, 11015, "正常"),
        ("item.Potion", 12000, 12999, 12000, 12993, "正常"),
        ("item.Gem", 13000, 13999, 13000, 13089, "正常"),
        ("item.Equipment", 15000, 19999, 15001, 15090, "正常"),
        ("item.Fabao", 28500, 29999, 28501, 28650, "正常"),
        ("pet.Pet", 3000, 3999, 1052, 3065, "越界"),  # 故意越界测校验
        ("pet.PetSpellBook", 21000, 21999, 21000, 21128, "正常"),
        ("hero.Hero", 5000, 5999, 5022, 8002, "越界"),
        ("quest.Quest", 250000, 259999, 250001, 259005, "正常"),
        ("mail.MailTemplate", 10000, 39999, 10001, 30016, "正常"),
        ("residence.Residence", 30000, 30999, 30001, 30005, "正常"),
        ("school.School", 1, 99, 1, 8, "正常"),
        ("combat.spell", 101, 99999, 101, 900041, "越界"),
        ("activity.Activity", 10000, 19999, 10001, 10004, "正常"),
        ("assistant.Assistant", 1, 999, 1, 3, "正常"),
    ]
    for row in segments:
        ws3.append(list(row))

    # sheet4 各模块编号占段表（冗余视图，仿真实表结构）
    ws4 = wb.create_sheet("各模块编号占段表")
    ws4.append(["模块编号占段表"])
    ws4.append(["模块", "ID范围", "数量", "备注"])
    for m, lo, hi, ulo, uhi, st in segments:
        ws4.append([m, f"{lo}-{hi}", hi - lo + 1, st])

    wb.save(out)
    wb.close()
    print(f"[OK] id_mgr -> {out}")


# ============================================================
# 3. merge 漏行样本（补 ability/item 全量覆盖漏行场景）
# ============================================================
def build_merge_missing_rows():
    """现有 merge 只有新增无漏行。构造漏行样本测三方合并漏行检测。

    策略：复制 ability.xlsx → ability_missing.xlsx，删 2 行 → 当 testbranch 全量覆盖版。
    复制 item.xlsx → item_missing.xlsx，删 ItemBase 几行 + Equipment 几行。
    """
    # ---- ability 漏行样本 ----
    src = MERGE / "ability.xlsx"
    dst = MERGE / "ability_missing.xlsx"
    shutil.copy2(src, dst)
    wb = openpyxl.load_workbook(dst)
    ws = wb["Ability"]
    # 删 id=1001 和 id=2000（数据从第3行起，第1行中文表头第2行字段定义）
    # 先收集 id→row
    id_rows = {}
    for r in range(3, ws.max_row + 1):
        v = ws.cell(r, 1).value
        if isinstance(v, (int, float)):
            id_rows[int(v)] = r
    # 删 id=1002 + id=7013（扫描确认 ability id 稀疏，挑实际存在的）
    del_rows = sorted([id_rows[1002], id_rows[7013]], reverse=True)
    for r in del_rows:
        ws.delete_rows(r, 1)
    wb.save(dst)
    wb.close()
    print(f"[OK] ability_missing -> {dst} (删 id=1002,7013)")

    # ---- item 漏行样本 ----
    src = MERGE / "item.xlsx"
    dst = MERGE / "item_missing.xlsx"
    shutil.copy2(src, dst)
    wb = openpyxl.load_workbook(dst)

    # ItemBase 删 10001, 10500（第1行中文表头，数据从第2行起）
    ws_ib = wb["ItemBase"]
    id_rows = {}
    for r in range(2, ws_ib.max_row + 1):
        v = ws_ib.cell(r, 1).value
        if isinstance(v, (int, float)):
            id_rows[int(v)] = r
        elif isinstance(v, str) and v.strip().replace(",", "").isdigit():
            id_rows[int(v.replace(",", ""))] = r
    for target in [10001, 10500]:
        if target in id_rows:
            ws_ib.delete_rows(id_rows[target], 1)
            print(f"  ItemBase 删 id={target}")

    # Equipment 删 15001, 15050
    ws_eq = wb["Equipment"]
    id_rows = {}
    for r in range(2, ws_eq.max_row + 1):
        v = ws_eq.cell(r, 1).value
        if isinstance(v, (int, float)):
            id_rows[int(v)] = r
        elif isinstance(v, str) and v.strip().replace(",", "").isdigit():
            id_rows[int(v.replace(",", ""))] = r
    for target in [15001, 15050]:
        if target in id_rows:
            ws_eq.delete_rows(id_rows[target], 1)
            print(f"  Equipment 删 id={target}")

    wb.save(dst)
    wb.close()
    print(f"[OK] item_missing -> {dst}")


if __name__ == "__main__":
    build_formula_tables()
    build_id_mgr()
    build_merge_missing_rows()
    print("\n=== 全部构造完成 ===")
