import re
import os
from typing import List, Dict, Any, Tuple, Optional
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
import openpyxl

# 主要用于Excel文件的读取以及文件的分组

# M7-3: 大表公式/批注读取阈值——超过此大小的文件跳过 read_formulas_and_comments，
# 走无公式 fallback（大表通常纯数据，无公式列；跳过省 openpyxl 6s/文件开销）。
# big_data.xlsx(2.5MB) 命中跳过；item/ability(<500KB) 正常读公式/批注。
_FORMULA_SKIP_THRESHOLD = 500 * 1024


def _fix_calamine_value(v: Any) -> Any:
    """calamine 数值返回 float（如 1.0），openpyxl data_only 返回 int（如 1）。
    PK 列类型不一致会导致 _pk_str("1.0") vs "1" 行匹配失败，故 float 整数转 int。
    """
    if isinstance(v, float) and v.is_integer():
        return int(v)
    return v


# 读取Excel文件，返回所有Sheet的二维数组数据
def read_excel(file_path: str) -> Dict[str, List[List[Any]]]:
    """读取Excel文件的所有Sheet，返回 {sheet_name: [[cell_values...], ...]}"""
    # M7-3: 优先用 python-calamine（Rust rapidxml，10w 行 0.05s vs openpyxl 5.5s，100× 提速）。
    # 损坏文件或非 xlsx 回退 openpyxl。calamine 只读值（data_only 等价），不读公式/批注。
    try:
        from python_calamine import CalamineWorkbook
        wb = CalamineWorkbook.from_path(file_path)
        result = {}
        for sn in wb.sheet_names:
            raw = wb.get_sheet_by_name(sn).to_python()
            result[sn] = [[_fix_calamine_value(c) for c in row] for row in raw]
        return result
    except Exception:
        pass
    # fallback: openpyxl read_only 流式
    wb = openpyxl.load_workbook(file_path, data_only=True, read_only=True)
    try:
        result = {}
        for sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            rows = []
            for row in ws.iter_rows(min_row=1, values_only=True):
                rows.append(list(row))
            result[sheet_name] = rows
        return result
    finally:
        wb.close()


# 读取公式文本：返回 {sheet_name: [[formula_or_none...], ...]}，非公式单元格为 None
def read_formulas(file_path: str) -> Dict[str, List[List[Any]]]:
    """读取Excel文件所有Sheet的公式文本（data_only=False）。

    公式单元格返回公式文本（如 "=SUM(B3:E3)"），非公式单元格返回其原始值。
    与 read_excel（data_only=True 读缓存值）互补：比对时用 read_excel 比缓存值，
    用 read_formulas 判断该列是否为公式列——公式列文本一致则不算修改，
    而是因引用的输入值变化触发重算，单独标记 diff_type='formula'。
    """
    wb = openpyxl.load_workbook(file_path, data_only=False, read_only=True)
    try:
        result: Dict[str, List[List[Any]]] = {}
        for sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            rows: List[List[Any]] = []
            for row in ws.iter_rows(min_row=1, values_only=False):
                rows.append([c.value for c in row])
            result[sheet_name] = rows
        return result
    finally:
        wb.close()


# M7: 读取单元格批注（comment），返回 {sheet_name: [[comment_text_or_none, ...], ...]}
def read_comments(file_path: str) -> Dict[str, List[List[Any]]]:
    """读取Excel文件所有Sheet的单元格批注文本。

    与 read_excel 行对齐：返回 {sheet: [[comment_or_None], ...]}，
    无批注的单元格为 None，供 compare_sheet 做批注三方 diff。
    注：批注需访问 Cell.comment 属性，read_only 模式 ReadOnlyCell 无此属性，故非流式。
    """
    # M7-2: 复用 read_formulas 的加载（data_only=False 的 Cell 同时有 .value 与 .comment），
    # 避免独立 load_workbook。_build_group 改用 read_formulas_and_comments 后本函数仅作兼容入口。
    wb = openpyxl.load_workbook(file_path, data_only=False)
    try:
        result: Dict[str, List[List[Any]]] = {}
        for sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            rows: List[List[Any]] = []
            for row in ws.iter_rows(min_row=1, values_only=False):
                cells = []
                for c in row:
                    cm = c.comment
                    cells.append(cm.text if cm is not None else None)
                rows.append(cells)
            result[sheet_name] = rows
        return result
    finally:
        wb.close()


def read_formulas_and_comments(file_path: str) -> Tuple[Dict[str, List[List[Any]]], Dict[str, List[List[Any]]]]:
    """一次加载同时读取公式文本与批注（M7-2 合并加载，3 次→2 次）。

    data_only=False 的 Cell 对象同时携带 .value（公式文本或原始值）与 .comment，
    单遍 iter_rows 即可同时收集两者，避免 read_formulas + read_comments 各加载一次。
    注：批注需 Cell.comment，read_only 不可用，故非流式。

    M7-3: 大表（>= _FORMULA_SKIP_THRESHOLD）跳过公式/批注读取返回空——openpyxl 解析
    10w 行 XML 需 6s/文件，大表通常纯数据无公式列，跳过后 compare 走无公式 fallback
    （公式列当普通值列处理）行为正确。小表（item/ability 等 <500KB）正常读取保公式列语义。
    返回: (formulas, comments)，结构与各自单独函数一致。
    """
    if os.path.getsize(file_path) >= _FORMULA_SKIP_THRESHOLD:
        return {}, {}
    wb = openpyxl.load_workbook(file_path, data_only=False)
    try:
        formulas: Dict[str, List[List[Any]]] = {}
        comments: Dict[str, List[List[Any]]] = {}
        for sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            f_rows: List[List[Any]] = []
            c_rows: List[List[Any]] = []
            for row in ws.iter_rows(min_row=1, values_only=False):
                f_row = []
                c_row = []
                for c in row:
                    f_row.append(c.value)
                    cm = c.comment
                    c_row.append(cm.text if cm is not None else None)
                f_rows.append(f_row)
                c_rows.append(c_row)
            formulas[sheet_name] = f_rows
            comments[sheet_name] = c_rows
        return formulas, comments
    finally:
        wb.close()


def read_group_files(file_list: List[str]) -> Dict[str, Tuple[Dict[str, List[List[Any]]], Dict[str, List[List[Any]]], Dict[str, List[List[Any]]]]]:
    """并发读取一组文件，返回 {文件名: (sheets, formulas, comments)}。

    每个文件做：1 次 read_excel（read_only 流式取值） + 1 次 read_formulas_and_comments
    （一次开簿同时取公式与批注）。多个文件用 ThreadPoolExecutor 并发打开解析：
    openpyxl 底层 lxml/expat 在 C 层解析 XML 时释放 GIL，磁盘 IO 也释放 GIL，
    故多文件并发可获得真实加速（约等于并发文件数倍），且同进程无跨进程序列化开销。
    单文件场景退化为顺序，与原行为一致。
    """
    def _read_one(fp: str):
        fname = os.path.basename(fp)
        sheets = read_excel(fp)
        formulas, comments = read_formulas_and_comments(fp)
        return fname, (sheets, formulas, comments)

    out: Dict[str, Tuple[Dict[str, List[List[Any]]], Dict[str, List[List[Any]]], Dict[str, List[List[Any]]]]] = {}
    workers = max(1, min(len(file_list), 8))
    if len(file_list) <= 1:
        for fp in file_list:
            fname, data = _read_one(fp)
            out[fname] = data
        return out
    with ThreadPoolExecutor(max_workers=workers) as ex:
        for fname, data in ex.map(_read_one, list(file_list)):
            out[fname] = data
    return out


# 判断文件是否为基准版本（文件名不含 _数字 / _missing 后缀）
def is_base_file(filename: str) -> bool:
    # TODO,后续可能不是单纯这样判别
    """判断文件名是否为基准版本（无 _数字 / _missing 后缀）。

    activity.xlsx → True（基准）
    activity_1.xlsx → False（衍生版本）
    activity_missing.xlsx → False（漏行测试样本，属衍生）
    """
    name = os.path.splitext(filename)[0]
    # 检查文件名是否以 _数字 或 _missing 结尾
    return not re.search(r'(_\d+|_missing)$', name)


# 从文件名提取前缀，去掉 _数字 / _missing 后缀后即为分组前缀
def extract_prefix(filename: str) -> str:
    """提取文件名前缀，用于版本分组。

    activity.xlsx, activity_1.xlsx, activity_2.xlsx → 'activity'
    activity_missing.xlsx → 'activity'（_missing 后缀的漏行测试样本归入同组）
    """
    name = os.path.splitext(filename)[0]
    # 循环去末尾的 _数字 / _missing 后缀（可能叠加：foo_missing_2 → foo）
    for _ in range(3):
        m = re.search(r'(_missing|_\d+)$', name)
        if not m:
            break
        name = name[:m.start()]
    return name


# 将上传的文件按前缀分组，每组包含基准文件和若干衍生版本
def group_files(file_paths: List[str], base_files: dict = None) -> Dict[str, List[str]]:
    """将文件按前缀分组，返回 {prefix: [file_paths...]}。
    
    排序规则：如果 base_files 指定了某前缀的基准文件，优先使用它排在最前；
    否则按文件名规则判断（无下划线后缀的为基准）。
    过滤掉无法解析的损坏Excel文件。
    """
    if base_files is None:
        base_files = {}

    groups: Dict[str, List[str]] = defaultdict(list)
    for fp in file_paths:
        # 只处理Excel文件格式
        if not fp.endswith(('.xlsx', '.xls', '.xlsm')):
            continue
        # 轻量校验：read_only 开簿仅解析结构（不解析 sheet 数据），损坏文件跳过
        try:
            openpyxl.load_workbook(fp, data_only=True, read_only=True).close()
        except Exception:
            continue
        prefix = extract_prefix(os.path.basename(fp))
        groups[prefix].append(fp)

    # 排序：如果 base_files 指定了基准文件，优先使用它；否则按文件名规则判断
    for prefix in groups:
        if prefix in base_files:
            target = base_files[prefix]
            groups[prefix].sort(key=lambda fp: (
                0 if os.path.basename(fp) == target else 1,
                os.path.basename(fp),
            ))
        else:
            groups[prefix].sort(key=lambda fp: (
                0 if is_base_file(os.path.basename(fp)) else 1,
                os.path.basename(fp),
            ))

    # 只保留至少包含2个版本的分组（基准+至少1个衍生版本才有比对意义）
    return {k: v for k, v in groups.items() if len(v) >= 2}


# 获取所有文件中共同存在的Sheet名称交集
def get_common_sheets(file_sheets: Dict[str, Dict[str, List[List[Any]]]]) -> List[str]:
    """获取所有文件中都存在的Sheet名称列表，按字母排序。"""
    if not file_sheets:
        return []
    # 取第一个文件的Sheet集合作为初始值，然后与其他文件取交集
    common = set(list(file_sheets.values())[0].keys())
    for sheets in file_sheets.values():
        common &= set(sheets.keys())
    return sorted(common)


# 计算各文件 Sheet 集合差异（M6: missing_sheet 检测）
def get_sheet_diff(file_sheets: Dict[str, Dict[str, List[List[Any]]]], base_name: str = "") -> dict:
    """返回 {common: [...], missing_in_derived: [{sheet, missing_in: [file...]}], extra_in_derived: [...]}。

    - common: 所有文件共有的 sheet（与 get_common_sheets 一致）
    - missing_in_derived: base 有但部分衍生缺的 sheet（漏 sheet 告警来源）
    - extra_in_derived: 衍生有但 base 无的 sheet
    base_name 为空时取第一个文件作基准。
    """
    if not file_sheets:
        return {"common": [], "missing_in_derived": [], "extra_in_derived": []}
    all_names = set()
    for sheets in file_sheets.values():
        all_names |= set(sheets.keys())
    base = base_name if base_name in file_sheets else list(file_sheets.keys())[0]
    base_sheets = set(file_sheets[base].keys())
    derived_files = [f for f in file_sheets if f != base]
    common = base_sheets.copy()
    for f in derived_files:
        common &= set(file_sheets[f].keys())
    missing_in_derived = []
    for s in sorted(base_sheets - common):
        missing_in = [f for f in derived_files if s not in file_sheets[f]]
        missing_in_derived.append({"sheet": s, "missing_in": missing_in})
    extra_in_derived = sorted(all_names - base_sheets)
    return {
        "common": sorted(common),
        "missing_in_derived": missing_in_derived,
        "extra_in_derived": extra_in_derived,
    }


# 查找 trunk 基准文件（M3: ?base=trunk 自动注入）
def find_trunk_baseline(derived_name: str, trunk_dirs: List[str]) -> Optional[str]:
    """根据衍生版文件名查找 trunk 基准文件路径。

    去后缀规则：去 _missing / _数字 / __missing 等后缀 → {prefix}.xlsx。
    在 trunk_dirs 列表中按顺序查找第一个匹配的路径，返回字符串路径；找不到返回 None。
    """
    stem = os.path.splitext(derived_name)[0]
    # 去 _missing / _数字 后缀（可能叠加：item_missing → item，ability_2 → ability）
    for _ in range(3):
        m = re.search(r'(_missing|_\d+)$', stem)
        if not m:
            break
        stem = stem[:m.start()]
    target = f"{stem}.xlsx"
    for d in trunk_dirs:
        if not d:
            continue
        candidate = os.path.join(d, target)
        if os.path.isfile(candidate):
            return candidate
    return None
