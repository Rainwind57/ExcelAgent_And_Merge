"""任务6.5 端到端：subdir compare。

数据源：merge/svn/demo_svn/wc（真实 SVN 工作副本）。
subdev_1（branches/subdev_1，私有开发子目录分支）→ trunk 合回比对。

覆盖：自动反查 merge-base（subdev_1 copyfrom 时刻 trunk 快照）+ 三方比对 +
结构增删标注（src_scope_only=True，子目录未含的 trunk 既有表不误报删除）。

注：旧数据源 merge/demo（trunk_r4 等）与 merge/svn/fixture/wc 已下线，
统一迁至 demo_svn/wc。原旧 demo 的细粒度断言（_base_s1、SubdirOnly sheet、
new_feature/event 表）依赖旧快照特有数据，demo_svn 无对应结构，改为
基于 demo_svn 的可跑通性 + 基本正确性验证。
"""
import sys
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SERVER_DIR))

from routers.merge_subdir import subdir_compare, SubdirCompareRequest

DEMO_SVN_WC = SERVER_DIR.parent / "merge" / "svn" / "demo_svn" / "wc"


def count(group, kind):
    """统计 group 内 conflict / inserted / author_resolved 数。"""
    if kind == "conflict":
        return sum(1 for s in group.sheets.values() for r in s.rows for c in r.cells if c.conflict)
    if kind == "author_resolved":
        return sum(1 for s in group.sheets.values() for r in s.rows for c in r.cells if c.author_resolved)
    return sum(1 for s in group.sheets.values() for r in s.rows if r.row_type == "inserted")


def check_subdev_to_trunk():
    """subdev_1 → trunk 子目录比对：验证三方比对可跑通、base 反查到 copyfrom rev。

    demo_svn 单用户仓库禁用同作者合并，subdev_1 改动会如实呈现为冲突/变更。
    断言：base_file 非空（含 _base_r<rev>）、三方文件齐全（≥3）、无假 source_deleted
    （src_scope_only 生效，子目录未含的 trunk 既有表不应误报删除）。
    """
    src = str(DEMO_SVN_WC / "branches" / "subdev_1")
    tgt = str(DEMO_SVN_WC / "trunk")
    req = SubdirCompareRequest(source_dir=src, target_dir=tgt)
    resp = subdir_compare(req)
    assert resp.conflict_origin == "subdir", resp.conflict_origin
    assert resp.groups, "groups 为空，未比对到任何表"
    # 任取一表验证三方文件齐全 + base 反查成功
    gn, g = next(iter(resp.groups.items()))
    conflicts = count(g, "conflict")
    print(f"[subdev→trunk] table={gn} base={g.base_file} files={g.files} conflicts={conflicts}")
    assert g.base_file, "base_file empty"
    assert "_base_r" in g.base_file, f"base 应反查到 copyfrom rev，实际 {g.base_file}"
    assert len(g.files) >= 3, f"三方文件不足: {g.files}"
    # src_scope_only 生效：子目录未含的 trunk 既有表不应误报 source_deleted
    false_deletes = [c for c in resp.structural_changes
                     if c.status == "source_deleted" and c.origin == "source"]
    assert not false_deletes, f"子目录模式不应误报 source_deleted: {false_deletes}"
    print(f"  PASS subdev→trunk: {len(resp.groups)} 表比对成功，无假 source_deleted")
    print(f"  structural_changes={len(resp.structural_changes)} 条")


def main():
    if not (DEMO_SVN_WC / "branches" / "subdev_1").is_dir():
        print(f"SKIP: demo_svn/wc/branches/subdev_1 不存在（{DEMO_SVN_WC}），请先初始化 SVN demo")
        return
    check_subdev_to_trunk()
    print("=== ALL PASS subdir_compare ===")


if __name__ == "__main__":
    main()
