"""M7 批注参与 merge diff 验证脚本。

验证点：
  A. read_comments 读取批注 — 返回 {sheet: [[comment_or_None]]}
  B. 批注三方 diff — 基准与衍生批注不同 → comment_conflict=True
  C. 批注一致 — 各版本批注相同 → comment_conflict=False
  D. 无批注 — 全 None → comment_conflict=False, comments 空
  E. stats.comment_conflicts 计数正确
  F. compare_sheet 向后兼容 — 不传 file_comments 不报错

用法:
    python -m server.tests.verify_m7_comments
    python -X utf8 -m server.tests.verify_m7_comments
"""
from __future__ import annotations

import os
import sys
import shutil
import tempfile
from pathlib import Path

import openpyxl
from openpyxl.comments import Comment

sys.path.insert(0, str(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from engine.parser import read_comments
from engine.compare import compare_sheet

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _make_xlsx(path, rows, comments=None):
    """rows: [[c1,c2,...], ...] 从行1开始。comments: {(row,col): text} 1-based。"""
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Sheet1"
    for ri, row in enumerate(rows, start=1):
        for ci, val in enumerate(row, start=1):
            ws.cell(ri, ci, val)
    if comments:
        for (r, c), text in comments.items():
            ws.cell(r, c).comment = Comment(text, "test")
    wb.save(path)
    wb.close()


def main():
    tmp = Path(tempfile.mkdtemp(prefix="m7_"))
    print(f"临时目录: {tmp}")
    try:
        # 构建测试文件：基准 + 两个衍生
        # 数据：行1表头 id/name，行2数据 1/法宝A，行3数据 2/法宝B
        base = tmp / "base.xlsx"
        d1 = tmp / "d_1.xlsx"   # 衍生1：批注与基准不同
        d2 = tmp / "d_2.xlsx"   # 衍生2：批注与基准相同
        rows = [["id", "name"], [1, "法宝A"], [2, "法宝B"]]
        _make_xlsx(base, rows, comments={(2, 2): "基准批注"})
        _make_xlsx(d1, rows, comments={(2, 2): "衍生1不同批注"})
        _make_xlsx(d2, rows, comments={(2, 2): "基准批注"})

        print("[A] read_comments 读取批注")
        cms = read_comments(str(base))
        _check("返回 dict", isinstance(cms, dict))
        _check("含 Sheet1", "Sheet1" in cms)
        s = cms["Sheet1"]
        _check("行2列2 有批注", s[1][1] == "基准批注", str(s[1][1]))
        _check("行1列1 无批注", s[0][0] is None)

        print("[B] 批注三方 diff — 基准 vs 衍生1 不同 → comment_conflict")
        file_sheets = {"base.xlsx": read_excel_local(base), "d_1.xlsx": read_excel_local(d1), "d_2.xlsx": read_excel_local(d2)}
        file_comments = {"base.xlsx": read_comments(str(base)), "d_1.xlsx": read_comments(str(d1)), "d_2.xlsx": read_comments(str(d2))}
        merged = compare_sheet(file_sheets, "base.xlsx", "Sheet1", file_comments=file_comments)
        # 行2（id=1）列2（name）批注冲突
        row1 = merged["rows"][0]  # id=1
        cell_name = next(c for c in row1["cells"] if c["col"] == 1)  # col 0-based=1 → name
        _check("comment_conflict=True", cell_name.get("comment_conflict") is True,
               str(cell_name.get("comments")))
        _check("comments 含3版本", len(cell_name.get("comments", {})) == 3,
               str(cell_name.get("comments")))
        _check("stats.comment_conflicts=1", merged["stats"]["comment_conflicts"] == 1,
               str(merged["stats"]))

        print("[C] 批注一致 — 衍生2 与基准相同")
        # base 和 d_2 批注相同，d_1 不同 → 仍有冲突（因为 d_1 不同）
        # 验证：单独比 base vs d_2（批注一致）→ 无冲突
        fs2 = {"base.xlsx": file_sheets["base.xlsx"], "d_2.xlsx": file_sheets["d_2.xlsx"]}
        fc2 = {"base.xlsx": file_comments["base.xlsx"], "d_2.xlsx": file_comments["d_2.xlsx"]}
        m2 = compare_sheet(fs2, "base.xlsx", "Sheet1", file_comments=fc2)
        row1b = m2["rows"][0]
        cell_b = next(c for c in row1b["cells"] if c["col"] == 1)
        _check("批注一致 comment_conflict=False", cell_b.get("comment_conflict") is False)
        _check("stats.comment_conflicts=0", m2["stats"]["comment_conflicts"] == 0)

        print("[D] 无批注 — 全 None")
        base_nocm = tmp / "base_nocm.xlsx"
        d1_nocm = tmp / "d1_nocm.xlsx"
        _make_xlsx(base_nocm, rows)
        _make_xlsx(d1_nocm, rows)
        fs3 = {"base.xlsx": read_excel_local(base_nocm), "d_1.xlsx": read_excel_local(d1_nocm)}
        fc3 = {"base.xlsx": read_comments(str(base_nocm)), "d_1.xlsx": read_comments(str(d1_nocm))}
        m3 = compare_sheet(fs3, "base.xlsx", "Sheet1", file_comments=fc3)
        cell_n = next(c for c in m3["rows"][0]["cells"] if c["col"] == 1)
        _check("无批注 comment_conflict=False", cell_n.get("comment_conflict") is False)
        _check("无批注 comments 空", len(cell_n.get("comments", {})) == 0)

        print("[E] stats.comment_conflicts 计数")
        _check("B 场景计数=1", merged["stats"]["comment_conflicts"] == 1)
        _check("C 场景计数=0", m2["stats"]["comment_conflicts"] == 0)

        print("[F] 向后兼容 — 不传 file_comments 不报错")
        m4 = compare_sheet(file_sheets, "base.xlsx", "Sheet1")
        _check("无 file_comments 正常返回", "rows" in m4 and len(m4["rows"]) > 0)
        cell_c = next(c for c in m4["rows"][0]["cells"] if c["col"] == 1)
        _check("comments 默认空", len(cell_c.get("comments", {})) == 0)
        _check("comment_conflict 默认 False", cell_c.get("comment_conflict") is False)

    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        print(f"\n已清理临时目录")

    print(f"\n{'='*40}")
    print(f"M7 验证结果: {_passed} PASS / {_failed} FAIL")
    return 0 if _failed == 0 else 1


def read_excel_local(path):
    """简易 read_excel 替代（避免 import 链）。"""
    from engine.parser import read_excel
    return read_excel(str(path))


if __name__ == "__main__":
    sys.exit(main())
