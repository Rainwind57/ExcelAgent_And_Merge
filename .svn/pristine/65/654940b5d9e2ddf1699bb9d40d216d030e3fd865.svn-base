[project]
name = "ai-excel-tool"
version = "2.0.0"
description = "AI 辅助 Excel 配表工具"
requires-python = ">=3.10"
dependencies = [
    "fastapi==0.115.0",
    "uvicorn==0.30.6",
    "openpyxl==3.1.5",
    "python-multipart==0.0.9",
    "pyyaml>=6.0",
    "jieba>=0.42.1",
    "watchdog>=4.0.0",
    "langchain>=0.3.0",
    "langgraph>=0.2.0",
    "langchain-core>=0.3.0",
    "langgraph-checkpoint>=0.1.0",
    "langgraph-prebuilt>=0.1.0",
    "langgraph-sdk>=0.1.0",
    "python-calamine>=0.8.2",
    "python-dotenv>=1.0.0",
    "rapidfuzz>=3.14.5",
    "numpy>=2.2.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["server"]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "pytest-asyncio>=0.21",
    "httpx>=0.24",
]
