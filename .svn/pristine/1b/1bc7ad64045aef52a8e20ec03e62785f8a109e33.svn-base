"""R5: codemaker 插件 skill 挂载三端点验证。

验证：
  1. _iter_skill_files 枚举非空且含四层
  2. /manifest 返回层级/用途/时间戳正确
  3. /diff since 2020 有变更、since 2099 为空、非法 since 抛 400
  4. /export zip 含 L0/L1 文件、不含 quarantine/候选 jsonl
"""
import asyncio
import io
import sys
import zipfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from fastapi import HTTPException
from routers.skills import (
    _iter_skill_files,
    skills_manifest,
    skills_export,
    skills_diff,
)


async def read_stream(resp):
    """StreamingResponse 的 body_iterator 异步迭代拼接。"""
    chunks = []
    async for chunk in resp.body_iterator:
        chunks.append(chunk)
    return b"".join(chunks)


def main():
    fails = []

    # 1. 枚举
    files = _iter_skill_files()
    print(f"[1] 枚举 skills 文件: {len(files)} 个")
    if not files:
        fails.append("枚举为空")

    # 2. manifest
    m = asyncio.run(skills_manifest())
    print(f"[2] manifest total_files={m['total_files']}")
    paths = [f["path"] for f in m["files"]]
    for must in ["parser_config.yaml", "L1_derived/column_aliases.yaml",
                 "L1_derived/value_constraints.yaml", "L3_anti_patterns/anti_patterns.yaml"]:
        if must not in paths:
            fails.append(f"manifest 缺 {must}")
    # 抽查层级 + 用途
    for f in m["files"]:
        if f["path"] == "parser_config.yaml":
            if f["layer"] != "L0":
                fails.append(f"parser_config 层级应为 L0 实际 {f['layer']}")
            if not f["purpose"]:
                fails.append("parser_config 用途为空")
        if f["path"] == "L1_derived/column_aliases.yaml":
            if f["layer"] != "L1":
                fails.append(f"column_aliases 层级应为 L1 实际 {f['layer']}")
        if f["path"] == "L3_anti_patterns/anti_patterns.yaml":
            if f["layer"] != "L3":
                fails.append(f"anti_patterns 层级应为 L3 实际 {f['layer']}")
        if not f["mtime"] or not f["size"]:
            fails.append(f"{f['path']} mtime/size 为空")

    # 3. diff
    d = asyncio.run(skills_diff(since="2020-01-01"))
    print(f"[3a] diff since 2020 total={d['total']}")
    if d["total"] == 0:
        fails.append("diff since 2020 应有变更")
    d2 = asyncio.run(skills_diff(since="2099-01-01"))
    print(f"[3b] diff since 2099 total={d2['total']}")
    if d2["total"] != 0:
        fails.append("diff since 2099 应为空")
    # ISO 格式
    d3 = asyncio.run(skills_diff(since="2026-07-22T00:00:00"))
    if "changed_files" not in d3:
        fails.append("diff ISO 格式应正常解析")
    # 非法
    try:
        asyncio.run(skills_diff(since="not-a-date"))
        fails.append("非法 since 应抛 400")
    except HTTPException as e:
        if e.status_code != 400:
            fails.append(f"非法 since 应 400 实际 {e.status_code}")

    # 4. export
    resp = asyncio.run(skills_export())
    body = asyncio.run(read_stream(resp))
    z = zipfile.ZipFile(io.BytesIO(body))
    names = z.namelist()
    print(f"[4] export zip 含 {len(names)} 文件")
    if "parser_config.yaml" not in names:
        fails.append("zip 缺 parser_config.yaml")
    if "L1_derived/column_aliases.yaml" not in names:
        fails.append("zip 缺 L1_derived/column_aliases.yaml")
    if any(n.startswith("_pending/quarantine") for n in names):
        fails.append("zip 不应含 quarantine")
    if any("column_alias_candidates.jsonl" in n for n in names):
        fails.append("zip 不应含候选 jsonl")
    if any("anti_pattern_signals.jsonl" in n for n in names):
        fails.append("zip 不应含 signals jsonl")
    # content-disposition
    cd = resp.headers.get("content-disposition", "")
    if "skills_bundle" not in cd or ".zip" not in cd:
        fails.append(f"content-disposition 异常: {cd}")

    print()
    if fails:
        print(f"FAIL ({len(fails)}):")
        for x in fails:
            print(f"  - {x}")
        sys.exit(1)
    print("ALL PASS (R5 三端点)")


if __name__ == "__main__":
    main()
