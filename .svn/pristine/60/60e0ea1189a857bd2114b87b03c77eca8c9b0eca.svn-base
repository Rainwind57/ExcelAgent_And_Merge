"""T9/T10 验证脚本：skill 衰减 + 安全阀（快照/回归门禁/回滚/隔离）。

覆盖:
  T9 (D9.1-D9.6):
    - D9.1 衰减公式 _compute_weight
    - D9.2 进程启动 + file_watcher 触发 decay_scan
    - D9.3 冲突检测 resolve_conflicts
    - D9.4 失效标记 detect_stale_rules
    - D9.5 接口 decay_scan / detect_stale_rules / resolve_conflicts
    - D9.6 数据流（evidence → 候选 → promote → decay）

  T10 (D10.1-D10.7):
    - D10.1 .snapshots 目录机制
    - D10.2 快照内容 + manifest.json
    - D10.3 promote_with_guard（快照→写盘→回归→回滚）
    - D10.4 影子写入 + 隔离
    - D10.5 保留策略（5 份快照 / 30 天隔离）
    - D10.6 接口 _take_snapshot / _rollback / _quarantine / promote_with_guard
    - D10.7 与 T6-T9 依赖（promote 走 guard，decay 不走）

用法:
    python -X utf8 -m server.tests.verify_t9_t10
"""
from __future__ import annotations

import json
import os
import shutil
import sys
import tempfile
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

_passed = 0
_failed = 0


def check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}")
    if detail:
        for line in detail.splitlines():
            print(f"        {line}")
    if ok:
        _passed += 1
    else:
        _failed += 1
    return ok


def _make_skill_updater(tmpdir: Path):
    """用临时 skills_dir 构造 SkillUpdater，隔离真实 skills/。"""
    from agent.excel.skill_updater import SkillUpdater
    skills_dir = tmpdir / "skills"
    skills_dir.mkdir(parents=True, exist_ok=True)
    (skills_dir / "L2_runtime").mkdir(exist_ok=True)
    (skills_dir / "_pending").mkdir(exist_ok=True)
    (skills_dir / "L3_anti_patterns").mkdir(exist_ok=True)
    return SkillUpdater(skills_dir, evidence_dir=tmpdir / "evidence")


def _col_record(table_stem="ability", sheet="Ability", query="神通名",
                resolved="名称", score=0.6, ok=True, user_corrected=False,
                needs_confirm=False, intent_action="set", session_id="s1",
                ts=None):
    return {
        "ts": ts or datetime.now().astimezone().isoformat(timespec="seconds"),
        "session_id": session_id,
        "table_stem": table_stem, "sheet": sheet,
        "intent_action": intent_action, "dry_run": False,
        "col": {"query": query, "resolved": resolved, "score": score},
        "row": {"query": "", "resolved": "", "method": "none",
                "confidence": 0.0, "ambiguous": False, "alternatives": []},
        "ok": ok, "needs_confirm": needs_confirm,
        "user_corrected": user_corrected, "corrected_to": None,
    }


# ══════════════════════════════════════════════════════════════════
# T9 衰减
# ══════════════════════════════════════════════════════════════════

def test_d91_decay_formula():
    """D9.1compute_weight。"""
    from agent.excel.skill_updater import SkillUpdater
    now = datetime.now().astimezone()

    # hits=5, last_seen=now → base=0.5, recency=1.0 → 0.5
    w = SkillUpdater._compute_weight(5, now.isoformat(timespec="seconds"), now)
    check("D9.1 hits=5/now weight=0.5", abs(w - 0.5) < 0.01, f"got {w}")

    # hits=10+, now → base=1.0, recency=1.0 → 1.0
    w = SkillUpdater._compute_weight(15, now.isoformat(timespec="seconds"), now)
    check("D9.1 hits=15 cap=1.0", abs(w - 1.0) < 0.01, f"got {w}")

    # hits=5, 40 天前 → base=0.5, recency=0.5 → 0.25
    last = (now - timedelta(days=40)).isoformat(timespec="seconds")
    w = SkillUpdater._compute_weight(5, last, now)
    check("D9.1 40d weight=0.25", abs(w - 0.25) < 0.01, f"got {w}")

    # hits=5, 70 天前 → recency=0 → 0
    last = (now - timedelta(days=70)).isoformat(timespec="seconds")
    w = SkillUpdater._compute_weight(5, last, now)
    check("D9.1 70d weight=0", w == 0.0, f"got {w}")

    # hits=0 → base=0 → 0
    w = SkillUpdater._compute_weight(0, now.isoformat(timespec="seconds"), now)
    check("D9.1 hits=0 weight=0", w == 0.0, f"got {w}")

    # 坏时间戳 → 0
    w = SkillUpdater._compute_weight(5, "not-a-date", now)
    check("D9.1 坏时间戳 weight=0", w == 0.0, f"got {w}")


def test_d95_decay_scan_runtime_alias():
    """D9.5 decay_scan 扫 runtime yaml：移除 + dormant + active。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        # 先 promote 一条（临时环境跳过回归 → 直接写盘）
        for _ in range(3):
            su.ingest_evidence(_col_record(score=0.6))
        su.try_promote()
        check("D9.5 promote 后 runtime yaml 存在", su.runtime_aliases_path.exists())

        # 改 _meta 的 last_seen 为 70 天前 → decay 应移除
        import yaml
        data = yaml.safe_load(su.runtime_aliases_path.read_text(encoding="utf-8"))
        now = datetime.now().astimezone()
        old = (now - timedelta(days=70)).isoformat(timespec="seconds")
        for t, sheets in data.get("_meta", {}).items():
            for s, m in sheets.items():
                for q, meta in m.items():
                    meta["last_seen"] = old
        su._write_runtime_aliases(data)

        stats = su.decay_scan(now=now)
        check("D9.5 移除 1 条", stats["removed"] == 1, f"got {stats}")
        # yaml 里 columns 段应清空
        data2 = yaml.safe_load(su.runtime_aliases_path.read_text(encoding="utf-8")) or {}
        cols = data2.get("columns") or {}
        check("D9.5 移除后 columns 空", not cols.get("ability", {}).get("Ability"))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d95_decay_scan_dormant():
    """D9.5 decay_scan 30-60 天 → dormant。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        for _ in range(3):
            su.ingest_evidence(_col_record(score=0.6))
        su.try_promote()

        import yaml
        data = yaml.safe_load(su.runtime_aliases_path.read_text(encoding="utf-8"))
        now = datetime.now().astimezone()
        old = (now - timedelta(days=40)).isoformat(timespec="seconds")
        for t, sheets in data.get("_meta", {}).items():
            for s, m in sheets.items():
                for q, meta in m.items():
                    meta["last_seen"] = old
        su._write_runtime_aliases(data)

        stats = su.decay_scan(now=now)
        check("D9.5 dormant 1 条", stats["dormant"] == 1, f"got {stats}")
        data2 = yaml.safe_load(su.runtime_aliases_path.read_text(encoding="utf-8")) or {}
        meta = data2.get("_meta", {}).get("ability", {}).get("Ability", {}).get("神通名", {})
        check("D9.5 dormant status", meta.get("status") == "dormant", f"got {meta}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d95_decay_anti_pattern():
    """D9.5 decay_scan anti_patterns：30 天 → dormant。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        from agent.excel.skill_updater import AntiPattern
        now = datetime.now().astimezone()
        old = (now - timedelta(days=35)).isoformat(timespec="seconds")
        su._apply_anti_pattern_upsert(AntiPattern(
            id="ap_test1", type="ambiguous_column",
            table_stem="ability", sheet="Ability", column="名称",
            trigger="ambiguous", occurrences=3,
            first_seen=old, last_seen=old,
            action="force_exact", status="active",
        ))
        stats = su.decay_scan(now=now)
        check("D9.5 anti_pattern dormant", stats["dormant"] >= 1, f"got {stats}")
        aps = su.load_anti_patterns()
        ap = next((a for a in aps if a.id == "ap_test1"), None)
        check("D9.5 anti_pattern status=dormant", ap and ap.status == "dormant")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d94_detect_stale_rules():
    """D9.4 失效标记：删除的表 → cascade 规则标 stale。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        # 手工造 cascade_rules.yaml
        import yaml
        rules = {
            "version": "1.0", "auto_generated": True,
            "rules": [
                {"source_table": "combat", "cascade_on_add": [],
                 "cascade_on_delete": [
                     {"target_table": "space", "source_col": "id", "target_col": "x"}
                 ]},
                {"source_table": "removed_table", "cascade_on_add": [],
                 "cascade_on_delete": []},
            ]
        }
        su.cascade_rules_path.parent.mkdir(parents=True, exist_ok=True)
        su.cascade_rules_path.write_text(
            yaml.safe_dump(rules, allow_unicode=True, sort_keys=False), encoding="utf-8")

        stale = su.detect_stale_rules(["removed_table"])
        check("D9.4 检出 1 条 stale", len(stale) == 1, f"got {stale}")
        check("D9.4 stale reason", stale[0]["reason"] == "table_removed")
        # 验证写回
        data = yaml.safe_load(su.cascade_rules_path.read_text(encoding="utf-8"))
        r2 = data["rules"][1]
        check("D9.4 写回 stale=true", r2.get("stale") is True)
        check("D9.4 写回 deprecated_at 非空", bool(r2.get("deprecated_at")))
        # 未删除的表不标
        r1 = data["rules"][0]
        check("D9.4 未删表不标 stale", not r1.get("stale"))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d93_resolve_conflicts():
    """D9.3 冲突检测 resolve_conflicts。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        # 手工造 conflicts.yaml
        import yaml
        data = {"conflicts": [
            {"query": "名", "resolved_candidates": ["名称", "名字"],
             "table_stem": "ability", "sheet": "Ability",
             "hits": {"名称": 3, "名字": 2}, "status": "pending_review"},
            {"query": "x", "resolved_candidates": ["a"],
             "status": "resolved"},
        ]}
        su.conflicts_path.parent.mkdir(parents=True, exist_ok=True)
        su.conflicts_path.write_text(
            yaml.safe_dump(data, allow_unicode=True, sort_keys=False), encoding="utf-8")

        conflicts = su.resolve_conflicts()
        check("D9.3 返回 1 条 pending_review", len(conflicts) == 1, f"got {len(conflicts)}")
        check("D9.3 conflicts[0] query=名", conflicts[0]["query"] == "名")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d92_agent_service_hook():
    """D9.2 agent_service 接 decay_scan（_on_file_changed + __init__）。"""
    import inspect
    from services import agent_service
    src = inspect.getsource(agent_service)
    check("D9.2 _on_file_changed 调 decay_scan", "decay_scan" in src)
    check("D9.2 _on_file_changed 调 detect_stale_rules", "detect_stale_rules" in src)
    check("D9.2 __init__ 调 decay_scan", src.count("decay_scan()") >= 2)
    check("D9.2 invalidate_cache 调 detect_stale_rules", src.count("detect_stale_rules") >= 2)


# ══════════════════════════════════════════════════════════════════
# T10 安全阀
# ══════════════════════════════════════════════════════════════════

def test_d102_snapshot_structure():
    """D10.2 快照目录 + manifest.json 结构。"""
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        # 先造一些 runtime 文件
        su.runtime_dir.mkdir(parents=True, exist_ok=True)
        su.runtime_aliases_path.write_text("columns: {}\n_meta: {}\n", encoding="utf-8")
        su.anti_patterns_path.write_text("anti_patterns: []\n", encoding="utf-8")
        su.candidates_path.parent.mkdir(parents=True, exist_ok=True)
        su.candidates_path.write_text('{"q": "x"}\n', encoding="utf-8")

        snap = su._take_snapshot(trigger="test")
        check("D10.2 快照目录存在", snap.exists())
        check("D10.2 快照目录在 .snapshots", snap.parent.name == ".snapshots")
        manifest = snap / "manifest.json"
        check("D10.2 manifest.json 存在", manifest.exists())
        m = json.loads(manifest.read_text(encoding="utf-8"))
        check("D10.2 manifest 含 ts", bool(m.get("ts")))
        check("D10.2 manifest trigger=test", m.get("trigger") == "test")
        check("D10.2 manifest changed_files 非空", len(m.get("changed_files", [])) > 0)
        check("D10.2 manifest checksums 非空", len(m.get("checksums", {})) > 0)
        check("D10.2 复制 L2_runtime", (snap / "L2_runtime").exists())
        check("D10.2 复制 L3_anti_patterns", (snap / "L3_anti_patterns").exists())
        check("D10.2 复制 _pending", (snap / "_pending").exists())
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d103_promote_with_guard_pass():
    """D10.3 promote_with_guard 临时环境降级（无回归）→ 直接通过。"""
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        for _ in range(3):
            su.ingest_evidence(_col_record(score=0.6))
        promoted = su.try_promote()
        check("D10.3 临时环境 promote 返回1条", len(promoted) == 1, f"got {promoted}")
        check("D10.3 runtime yaml 生成", su.runtime_aliases_path.exists())
        check("D10.3 候选池清空", su.candidates_path.exists() is False
              or su.candidates_path.stat().st_size == 0)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d103_rollback_on_regression_fail():
    """D10.3 回归失败 → 回滚 + 隔离。

    模拟回归失败：monkeypatch _run_regression 返回 pass_rate=0。
    """
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        # 先造一份现有 runtime yaml（promote 前状态）
        su.runtime_dir.mkdir(parents=True, exist_ok=True)
        su.runtime_aliases_path.write_text(
            "columns: {}\n_meta: {}\n", encoding="utf-8")
        # monkeypatch 回归失败
        su._run_regression = lambda: {
            "pass_rate": 0.0, "returncode": 1,
            "stdout": "", "stderr": "simulated fail",
        }
        candidate = {
            "kind": "column_alias",
            "table_stem": "ability", "sheet": "Ability",
            "query": "神通名", "resolved": "名称",
            "items": [{"ts": datetime.now().astimezone().isoformat(timespec="seconds")}],
            "avg_conf": 0.6,
        }
        ok = su.promote_with_guard(candidate)
        check("D10.3 回归失败返回 False", ok is False)
        # 回滚后 runtime yaml 应恢复空状态
        content = su.runtime_aliases_path.read_text(encoding="utf-8")
        check("D10.3 回滚后 columns 仍空", "神通名" not in content)
        # 隔离区应有条目
        check("D10.3 隔离区有条目", su.quarantine_dir.exists()
              and any(su.quarantine_dir.iterdir()))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d104_quarantine():
    """D10.4 隔离区：失败候选写入 + is_quarantined 检查。"""
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        candidate = {
            "kind": "column_alias",
            "table_stem": "ability", "sheet": "Ability",
            "query": "神通名", "resolved": "名称",
        }
        check("D10.4 隔离前 is_quarantined=False",
              su.is_quarantined(candidate) is False)
        su._quarantine(candidate, reason="test")
        check("D10.4 隔离后 is_quarantined=True",
              su.is_quarantined(candidate) is True)
        # 隔离文件内容
        qfiles = list(su.quarantine_dir.glob("*.json"))
        check("D10.4 隔离文件存在", len(qfiles) == 1)
        entry = json.loads(qfiles[0].read_text(encoding="utf-8"))
        check("D10.4 隔离条目含 reason", entry.get("reason") == "test")
        check("D10.4 隔离条目含 candidate", "candidate" in entry)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d105_snapshot_retention():
    """D10.5 保留策略：超过 SNAPSHOT_KEEP 份删除旧的。"""
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        from agent.excel.skill_updater import SNAPSHOT_KEEP
        # 造 SNAPSHOT_KEEP + 2 份快照
        for _ in range(SNAPSHOT_KEEP + 2):
            su._take_snapshot(trigger="retention_test")
        snaps = [p for p in su.snapshots_dir.iterdir() if p.is_dir()]
        check(f"D10.5 快照数 <= {SNAPSHOT_KEEP}",
              len(snaps) <= SNAPSHOT_KEEP, f"got {len(snaps)}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_d106_interfaces():
    """D10.6 接口存在性。"""
    from agent.excel.skill_updater import SkillUpdater
    for name in ["_take_snapshot", "_rollback", "_quarantine",
                 "promote_with_guard", "_run_regression",
                 "is_quarantined", "_prune_snapshots", "_prune_quarantine"]:
        check(f"D10.6 接口 {name}", hasattr(SkillUpdater, name))


def test_d107_promote_uses_guard():
    """D10.7 try_promote + _upsert_anti_pattern 走 promote_with_guard。"""
    import inspect
    from agent.excel.skill_updater import SkillUpdater
    src = inspect.getsource(SkillUpdater.try_promote)
    check("D10.7 try_promote 调 promote_with_guard", "promote_with_guard" in src)
    src2 = inspect.getsource(SkillUpdater._upsert_anti_pattern)
    check("D10.7 _upsert_anti_pattern 调 promote_with_guard",
          "promote_with_guard" in src2)
    # decay_scan 不应走 guard（只删不增，风险低）
    src3 = inspect.getsource(SkillUpdater.decay_scan)
    check("D10.7 decay_scan 不调 promote_with_guard",
          "promote_with_guard" not in src3)


def test_d107_quarantine_skip():
    """D10.7 隔离区候选不重试。"""
    tmp = Path(tempfile.mkdtemp(prefix="t10_"))
    try:
        su = _make_skill_updater(tmp)
        candidate = {
            "kind": "column_alias",
            "table_stem": "ability", "sheet": "Ability",
            "query": "神通名", "resolved": "名称",
            "items": [{"ts": datetime.now().astimezone().isoformat(timespec="seconds")}],
            "avg_conf": 0.6,
        }
        su._quarantine(candidate, reason="prev_fail")
        # 再 promote_with_guard → 应直接跳过（is_quarantined=True）
        ok = su.promote_with_guard(candidate)
        check("D10.7 隔离候选跳过返回 False", ok is False)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ══════════════════════════════════════════════════════════════════
# D9.6 数据流
# ══════════════════════════════════════════════════════════════════

def test_d96_dataflow():
    """D9.6 数据流：evidence → 候选 → promote → decay 移除。"""
    tmp = Path(tempfile.mkdtemp(prefix="t9_"))
    try:
        su = _make_skill_updater(tmp)
        # 1. evidence → 候选池
        for _ in range(3):
            su.ingest_evidence(_col_record(score=0.6))
        check("D9.6 step1 候选池非空", su.candidates_path.exists()
              and su.candidates_path.stat().st_size > 0)
        # 2. promote → runtime yaml
        su.try_promote()
        check("D9.6 step2 runtime yaml 非空", su.runtime_aliases_path.exists())
        # 3. decay → 改 last_seen 为 70 天前后移除
        import yaml
        now = datetime.now().astimezone()
        old = (now - timedelta(days=70)).isoformat(timespec="seconds")
        data = yaml.safe_load(su.runtime_aliases_path.read_text(encoding="utf-8"))
        for t, sheets in data.get("_meta", {}).items():
            for s, m in sheets.items():
                for q, meta in m.items():
                    meta["last_seen"] = old
        su._write_runtime_aliases(data)
        stats = su.decay_scan(now=now)
        check("D9.6 step3 decay 移除 >=1", stats["removed"] >= 1, f"got {stats}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    print("=" * 60)
    print("T9/T10 衰减 + 安全阀 验证测试套件")
    print("=" * 60)

    print("\n--- T9 衰减 (D9.1-D9.6) ---")
    test_d91_decay_formula()
    test_d95_decay_scan_runtime_alias()
    test_d95_decay_scan_dormant()
    test_d95_decay_anti_pattern()
    test_d94_detect_stale_rules()
    test_d93_resolve_conflicts()
    test_d92_agent_service_hook()
    test_d96_dataflow()

    print("\n--- T10 安全阀 (D10.1-D10.7) ---")
    test_d102_snapshot_structure()
    test_d103_promote_with_guard_pass()
    test_d103_rollback_on_regression_fail()
    test_d104_quarantine()
    test_d105_snapshot_retention()
    test_d106_interfaces()
    test_d107_promote_uses_guard()
    test_d107_quarantine_skip()

    print("\n" + "=" * 60)
    print(f"结果: {_passed}/{_passed + _failed} PASS "
          f"({_passed / (_passed + _failed) * 100:.0f}%)")
    print("=" * 60)
    return 0 if _failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
