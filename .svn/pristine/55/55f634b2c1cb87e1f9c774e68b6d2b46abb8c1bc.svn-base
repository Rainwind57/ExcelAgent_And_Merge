import json, glob, os
from collections import Counter

sessions = Counter()
real = []
files = (glob.glob("agent/excel/dialog_examples/*.jsonl")
         + glob.glob("agent/excel/dialog_failures/*.jsonl")
         + glob.glob("agent/excel/dialogs/*.jsonl"))
for p in files:
    for ln in open(p, encoding="utf-8"):
        ln = ln.strip()
        if not ln:
            continue
        try:
            o = json.loads(ln)
        except Exception:
            continue
        sid = o.get("session_id", "?")
        sessions[sid] += 1
        if sid != "ab_test":
            real.append((os.path.basename(p), o))

print("total_files:", len(files))
print("sessions:", dict(sessions))
print("real(non-ab_test) count:", len(real))
if real:
    p, o = real[0]
    print("sample file:", p)
    print("keys:", list(o.keys()))
    raw = o.get("raw", "")
    if not raw and isinstance(o.get("intent"), dict):
        raw = o["intent"].get("raw", "")
    print("raw:", raw[:200] if raw else str(o)[:300])
