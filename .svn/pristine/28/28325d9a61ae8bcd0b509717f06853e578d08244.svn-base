"""GET /api/svn/branch-point 单元验证脚本（openspec change merge-svn-dual-mode 任务 1.4）。

覆盖场景：
  A. 有 copyfrom 记录（分支/子目录由拷贝创建）
  B. 无 copyfrom 记录（分支/子目录由新建创建，降级取首次提交版本号-1）
  C. svn CLI 不可用（FileNotFoundError）

用 monkeypatch 替换 routers.svn_history.subprocess.run，不依赖真实 svn 环境。

用法： cd server && python tests/verify_branch_point.py
"""
import os
import sys
from pathlib import Path
from unittest import mock

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import routers.svn_history as svn_history

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


XML_WITH_COPYFROM = """<?xml version="1.0" encoding="UTF-8"?>
<log>
<logentry revision="42">
<author>alice</author>
<date>2024-01-01T00:00:00.000000Z</date>
<paths>
<path action="A" copyfrom-path="/trunk/table_a" copyfrom-rev="30" kind="dir">/branches/branch_a</path>
</paths>
<msg>create branch_a from trunk</msg>
</logentry>
<logentry revision="45">
<author>alice</author>
<date>2024-01-02T00:00:00.000000Z</date>
<paths>
<path action="M" kind="dir">/branches/branch_a</path>
</paths>
<msg>update</msg>
</logentry>
</log>
"""

XML_WITHOUT_COPYFROM = """<?xml version="1.0" encoding="UTF-8"?>
<log>
<logentry revision="10">
<author>bob</author>
<date>2024-02-01T00:00:00.000000Z</date>
<paths>
<path action="A" kind="dir">/trunk/sub_y</path>
</paths>
<msg>add sub_y as new dir</msg>
</logentry>
</log>
"""


class _FakeCompletedProcess:
    def __init__(self, stdout="", returncode=0):
        self.stdout = stdout
        self.stderr = ""
        self.returncode = returncode


def scenario_a_with_copyfrom():
    """A. 有 copyfrom 记录：应返回 ok=True, inferred=False，copyfrom_rev=30。"""
    print("[A] 有 copyfrom 记录")

    def fake_run(cmd, **kwargs):
        return _FakeCompletedProcess(stdout=XML_WITH_COPYFROM, returncode=0)

    merge_dir = svn_history.MERGE_DIR
    branch_dir = merge_dir / "branches" / "branch_a"
    branch_dir.mkdir(parents=True, exist_ok=True)
    try:
        with mock.patch.object(svn_history.subprocess, "run", side_effect=fake_run):
            res = svn_history.branch_point(path="branches/branch_a", source="/trunk/table_a")
    finally:
        # 清理测试目录
        try:
            branch_dir.rmdir()
            (merge_dir / "branches").rmdir()
        except OSError:
            pass

    _check("ok=True", res.get("ok") is True, str(res))
    _check("copyfrom_path 正确", res.get("copyfrom_path") == "/trunk/table_a", str(res.get("copyfrom_path")))
    _check("copyfrom_rev=30", res.get("copyfrom_rev") == 30, str(res.get("copyfrom_rev")))
    _check("inferred=False", res.get("inferred") is False, str(res.get("inferred")))
    _check("log_entry.rev=42", res.get("log_entry", {}).get("rev") == 42, str(res.get("log_entry")))
    _check("source 匹配无 warning", "warning" not in res, str(res.get("warning")))


def scenario_a2_source_mismatch_warning():
    """A2. source 传入但与 copyfrom_path 不一致时应带 warning，但仍返回解析结果。"""
    print("[A2] source 不一致产生 warning")

    def fake_run(cmd, **kwargs):
        return _FakeCompletedProcess(stdout=XML_WITH_COPYFROM, returncode=0)

    merge_dir = svn_history.MERGE_DIR
    branch_dir = merge_dir / "branches" / "branch_a"
    branch_dir.mkdir(parents=True, exist_ok=True)
    try:
        with mock.patch.object(svn_history.subprocess, "run", side_effect=fake_run):
            res = svn_history.branch_point(path="branches/branch_a", source="/trunk/other_table")
    finally:
        try:
            branch_dir.rmdir()
            (merge_dir / "branches").rmdir()
        except OSError:
            pass

    _check("ok=True", res.get("ok") is True, str(res))
    _check("warning 字段存在", "warning" in res, str(res))


def scenario_b_without_copyfrom():
    """B. 无 copyfrom 记录（新建路径）：降级为首次提交版本号-1，inferred=True。"""
    print("[B] 无 copyfrom 记录（新建路径）")

    def fake_run(cmd, **kwargs):
        return _FakeCompletedProcess(stdout=XML_WITHOUT_COPYFROM, returncode=0)

    merge_dir = svn_history.MERGE_DIR
    sub_dir = merge_dir / "sub_y"
    sub_dir.mkdir(parents=True, exist_ok=True)
    try:
        with mock.patch.object(svn_history.subprocess, "run", side_effect=fake_run):
            res = svn_history.branch_point(path="sub_y", source=None)
    finally:
        try:
            sub_dir.rmdir()
        except OSError:
            pass

    _check("ok=True", res.get("ok") is True, str(res))
    _check("copyfrom_rev=9 (10-1)", res.get("copyfrom_rev") == 9, str(res.get("copyfrom_rev")))
    _check("inferred=True", res.get("inferred") is True, str(res.get("inferred")))
    _check("copyfrom_path 回退为 path 本身", res.get("copyfrom_path") == "sub_y", str(res.get("copyfrom_path")))


def scenario_c_svn_unavailable():
    """C. svn CLI 不可用：应返回 ok=False, error_code=svn_unavailable，而非抛异常/500。"""
    print("[C] svn CLI 不可用")

    def fake_run(cmd, **kwargs):
        raise FileNotFoundError("svn not found")

    merge_dir = svn_history.MERGE_DIR
    sub_dir = merge_dir / "sub_z"
    sub_dir.mkdir(parents=True, exist_ok=True)
    try:
        with mock.patch.object(svn_history.subprocess, "run", side_effect=fake_run):
            res = svn_history.branch_point(path="sub_z", source=None)
    finally:
        try:
            sub_dir.rmdir()
        except OSError:
            pass

    _check("ok=False", res.get("ok") is False, str(res))
    _check("error_code=svn_unavailable", res.get("error_code") == "svn_unavailable", str(res.get("error_code")))
    _check("message 非空", bool(res.get("message")), str(res))


def main():
    scenario_a_with_copyfrom()
    scenario_a2_source_mismatch_warning()
    scenario_b_without_copyfrom()
    scenario_c_svn_unavailable()

    print(f"\n{'='*40}")
    print(f"branch-point 验证结果: {_passed} PASS / {_failed} FAIL")
    return 0 if _failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
