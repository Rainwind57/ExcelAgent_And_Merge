"""R20 + R21 验证脚本。

R20: SheetDataPage.columns_meta 始终含列名+列号（同名列消歧）
R21: include_columns=True 时同时返回 columns（列约束），单次取数据+约束

用法:
    python -m server.tests.verify_r20_r21
    python -X utf8 -m server.tests.verify_r20_r21
"""
from __future__ import annotations

import os
import sys

sys.path.insert(0, str(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from services.agent_service import get_agent_service

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def main():
    svc = get_agent_service()
    stem, sheet = "fabao", "Fabao"

    print("[R20] columns_meta 列名+列号")
    r = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
    _check("返回非空", r is not None)
    if r is None:
        print(f"\n{'='*40}\nR20+R21 验证中止：sheet data 为空")
        return 1
    _check("columns_meta 非空", len(r.columns_meta) > 0, f"len={len(r.columns_meta)}")
    _check("列号 1-based 递增",
           [c.col_index for c in r.columns_meta] == list(range(1, len(r.columns_meta) + 1)),
           str([c.col_index for c in r.columns_meta]))
    _check("含 '名称' 列", any(c.name == "名称" for c in r.columns_meta),
           str([(c.col_index, c.name) for c in r.columns_meta]))
    # 验证 col_index 与 headers 位置对应
    _check("columns_meta 与 headers 对齐",
           all(c.name == (str(h).split(":")[0].strip() if h else "")
               for c, h in zip(r.columns_meta, r.headers) if c.col_index <= len(r.headers)),
           "位置/名称一致")

    print("[R20] 同名列消歧模拟")
    # 法宝表 Fabao sheet 是否有同名列？检查并验证 columns_meta 能区分
    name_counts: dict[str, int] = {}
    for c in r.columns_meta:
        name_counts[c.name] = name_counts.get(c.name, 0) + 1
    dupes = {n: cnt for n, cnt in name_counts.items() if cnt > 1}
    if dupes:
        print(f"    发现同名列: {dupes}")
        for n in dupes:
            idxs = [c.col_index for c in r.columns_meta if c.name == n]
            _check(f"同名列 '{n}' 有不同 col_index", len(set(idxs)) == len(idxs), str(idxs))
    else:
        print(f"    Fabao sheet 无同名列（正常），消歧逻辑待同名列场景验证")
        _check("无同名列时 columns_meta 仍可用", len(r.columns_meta) >= 3)

    print("[R21] include_columns=False（默认）columns 为空")
    r2 = svc.get_sheet_data(stem, sheet, page=1, page_size=5, include_columns=False)
    _check("columns 为空", r2 is not None and len(r2.columns) == 0)

    print("[R21] include_columns=True columns 非空")
    r3 = svc.get_sheet_data(stem, sheet, page=1, page_size=5, include_columns=True)
    _check("columns 非空", r3 is not None and len(r3.columns) > 0,
           f"len={len(r3.columns) if r3 else 0}")
    if r3 and r3.columns:
        fc = r3.columns[0]
        _check("FormColumn 含 col 号", fc.col >= 1, f"col={fc.col}")
        _check("FormColumn 含 col_name", bool(fc.col_name), fc.col_name)
        # columns 与 columns_meta 列号对齐
        _check("columns 与 columns_meta 列数一致",
               len(r3.columns) == len(r3.columns_meta),
               f"cols={len(r3.columns)} meta={len(r3.columns_meta)}")

    print("[R21] 单次请求含数据+约束（减少往返）")
    _check("rows 非空", r3 is not None and len(r3.rows) > 0)
    _check("columns 非空", r3 is not None and len(r3.columns) > 0)
    _check("columns_meta 非空", r3 is not None and len(r3.columns_meta) > 0)

    print(f"\n{'='*40}")
    print(f"R20+R21 验证结果: {_passed} PASS / {_failed} FAIL")
    return 0 if _failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
