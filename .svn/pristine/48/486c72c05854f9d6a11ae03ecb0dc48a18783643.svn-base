"""M3 路由层集成测试：compare-folder?base=trunk + restore-row + merge 阻断。"""
import sys, os, json
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from fastapi.testclient import TestClient
from main import app

client = TestClient(app)

passed = 0
failed = 0


def check(name, cond, detail=''):
    global passed, failed
    if cond:
        passed += 1
        print(f'  PASS  {name}')
    else:
        failed += 1
        print(f'  FAIL  {name}  {detail}')


print('=== M3 路由层：compare-folder?base=trunk ===')
# 只选 ability_missing.xlsx，trunk 自动注入
resp = client.post('/api/compare-folder?base=trunk', json={'selected': ['ability_missing.xlsx']})
check('compare-folder 200', resp.status_code == 200, f'status={resp.status_code} body={resp.text[:300]}')

if resp.status_code == 200:
    body = resp.json()
    session_id = body.get('session_id', '')
    check('session_id = __merge_folder__', session_id == '__merge_folder__', session_id)
    groups = body.get('groups', {})
    check('含 ability 分组', 'ability' in groups, list(groups.keys()))
    if 'ability' in groups:
        g = groups['ability']
        check('base_file = ability.xlsx (trunk)', g['base_file'] == 'ability.xlsx', g['base_file'])
        check('files 含 trunk + missing', 'ability.xlsx' in g['files'] and 'ability_missing.xlsx' in g['files'], g['files'])
        sheets = g.get('sheets', {})
        check('含 Ability sheet', 'Ability' in sheets, list(sheets.keys()))
        if 'Ability' in sheets:
            sd = sheets['Ability']
            stats = sd.get('stats', {})
            check('stats.missing_rows = 2', stats.get('missing_rows') == 2, stats)
            missing_rows = [r for r in sd['rows'] if r['row_type'] == 'missing_row']
            pks = sorted(r['key'] for r in missing_rows)
            check('missing_row pks = [1002, 7013]', pks == ['1002', '7013'], pks)
            check('missing_rows 摘要非空', len(sd.get('missing_rows', [])) == 2, sd.get('missing_rows'))
            # 验证 missing_row 的 cells 含 trunk 值
            if missing_rows:
                mr = missing_rows[0]
                check('missing_row cells 非空', len(mr['cells']) > 0)
                first_cell = mr['cells'][0]
                check('cell.versions 含 trunk 基准', 'ability.xlsx' in first_cell.get('versions', {}), first_cell)

print('=== M3 路由层：restore-row 接口 ===')
if resp.status_code == 200 and 'ability' in resp.json().get('groups', {}):
    restore_resp = client.post('/api/diff/merge-session/__merge_folder__/restore-row', json={
        'group_name': 'ability',
        'base_file': 'ability.xlsx',
        'sheet': 'Ability',
        'pk': '1002',
    })
    check('restore-row 200', restore_resp.status_code == 200, f'status={restore_resp.status_code} body={restore_resp.text[:300]}')
    if restore_resp.status_code == 200:
        rb = restore_resp.json()
        check('restore ok=True', rb.get('ok') is True, rb)
        check('restore pk=1002', rb.get('pk') == '1002', rb)
        check('restore cells 非空', len(rb.get('cells', [])) > 0, rb.get('cells'))
        check('restore sheet=Ability', rb.get('sheet') == 'Ability', rb)
        # 第一个 cell 的 value 应是 1002（trunk 该行第一列）
        if rb.get('cells'):
            check('restore cell[0].value=1002', str(rb['cells'][0].get('value')) == '1002', rb['cells'][0])

    # restore 不存在的 pk → 404
    resp404 = client.post('/api/diff/merge-session/__merge_folder__/restore-row', json={
        'group_name': 'ability', 'base_file': 'ability.xlsx', 'sheet': 'Ability', 'pk': '999999',
    })
    check('restore 不存在 pk → 404', resp404.status_code == 404, f'status={resp404.status_code}')

    # restore 不存在的 sheet → 400
    resp400 = client.post('/api/diff/merge-session/__merge_folder__/restore-row', json={
        'group_name': 'ability', 'base_file': 'ability.xlsx', 'sheet': 'NoSuchSheet', 'pk': '1002',
    })
    check('restore 不存在 sheet → 400', resp400.status_code == 400, f'status={resp400.status_code}')

print('=== M3 路由层：merge 阻断导出 ===')
if resp.status_code == 200 and 'ability' in resp.json().get('groups', {}):
    g = resp.json()['groups']['ability']
    sd = g['sheets']['Ability']
    # 构造含 missing_row 的 merge 请求（直接用 compare 返回的 rows）
    merge_req = {
        'group_name': 'ability',
        'session_id': '__merge_folder__',
        'base_file': g['base_file'],
        'sheets': [{'name': 'Ability', 'headers': sd['headers'], 'rows': sd['rows']}],
    }
    merge_resp = client.post('/api/merge', json=merge_req)
    check('merge 含 missing_row → 400 阻断', merge_resp.status_code == 400, f'status={merge_resp.status_code}')
    if merge_resp.status_code == 400:
        detail = merge_resp.json().get('detail', '')
        check('阻断信息含 1002', '1002' in detail, detail[:200])
        check('阻断信息含 7013', '7013' in detail, detail[:200])
        check('阻断信息含 "漏行未补回"', '漏行未补回' in detail, detail[:200])

    # 模拟补回：把 missing_row 行的 row_type 改成 matched → 应允许导出
    restored_rows = []
    for r in sd['rows']:
        rcopy = dict(r)
        if rcopy['row_type'] == 'missing_row':
            rcopy['row_type'] = 'matched'
            rcopy['restored'] = True
        restored_rows.append(rcopy)
    merge_req2 = {
        'group_name': 'ability',
        'session_id': '__merge_folder__',
        'base_file': g['base_file'],
        'sheets': [{'name': 'Ability', 'headers': sd['headers'], 'rows': restored_rows}],
    }
    merge_resp2 = client.post('/api/merge', json=merge_req2)
    check('补回后 merge → 200 通过', merge_resp2.status_code == 200, f'status={merge_resp2.status_code} body={merge_resp2.text[:200]}')

print('=== M3 路由层：无 base=trunk → 无 missing_row（普通 deleted）===')
resp2 = client.post('/api/compare-folder', json={'selected': ['ability.xlsx', 'ability_missing.xlsx']})
check('无 base=trunk 200', resp2.status_code == 200, f'status={resp2.status_code}')
if resp2.status_code == 200:
    g2 = resp2.json().get('groups', {}).get('ability', {})
    sd2 = g2.get('sheets', {}).get('Ability', {})
    stats2 = sd2.get('stats', {})
    check('无 trunk 模式 → missing_rows=0', stats2.get('missing_rows') == 0, stats2)
    deleted2 = [r for r in sd2.get('rows', []) if r['row_type'] == 'deleted']
    check('无 trunk 模式 → deleted=2', len(deleted2) == 2, f'deleted={len(deleted2)}')

print(f'\n=== 结果：{passed} PASS / {failed} FAIL ===')
sys.exit(1 if failed else 0)
