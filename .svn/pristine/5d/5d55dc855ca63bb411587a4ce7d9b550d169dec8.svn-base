"""三阶段合并回归 + 公式缓存 + 过期提示验证（add-cross-producer-consolidation）。

  6.6 公式缓存：match_stat 三阶段导出后公式文本不丢（均走 _save_with_formula_cache）
  6.7 兼容性：旧扁平流程 _build_groups_from_paths 不退化，CompareResponse 默认 conflict_origin=""
  额外：阶段3 过期提示 — 综合版本产出后 trunk 被改动 → staleness_warning 非空

用法:
    python -X utf8 -m server.tests.verify_two_stage_extra
"""
from __future__ import annotations

import asyncio
import copy
import os
import re
import shutil
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from engine.models import MergeRequest, SheetMergeData, CompareResponse
from agent.excel.formula_cache_validator import _has_formulas, snapshot_formulas
from routers import merge_stages as ms
from routers.merge_stages import (
    Stage1CompareRequest, Stage2CrossCompareRequest, Stage3CompareRequest,
    stage1_compare, stage1_consolidate, stage2_compare, stage2_consolidate,
    stage3_compare, stage3_apply,
    DEVBRANCH_DIR, TRUNK_DIR, SRC_DIR, STAGE1_MANIFEST, STAGE2_MANIFEST, ARCHIVE_DIR,
    _intermediate_name, _consolidated_name, _read_manifest, _read_stage2_manifest,
)
from routers.diff import _build_groups_from_paths
from config import MERGE_DIR, MERGE_SAMPLES_DIR, MERGE_LEGACY_DIR

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    print(f"  [{'PASS' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def _resolved_sheets(group):
    sheets = []
    for s in group.sheets.values():
        rows = copy.deepcopy(s.rows)
        for row in rows:
            for cell in row.cells:
                if getattr(cell, "conflict", False):
                    cell.conflict = False
        sheets.append(SheetMergeData(name=s.name, headers=s.headers, rows=rows))
    return sheets


def _formula_count(path: Path) -> int:
    return len(snapshot_formulas(path))


async def _run():
    # ── 6.6 公式缓存（match_stat 三阶段）──
    print("\n--- 6.6 公式缓存（match_stat 三阶段导出）---")
    GROUP = "match_stat"
    BRANCH = "devbranch1"
    trunk_base = TRUNK_DIR / f"{GROUP}.xlsx"
    inter_name = _intermediate_name(GROUP, BRANCH)
    cons_name = _consolidated_name(GROUP)
    created_out = None

    if not trunk_base.is_file():
        _check("trunk match_stat 存在（跳过）", False, str(trunk_base))
    else:
        has_f = _has_formulas(trunk_base)
        base_fcount = _formula_count(trunk_base)
        print(f"  (info) trunk match_stat 含公式={has_f}, 公式单元格数={base_fcount}")

        # 清理残留
        if STAGE1_MANIFEST.is_file():
            STAGE1_MANIFEST.unlink()
        if STAGE2_MANIFEST.is_file():
            STAGE2_MANIFEST.unlink()
        if (DEVBRANCH_DIR / inter_name).is_file():
            (DEVBRANCH_DIR / inter_name).unlink()
        if (DEVBRANCH_DIR / cons_name).is_file():
            (DEVBRANCH_DIR / cons_name).unlink()
        for fp in TRUNK_DIR.glob(f"{GROUP}_*.xlsx"):
            if fp.is_file():
                fp.unlink()

        # 阶段1
        resp1 = await stage1_compare(Stage1CompareRequest(branch=BRANCH, group_name=GROUP))
        res1 = await stage1_consolidate(MergeRequest(
            branch=BRANCH, group_name=GROUP,
            sheets=_resolved_sheets(resp1.groups[GROUP]),
        ))
        inter_path = DEVBRANCH_DIR / inter_name
        inter_fcount = _formula_count(inter_path)
        _check("阶段1 中间版本公式文本保留", inter_fcount >= base_fcount if has_f else True,
               f"base={base_fcount}, inter={inter_fcount}")

        # 阶段2 综合（单生产者退化拷贝，公式文本应保留）
        resc = await stage2_consolidate(MergeRequest(
            group_name=GROUP, branch="", sheets=[],
        ))
        cons_path = DEVBRANCH_DIR / cons_name
        cons_fcount = _formula_count(cons_path)
        _check("阶段2 综合版本公式文本保留",
               cons_fcount >= base_fcount if has_f else True,
               f"base={base_fcount}, cons={cons_fcount} ({resc.get('cache_message','')})")

        # ── 过期提示：把 trunk mtime 推到综合版本产出之后（须在合回消费前测）──
        print("\n--- 额外：阶段3 过期提示 ---")
        future = time.time() + 3600
        os.utime(trunk_base, (future, future))
        resp3 = await stage3_compare(Stage3CompareRequest(group_name=GROUP))
        _check("trunk 被改动后 staleness_warning 非空", bool(resp3.staleness_warning),
               (resp3.staleness_warning or "")[:40])

        # ── 阶段3 合回（消费综合版本）──
        res3 = await stage3_apply(MergeRequest(
            group_name=GROUP, branch="",
            sheets=_resolved_sheets(resp3.groups[GROUP]),
        ))
        created_out = TRUNK_DIR / res3["output"]
        out_fcount = _formula_count(created_out)
        _check("阶段3 合回产物公式文本保留", out_fcount >= base_fcount if has_f else True,
               f"base={base_fcount}, out={out_fcount}")
        _check("三阶段均报告缓存处理结果",
               "cache_message" in res1 and "cache_message" in resc and "cache_message" in res3,
               f"s1='{res1.get('cache_message')}' s2='{resc.get('cache_message')}' s3='{res3.get('cache_message')}'")
        _check("合回后综合版本已消费（stage2 manifest 无记录）",
               cons_name not in _read_stage2_manifest(), f"archived={res3.get('archived')}")
        _check("合回后综合版本文件已移除", not cons_path.is_file(), str(cons_path.name))

        # 清理（综合版本已被合回消费/归档，这里清归档 + manifest + 产出）
        if inter_path.is_file():
            inter_path.unlink()
        if cons_path.is_file():
            cons_path.unlink()
        if STAGE1_MANIFEST.is_file():
            STAGE1_MANIFEST.unlink()
        if STAGE2_MANIFEST.is_file():
            STAGE2_MANIFEST.unlink()
        if created_out and created_out.is_file():
            created_out.unlink()
        if ARCHIVE_DIR.is_dir():
            shutil.rmtree(ARCHIVE_DIR, ignore_errors=True)

    # ── 6.7 旧扁平流程回归 ──
    print("\n--- 6.7 旧扁平流程回归（_build_groups_from_paths）---")
    # 整理后散文件归入子目录：samples/ability.xlsx（基准）+ legacy/ability_1..4.xlsx
    paths = [str(p) for d in (MERGE_SAMPLES_DIR, MERGE_LEGACY_DIR) for p in d.glob("ability*.xlsx")
             if not p.name.startswith("~$") and "missing" not in p.name]
    _check("找到旧流程样本 ability*", len(paths) >= 2, f"{len(paths)} 个")
    if len(paths) >= 2:
        groups = _build_groups_from_paths(paths)
        _check("旧流程分组构建成功", "ability" in groups, ",".join(groups.keys()))
        g = groups["ability"]
        _check("旧流程基准自动检测=ability.xlsx", g.base_file == "ability.xlsx", g.base_file)
        # 默认 CompareResponse 不带 conflict_origin
        resp = CompareResponse(groups=groups, session_id="x")
        _check("旧流程 conflict_origin 默认空", resp.conflict_origin == "", repr(resp.conflict_origin))
        _check("旧流程 staleness_warning 默认空", resp.staleness_warning == "")


def main():
    print("=" * 60)
    print("三阶段合并回归 + 公式缓存 + 过期提示（6.6/6.7）")
    print("=" * 60)
    asyncio.run(_run())
    print("\n" + "=" * 60)
    print(f"结果: {_passed} 通过, {_failed} 失败")
    print("=" * 60)
    sys.exit(1 if _failed else 0)


if __name__ == "__main__":
    main()
