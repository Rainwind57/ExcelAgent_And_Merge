"""表级并行 compare 调度（#32）。

compare_sheet 是纯 CPU（cell 比对 + 公式求值），GIL 下 sheet/表级 ThreadPool 几乎
无收益（R3 实测表级并行 0.96x）。本模块在表数足够（>= MERGE_PROCESS_THRESHOLD，
默认 9999）时切 ProcessPoolExecutor，让 compare_sheet 跨进程真并行；表数少时仍用
ThreadPool（IO 段 read_group_files/svn 释放 GIL，小表启动成本不划算）。

Windows spawn 下子进程重新 import 整个模块树，若 worker 模块链中包含重依赖
（LLM client / agent_service / 后台线程 / file_watcher）会死锁。因此默认关闭
ProcessPool（阈值 9999），仅在 worker 模块完全隔离且经充分验证后降低阈值。

ProcessPool 失败（pickling/import/hang）自动回退 ThreadPool，保证兼容。
worker_fn 须为 module-level 轻量函数，不得间接 import agent_service 等重依赖。

worker_fn 入参为单个 table_name，返回 (table_name, FileGroup)。调用方负责把共享
缓存（rev_cache/bp_cache）经 partial 绑定为只读——_prefill_rev_cache 已预填。
"""
from __future__ import annotations

import logging
import os
from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed, TimeoutError
from typing import Callable, List, Tuple, TypeVar

logger = logging.getLogger(__name__)

T = TypeVar("T")

# 表数 >= 该阈值才启 ProcessPool（摊销 Windows spawn + 模块 import 启动成本）。
# 可用环境变量 MERGE_PROCESS_THRESHOLD 覆盖。
# 默认 9999 = 关闭 ProcessPool，待 worker 模块隔离完成后再降低。
_PROCESS_THRESHOLD = int(os.environ.get("MERGE_PROCESS_THRESHOLD", "9999"))
# 进程池上限（CPU 核数与 4 取小，避免过订阅；可用 MERGE_PROCESS_WORKERS 覆盖）
_MAX_PROCESS_WORKERS = int(os.environ.get("MERGE_PROCESS_WORKERS", "4"))
# 单表 ProcessPool 超时（秒），超时自动回退 ThreadPool
_PROCESS_TIMEOUT_PER_TABLE = int(os.environ.get("MERGE_PROCESS_TIMEOUT", "120"))


def _pick_workers(n_tables: int) -> int:
    if n_tables <= 1:
        return 1
    import multiprocessing
    return min(n_tables, _MAX_PROCESS_WORKERS, multiprocessing.cpu_count() or 4)


def parallel_map_tables(
    worker_fn: Callable[[str], Tuple[str, T]],
    table_names: List[str],
) -> List[Tuple[str, T]]:
    """并行跑 worker_fn(table_name) → (table_name, result)。

    表数 >= _PROCESS_THRESHOLD 用 ProcessPool（compare_sheet 真并行）；
    否则 ThreadPool（小表 IO 段仍释放 GIL，省进程启动开销）。
    ProcessPool 超时/失败自动回退 ThreadPool。
    """
    workers = _pick_workers(len(table_names))
    if workers <= 1 or len(table_names) <= 1:
        return [worker_fn(gn) for gn in table_names]

    use_process = len(table_names) >= _PROCESS_THRESHOLD
    if use_process:
        try:
            with ProcessPoolExecutor(max_workers=workers) as ex:
                futures = {ex.submit(worker_fn, gn): gn for gn in table_names}
                results: List[Tuple[str, T]] = []
                for future in as_completed(futures, timeout=_PROCESS_TIMEOUT_PER_TABLE):
                    try:
                        results.append(future.result(timeout=30))
                    except Exception as exc:
                        # 单表失败不拖垮整批，记日志继续
                        logger.warning("ProcessPool 单表 compare 失败: %s", exc)
                return results
        except TimeoutError:
            logger.warning(
                "ProcessPool compare 超时(timeout=%ds)，回退 ThreadPool",
                _PROCESS_TIMEOUT_PER_TABLE,
            )
        except Exception as e:
            logger.warning("ProcessPool compare 失败，回退 ThreadPool: %s", e)
    with ThreadPoolExecutor(max_workers=workers) as ex:
        return list(ex.map(worker_fn, table_names))
