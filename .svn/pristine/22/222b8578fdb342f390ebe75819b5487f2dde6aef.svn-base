"""管道核心数据类：复用 AgentResult 模式,定义管道各步的输入输出契约。

设计:
- PipelineContext: 跨步累积状态(拆解结果/分区/fragments/produces)
- StepResult: 单步执行结果
- PipelineResult: 管道最终结果(含 errors 聚合 + ok 汇总)
- AgentFragment: SubAgent 产出单元(含 produces placeholder + sql_or_ops)
- DocIntent: 文件解析产出(步骤卡片 + 符号映射表)
- StepCard: 单步卡片(标题/内容/涉及元素)
"""

from __future__ import annotations

from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Optional


@dataclass
class StepCard:
    """文件解析产出的单步卡片。

    Attributes:
        step_id: 步骤编号(如 "1.1")
        title: 步骤标题
        content: 步骤内容(非对话部分,如旁白/交互描述)
        involved_elements: 涉及的实体列表,每项 {"type","symbol","name"}
        branches: 分支信息(如选项跳转),无分支为空
        dialog_fragments: 对话片段列表,每项 {"speaker","text","symbol"}
    """
    step_id: str = ""
    title: str = ""
    content: str = ""
    involved_elements: list[dict] = field(default_factory=list)
    branches: list[dict] = field(default_factory=list)
    dialog_fragments: list[dict] = field(default_factory=list)


@dataclass
class DocIntent:
    """文件解析产出的结构化意图。

    Attributes:
        source_path: 源文件路径
        file_type: 文件类型(md/xlsx/csv/txt)
        steps: 步骤卡片列表(md 才有,xlsx/csv 为空)
        records: 行记录列表(xlsx/csv 才有,每行一 dict)
        symbol_map: 符号映射表 {"<placeholder>": "原始名"}
        raw_text: 原始文本(txt 降级用)
        ok: 解析是否成功
        error: 失败时的错误信息
    """
    source_path: str = ""
    file_type: str = ""
    steps: list[StepCard] = field(default_factory=list)
    records: list[dict] = field(default_factory=list)
    symbol_map: dict[str, str] = field(default_factory=dict)
    raw_text: str = ""
    ok: bool = True
    error: str = ""

    def add_symbol(self, placeholder: str, name: str) -> None:
        """分配符号到映射表,重复名复用已有符号。"""
        # 反查:已有同名则复用
        for ph, nm in self.symbol_map.items():
            if nm == name:
                return
        self.symbol_map[placeholder] = name


@dataclass
class AgentFragment:
    """SubAgent 产出单元:含 placeholder 声明 + SQL片段/操作列表 + thinking。

    Attributes:
        agent_name: 产出该 fragment 的 SubAgent 名(如 "Dialog配表专家")
        produces: 该 fragment 声明产出的 placeholder 符号(如 "<npc_laochen>")
        references: 该 fragment 引用的其他 placeholder 列表
        sql_or_ops: 生成的 SQL 片段或操作列表
        thinking_steps: 思考步骤,每项 {"phase","detail"}
        ok: 是否成功
        error: 失败详情
        target_table: 目标表 stem(供 Step4 汇总排序)
        target_sheet: 目标 sheet
    """
    agent_name: str = ""
    produces: Optional[str] = None
    references: list[str] = field(default_factory=list)
    sql_or_ops: list[Any] = field(default_factory=list)
    thinking_steps: list[dict] = field(default_factory=list)
    ok: bool = True
    error: str = ""
    target_table: str = ""
    target_sheet: str = ""


@dataclass
class StepResult:
    """单步执行结果。

    Attributes:
        step_id: 步骤标识(如 "1_decompose"/"3_fill"/"6_write")
        name: 步骤名
        status: done/failed/pending
        output: 产物路径或描述
        error: 失败详情
        artifacts: 产物文件路径列表
    """
    step_id: str = ""
    name: str = ""
    status: str = "pending"
    output: str = ""
    error: str = ""
    artifacts: list[str] = field(default_factory=list)


@dataclass
class PipelineContext:
    """跨步累积状态:Step 间通过此对象传递。

    Attributes:
        input_path: 输入文件路径
        output_dir: 输出目录
        workspace: 工作区逻辑名
        session_id: 会话 id
        doc_intent: Step1 产出的 DocIntent
        partitions: Step2 确认的分区信息 {"<表>": "<分区/sheet>"}
        fragments: Step3 各 SubAgent 产出的 fragment 列表
        produced: Step4 汇总后的真实 ID 映射 {"<placeholder>": "<真实ID>"}
        sub_tasks: Step4 装配的子任务列表(复用 AgentResult.sub_tasks 模式)
        steps: 各步 StepResult
        retry_count: 回退计数(Step5→Step3 回退)
    """
    input_path: str = ""
    output_dir: str = ""
    workspace: str = ""
    session_id: str = ""
    doc_intent: Optional[DocIntent] = None
    partitions: dict[str, str] = field(default_factory=dict)
    fragments: list[AgentFragment] = field(default_factory=list)
    produced: dict[str, str] = field(default_factory=dict)
    sub_tasks: list[dict] = field(default_factory=list)
    steps: dict[str, StepResult] = field(default_factory=dict)
    retry_count: int = 0

    def add_step(self, step_id: str, name: str) -> StepResult:
        """登记一步,返回 StepResult 供填充。"""
        sr = StepResult(step_id=step_id, name=name)
        self.steps[step_id] = sr
        return sr


@dataclass
class PipelineResult:
    """管道最终结果:含 errors 聚合 + ok 汇总。

    复用 AgentResult 模式:ok 初始 None,步骤失败置 False,全成功置 True。
    errors 列表聚合所有步骤错误(每项 {step,error,ok})。
    message 按 7 步聚合生成。
    """
    ok: Optional[bool] = None
    steps: list[StepResult] = field(default_factory=list)
    errors: list[dict] = field(default_factory=list)
    sub_tasks: list[dict] = field(default_factory=list)
    produced: dict[str, str] = field(default_factory=dict)
    message: str = ""
    # 诊断标记(复用 AgentResult 语义)
    index_dirty: bool = False
    dirty_data: bool = False
    failed_tables: list = field(default_factory=list)
    # 汇总报告路径(Step7 产出)
    report_path: str = ""

    def add_error(self, step: str, error: str) -> None:
        """聚合错误:Step4 失败标 dirty_data,Step5 标规则名。"""
        self.errors.append({"step": step, "error": error, "ok": False})
        self.ok = False

    @property
    def aggregated_message(self) -> str:
        """7 步聚合消息:成功列步骤名,失败列首失败步。"""
        if self.ok is None:
            return "未完成"
        if self.ok:
            names = "、".join(s.name for s in self.steps) or "完成"
            return f"成功：{names}"
        for e in self.errors:
            return f"失败：{e['step']} - {e['error']}"
        return "失败"
