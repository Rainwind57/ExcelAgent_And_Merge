"""R26 操作历史 + 回滚验证脚本。

验证点：
  A. cell/update 写值后记录历史 — list_history 含该记录
  B. 回滚 cell_update — 值改回旧值
  C. batch_update 记录每列历史
  D. row/delete 记录历史 + 回滚重插
  E. row/insert 记录历史 + 回滚删除
  F. 查询近 N 小时 + 表不存在边界

注意：会真实写盘，测前备份 fabao.xlsx，测后还原。
"""
from __future__ import annotations

import os
import sys
import shutil
from pathlib import Path

sys.path.insert(0, str(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from services.agent_service import get_agent_service
from models.agent_models import CellUpdateRequest, BatchCellUpdateRequest, BatchCellUpdateItem, RowDeleteRequest, RowInsertRequest
from engine.table_history import list_history, get_record

_passed = 0
_failed = 0


def _check(name: str, ok: bool, detail: str = "") -> bool:
    global _passed, _failed
    _passed += 1 if ok else 0
    _failed += 0 if ok else 1
    mark = "PASS" if ok else "FAIL"
    print(f"  [{mark}] {name}{(' — ' + detail) if detail else ''}")
    return ok


def main():
    svc = get_agent_service()
    stem, sheet = "fabao", "Fabao"
    res_path = Path("resources/fabao.xlsx")
    backup = Path("resources/_fabao_backup_r26.xlsx")
    shutil.copy2(res_path, backup)
    print(f"已备份 fabao.xlsx → {backup.name}")

    # 清理历史文件避免干扰
    hist_file = Path("resources/.history/fabao/Fabao.jsonl")
    if hist_file.exists():
        hist_file.unlink()

    try:
        data0 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
        row5 = data0.data_start
        orig_val = data0.rows[0][2]  # 图标列原值

        print("[A] cell/update 记录历史")
        r = svc.update_cell(CellUpdateRequest(
            table_stem=stem, sheet=sheet, row=row5, col=3, value="Icon_hist_test.png"))
        _check("写值 ok", r.ok)
        hist = list_history(stem, sheet=sheet, since_hours=1)
        _check("历史非空", len(hist) > 0, f"len={len(hist)}")
        _check("含 cell_update 记录", any(h.get("op") == "cell_update" for h in hist))
        rec = next(h for h in hist if h.get("op") == "cell_update")
        _check("old_value 正确", str(rec.get("old_value")) == str(orig_val), str(rec.get("old_value")))
        _check("new_value 正确", str(rec.get("new_value")) == "Icon_hist_test.png")
        _check("record_id 非空", bool(rec.get("record_id")))

        print("[B] 回滚 cell_update")
        rid = rec["record_id"]
        rb = svc.rollback_history(rid)
        _check("回滚 ok", rb.ok, f"msg={rb.message}")
        data1 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
        _check("值已还原", str(data1.rows[0][2]) == str(orig_val),
               f"{data1.rows[0][2]} vs {orig_val}")

        print("[C] batch_update 记录每列历史")
        r = svc.update_cells_batch(BatchCellUpdateRequest(
            table_stem=stem, sheet=sheet, row=row5, atomic=True,
            updates=[BatchCellUpdateItem(col=3, value="Icon_b1.png"),
                     BatchCellUpdateItem(col=4, value="批改描述")]))
        _check("批量写 ok", r.ok)
        hist = list_history(stem, sheet=sheet, since_hours=1)
        batch_recs = [h for h in hist if h.get("op") == "batch_update"]
        _check("2 条 batch_update 记录", len(batch_recs) >= 2, f"len={len(batch_recs)}")

        print("[D] row/delete 记录历史 + 回滚重插")
        data2 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
        n_before = data2.total_rows
        r = svc.delete_row(RowDeleteRequest(table_stem=stem, sheet=sheet, row=row5))
        _check("删行 ok", r.ok)
        hist = list_history(stem, sheet=sheet, since_hours=1)
        del_rec = next((h for h in hist if h.get("op") == "row_delete"), None)
        _check("含 row_delete 记录", del_rec is not None)
        _check("记录含 deleted_values", del_rec and "deleted_values" in (del_rec.get("extra") or {}))
        # 回滚重插
        if del_rec:
            rb = svc.rollback_history(del_rec["record_id"])
            _check("回滚重插 ok", rb.ok, f"msg={rb.message}")
            data3 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
            _check("行数还原", data3.total_rows == n_before, f"{n_before}→{data3.total_rows}")

        print("[E] row/insert 记录历史 + 回滚删除")
        data4 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
        n_before2 = data4.total_rows
        r = svc.insert_row(RowInsertRequest(
            table_stem=stem, sheet=sheet, row=row5, values={"1": "777", "2": "回滚插行测试"}))
        _check("插行 ok", r.ok)
        hist = list_history(stem, sheet=sheet, since_hours=1)
        ins_rec = next((h for h in hist if h.get("op") == "row_insert"), None)
        _check("含 row_insert 记录", ins_rec is not None)
        if ins_rec:
            rb = svc.rollback_history(ins_rec["record_id"])
            _check("回滚删除 ok", rb.ok, f"msg={rb.message}")
            data5 = svc.get_sheet_data(stem, sheet, page=1, page_size=10)
            _check("行数还原", data5.total_rows == n_before2, f"{n_before2}→{data5.total_rows}")

        print("[F] 查询边界")
        hist = list_history("不存在的表xyz", since_hours=1)
        _check("表不存在返回空", len(hist) == 0)
        rb = svc.rollback_history("不存在的record_id")
        _check("record 不存在 ok=False", not rb.ok)

    finally:
        shutil.copy2(backup, res_path)
        backup.unlink()
        # 清理历史文件
        if hist_file.exists():
            hist_file.unlink()
        print(f"\n已还原 fabao.xlsx（删除 {backup.name}）")

    print(f"\n{'='*40}")
    print(f"R26 验证结果: {_passed} PASS / {_failed} FAIL")
    return 0 if _failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
