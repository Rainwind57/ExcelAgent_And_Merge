{
  "topo_cases": [
    {
      "id": "linear_chain",
      "description": "NPC→interaction→conv→option 线性依赖链",
      "intents": [
        {"idx": 0, "produces": "new_prefab_id", "fields": {"prefab_id": "<new_prefab_id>"}},
        {"idx": 1, "produces": "new_interaction_id", "fields": {"interaction_id": "<new_interaction_id>", "prefab_ref": "<new_prefab_id>"}},
        {"idx": 2, "produces": "new_conv_id", "fields": {"conv_id": "<new_conv_id>", "interaction_ref": "<new_interaction_id>"}},
        {"idx": 3, "produces": "option_1_id", "fields": {"option_id": "<option_1_id>", "conv_ref": "<new_conv_id>"}}
      ],
      "constraints": [
        {"producer": 0, "consumer": 1},
        {"producer": 1, "consumer": 2},
        {"producer": 2, "consumer": 3}
      ]
    },
    {
      "id": "diamond_deps",
      "description": "菱形依赖：A→B, A→C, B→D, C→D（B/C 同层可并行）",
      "intents": [
        {"idx": 0, "produces": "base_id", "fields": {"id": "<base_id>"}},
        {"idx": 1, "produces": "b_id", "fields": {"id": "<b_id>", "ref": "<base_id>"}},
        {"idx": 2, "produces": "c_id", "fields": {"id": "<c_id>", "ref": "<base_id>"}},
        {"idx": 3, "produces": "d_id", "fields": {"id": "<d_id>", "b_ref": "<b_id>", "c_ref": "<c_id>"}}
      ],
      "constraints": [
        {"producer": 0, "consumer": 1},
        {"producer": 0, "consumer": 2},
        {"producer": 1, "consumer": 3},
        {"producer": 2, "consumer": 3}
      ]
    },
    {
      "id": "independent",
      "description": "无依赖独立意图（全并行，原序即合法）",
      "intents": [
        {"idx": 0, "produces": "", "fields": {"id": "1001"}},
        {"idx": 1, "produces": "", "fields": {"id": "1002"}},
        {"idx": 2, "produces": "", "fields": {"id": "1003"}}
      ],
      "constraints": []
    },
    {
      "id": "cycle_fallback",
      "description": "循环依赖（A↔B，回退原序，不阻断）",
      "intents": [
        {"idx": 0, "produces": "x_id", "fields": {"id": "<x_id>", "ref": "<y_id>"}},
        {"idx": 1, "produces": "y_id", "fields": {"id": "<y_id>", "ref": "<x_id>"}}
      ],
      "constraints": [],
      "expect_cycle": true
    },
    {
      "id": "multi_producer_seq",
      "description": "同基名多产出（option_1_id/option_2_id 有序键，conv 依赖两个 option）",
      "intents": [
        {"idx": 0, "produces": "conv_id", "fields": {"conv_id": "<conv_id>", "opt0": "<option_1_id>", "opt1": "<option_2_id>"}},
        {"idx": 1, "produces": "option_1_id", "fields": {"option_id": "<option_1_id>", "conv_ref": "<conv_id>"}},
        {"idx": 2, "produces": "option_2_id", "fields": {"option_id": "<option_2_id>", "conv_ref": "<conv_id>"}}
      ],
      "constraints": [
        {"producer": 1, "consumer": 0},
        {"producer": 2, "consumer": 0},
        {"producer": 0, "consumer": 1},
        {"producer": 0, "consumer": 2}
      ],
      "expect_cycle": true
    }
  ],
  "split_cases": [
    {
      "id": "npc_dialog",
      "input": "新增NPC铁匠老张model_id 1015，点击弹出对话'欢迎'，选项'锻造'和'离开'",
      "expected_intent_count": 5,
      "expected_tables": ["entity_prefab", "interaction"]
    },
    {
      "id": "reward_chain",
      "input": "新增奖励包reward_id 10066，包含道具1001x10和道具1002x5",
      "expected_intent_count": 3,
      "expected_tables": ["reward", "item"]
    }
  ],
  "rollback_scenarios": [
    {
      "id": "mid_chain_fail",
      "description": "3步链第2步失败，验证第3步跳过 + failed_tables 标记",
      "intents": [
        {"idx": 0, "produces": "a_id", "fields": {"id": "<a_id>"}},
        {"idx": 1, "produces": "b_id", "fields": {"id": "<b_id>", "ref": "<a_id>"}, "fail": true},
        {"idx": 2, "produces": "", "fields": {"ref": "<b_id>"}}
      ],
      "expect_failed_at": 1,
      "expect_skipped": [2]
    },
    {
      "id": "first_step_fail",
      "description": "首步失败，后续全跳过",
      "intents": [
        {"idx": 0, "produces": "a_id", "fields": {"id": "<a_id>"}, "fail": true},
        {"idx": 1, "produces": "b_id", "fields": {"id": "<b_id>", "ref": "<a_id>"}},
        {"idx": 2, "produces": "", "fields": {"ref": "<b_id>"}}
      ],
      "expect_failed_at": 0,
      "expect_skipped": [1, 2]
    },
    {
      "id": "independent_fail",
      "description": "独立意图失败：后续仍被跳过（事务语义），但前序不回滚（无依赖）",
      "intents": [
        {"idx": 0, "produces": "", "fields": {"id": "1"}},
        {"idx": 1, "produces": "", "fields": {"id": "2"}, "fail": true},
        {"idx": 2, "produces": "", "fields": {"id": "3"}}
      ],
      "expect_failed_at": 1,
      "expect_skipped": [2],
      "expect_rollback_prev": false
    }
  ]
}
