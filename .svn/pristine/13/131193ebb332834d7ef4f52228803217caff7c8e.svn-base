"""验证构造的 P0 样本。"""
import openpyxl
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def verify_formula():
    print("=== 公式表验证 ===")
    for name in ["formula_basic", "formula_lookup", "formula_nested"]:
        p = ROOT / "resources/qa_test/formula_samples" / f"{name}.xlsx"
        wb = openpyxl.load_workbook(p, data_only=False)
        formula_count = 0
        for ws in wb.worksheets:
            for row in ws.iter_rows():
                for c in row:
                    if isinstance(c.value, str) and c.value.startswith("="):
                        formula_count += 1
        # data_only 看缓存
        wb2 = openpyxl.load_workbook(p, data_only=True)
        cache_count = 0
        for ws in wb2.worksheets:
            for row in ws.iter_rows():
                for c in row:
                    if c.value is not None and not (isinstance(c.value, str) and c.value.startswith("=")):
                        # 原公式位置有缓存值
                        pass
        print(f"  {name}: {formula_count} 个公式单元格（openpyxl 写入无缓存，待 libreoffice 重算）")
        wb.close()
        wb2.close()


def verify_id_mgr():
    print("\n=== id_mgr 验证 ===")
    p = ROOT / "resources/id_mgr.xlsx"
    wb = openpyxl.load_workbook(p, data_only=True)
    print(f"  sheets: {wb.sheetnames}")
    ws = wb["SETTING"]
    print(f"  SETTING 表头: {[c.value for c in ws[1]]}")
    # 找越界项
    over = []
    for r in range(2, ws.max_row + 1):
        m, lo, hi, ulo, uhi, st = [ws.cell(r, c).value for c in range(1, 7)]
        if ulo is not None and uhi is not None:
            if ulo < lo or uhi > hi:
                over.append(f"{m}: {ulo}-{uhi} 越界 [{lo}-{hi}]")
    print(f"  越界模块（{len(over)} 个）:")
    for o in over:
        print(f"    {o}")
    wb.close()


def verify_merge_missing():
    print("\n=== merge 漏行样本验证 ===")
    # ability
    base = openpyxl.load_workbook(ROOT / "merge/ability.xlsx", read_only=True, data_only=True)
    miss = openpyxl.load_workbook(ROOT / "merge/ability_missing.xlsx", read_only=True, data_only=True)
    b_ids = {int(r[0]) for r in base["Ability"].iter_rows(min_row=3, values_only=True) if r and isinstance(r[0], (int, float))}
    m_ids = {int(r[0]) for r in miss["Ability"].iter_rows(min_row=3, values_only=True) if r and isinstance(r[0], (int, float))}
    print(f"  ability: base={len(b_ids)}行 miss={len(m_ids)}行 漏={sorted(b_ids-m_ids)}")
    base.close()
    miss.close()

    # item
    base = openpyxl.load_workbook(ROOT / "merge/item.xlsx", read_only=True, data_only=True)
    miss = openpyxl.load_workbook(ROOT / "merge/item_missing.xlsx", read_only=True, data_only=True)
    for sn in ["ItemBase", "Equipment"]:
        b_ids = set()
        m_ids = set()
        for r in base[sn].iter_rows(min_row=2, values_only=True):
            if r and r[0] is not None:
                try:
                    b_ids.add(int(str(r[0]).replace(",", "")))
                except ValueError:
                    pass
        for r in miss[sn].iter_rows(min_row=2, values_only=True):
            if r and r[0] is not None:
                try:
                    m_ids.add(int(str(r[0]).replace(",", "")))
                except ValueError:
                    pass
        print(f"  item.{sn}: base={len(b_ids)}行 miss={len(m_ids)}行 漏={sorted(b_ids-m_ids)}")
    base.close()
    miss.close()


if __name__ == "__main__":
    verify_formula()
    verify_id_mgr()
    verify_merge_missing()
    print("\n=== 验证完成 ===")
