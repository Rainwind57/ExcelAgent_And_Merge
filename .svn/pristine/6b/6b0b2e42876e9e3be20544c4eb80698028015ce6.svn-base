"""Skill 知识注入（P1 · 最高优先级）。

修复"skills 不起作用"根因：让 skill 知识在 **LLM 解析阶段** 生效，而非仅执行阶段。
为解析 prompt 提供三类 context：
  1. 完整实体→表路由（覆盖全部表，替代 codemaker_parser 里 7 条硬编码）
  2. 目标表真实列名候选（供 LLM 对齐用户所述字段）
  3. 目标列枚举值映射（供 LLM 归一化枚举）

数据源均只读并带内存缓存：
  - 表路由：sheet_aliases.yaml（别名→stem）+ 内置种子实体
  - 列名：_table_index.json（load_index）
  - 枚举：enum_mappings.yaml（EnumResolver）
"""

from __future__ import annotations

import os
from typing import Optional

from .llm_context import estimate_tokens


# 内置种子实体→stem 路由：口语常见实体，补充 sheet_aliases 未显式覆盖的通用别名
_SEED_ROUTE: dict[str, str] = {
    "灵兽": "pet", "宠物": "pet",
    "建筑": "building",
    "道具": "item",
    "英雄": "hero",
    "神通": "ability", "技能": "ability",
    "法宝": "fabao",
    "邮件": "mail",
    "帮派": "guild",
    "仙友": "assistant",
    "门派": "school",
    "洞府": "city",
    "配方": "item_recipe",
    "交互": "interaction", "对话": "interaction",
    "NPC": "entity_prefab", "npc": "entity_prefab", "实体": "entity_prefab",
    "场景实体": "spawn_world_entity", "刷新配置": "spawn_world_entity",
    # D1 扩充：覆盖 case 23 等缺失关键词
    "法术": "spell", "法术类型": "spell", "元素": "spell", "目标类型": "spell",
    "状态": "exclusive_state", "exclusive_state": "exclusive_state", "打坐": "exclusive_state",
    "建筑类型": "residence_building", "炼丹房": "residence_building", "炼器台": "residence_building",
    "洞府入口": "residence", "洞府网格": "residence", "洞府作物": "residence",
}

# 解析 prompt 中 skill context 的 token 预算（超限按 枚举→列名→路由 顺序裁剪）
# 默认 1800（原 3000）：skill 注入致 prompt 偏大 → LLM 响应慢易超时；
# 降预算优先裁路由块（全量→候选）、再裁枚举，保留最关键的列名/列类型。
# env 可调：CODEMAKER_SKILL_CONTEXT_BUDGET
_SKILL_CONTEXT_BUDGET = int(os.environ.get("CODEMAKER_SKILL_CONTEXT_BUDGET", "1800"))

# 模块级缓存
_route_cache: Optional[dict[str, str]] = None
_columns_cache: Optional[dict[str, dict[str, list[str]]]] = None
# 列类型 schema block 缓存：tuple(stems) -> block 字符串（避免每次 parse 重建）
_col_types_cache: dict[tuple, str] = {}


def reset_skill_context_cache() -> None:
    """丢弃缓存（索引/别名刷新后调用）。"""
    global _route_cache, _columns_cache
    _route_cache = None
    _columns_cache = None
    _col_types_cache.clear()


def get_table_route() -> dict[str, str]:
    """完整实体关键词 → 表名 stem 路由。

    合并内置种子 + sheet_aliases.yaml 全部别名（跳过通配 "*"）。
    """
    global _route_cache
    if _route_cache is not None:
        return _route_cache
    route: dict[str, str] = dict(_SEED_ROUTE)
    try:
        from .skill_loader import SheetAliasConfig
        cfg = SheetAliasConfig.load()
        for stem, aliases in (cfg.mapping or {}).items():
            if stem == "*":
                continue
            # stem 本身也作为一个可命中关键词（如英文 stem 直接出现）
            route.setdefault(stem, stem)
            for alias in (aliases or {}).keys():
                if alias and alias not in route:
                    route[alias] = stem
    except Exception:
        pass
    # 6.1：补齐索引中全部 stem（sheet_aliases 未覆盖的表，如 entity_prefab/
    # spawn_world_entity），使用户直接提及英文表名时也能命中路由。
    try:
        for stem in _all_columns().keys():
            route.setdefault(stem, stem)
    except Exception:
        pass
    # D1/2.3：补齐 sheet 名 + 主名称列名作为关键词（指向所在表 stem）。
    # 仅补高价值列名（名字/名称/Name 类），避免全列名噪声导致短列名误命中。
    try:
        _NAME_KW = ("名字", "名称", "Name", "name")
        for stem, sheets in _all_columns().items():
            for sheet_name in sheets.keys():
                if sheet_name and sheet_name not in route:
                    route.setdefault(sheet_name, stem)
            for sheet_name, cols in sheets.items():
                for col in cols:
                    name = col.split(":")[0] if col else ""
                    if name and any(kw in name for kw in _NAME_KW) and name not in route:
                        route.setdefault(name, stem)
    except Exception:
        pass
    _route_cache = route
    return route


def _all_columns() -> dict[str, dict[str, list[str]]]:
    """{stem: {sheet_name: [列名, ...]}}，来自 _table_index.json。"""
    global _columns_cache
    if _columns_cache is not None:
        return _columns_cache
    out: dict[str, dict[str, list[str]]] = {}
    try:
        from .table_index import load_index
        for t in load_index():
            sheets: dict[str, list[str]] = {}
            for s in t.sheets:
                cols = [c for c in (s.header_names or []) if c]
                if cols:
                    sheets[s.name] = cols
            if sheets:
                out[t.stem] = sheets
    except Exception:
        pass
    _columns_cache = out
    return out


def get_columns(stem: str, sheet: str = "") -> dict[str, list[str]] | list[str]:
    """获取某表列名。给定 sheet 返回该 sheet 列名列表，否则返回 {sheet: [列名]}。"""
    tables = _all_columns()
    sheets = tables.get(stem, {})
    if sheet:
        return list(sheets.get(sheet, []))
    return {k: list(v) for k, v in sheets.items()}


def get_enums(stem: str) -> str:
    """某表枚举值映射的 LLM 可读文本（EnumResolver.format_context）。"""
    try:
        from .enum_resolver import get_enum_resolver
        return get_enum_resolver().format_context(stem)
    except Exception:
        return ""


def known_stems() -> set[str]:
    """全部已知表名 stem 集合（来自路由值 + 索引），供解析输出后校验用。"""
    stems: set[str] = set(get_table_route().values())
    stems |= set(_all_columns().keys())
    return stems


def pre_route(text: str, limit: int = 3) -> list[str]:
    """skill 轻量预解析：按路由关键词命中，返回候选 stem（去重，最多 limit 个）。

    按关键词长度降序匹配（越长越具体优先），保证候选顺序稳定。
    """
    if not text:
        return []
    route = get_table_route()
    hits: list[str] = []
    for alias in sorted(route.keys(), key=len, reverse=True):
        if alias and alias in text:
            stem = route[alias]
            if stem not in hits:
                hits.append(stem)
            if len(hits) >= limit:
                break
    return hits


def _format_route_block(only: Optional[list[str]] = None) -> str:
    """表路由块（按 stem 聚合别名，紧凑）。

    only 非空时仅输出这些候选 stem 的路由（压缩体积，给预算让位给列名）。
    """
    route = get_table_route()
    by_stem: dict[str, list[str]] = {}
    for alias, stem in route.items():
        if only is not None and stem not in only:
            continue
        by_stem.setdefault(stem, []).append(alias)
    if only is not None:
        # 保证候选 stem 即使无别名也出现
        for stem in only:
            by_stem.setdefault(stem, [stem])
    lines = ["## 可用表路由（实体关键词 → 表名 stem，table_hint 用 stem）"]
    for stem in sorted(by_stem.keys()):
        aliases = ",".join(sorted(set(by_stem[stem])))
        lines.append(f"  {stem}: {aliases}")
    return "\n".join(lines)


def _format_columns_block(stems: list[str]) -> str:
    """候选表列名块。"""
    if not stems:
        return ""
    lines = ["## 目标表列名候选（列名请用下列实际列名，勿自造）"]
    for stem in stems:
        sheets = get_columns(stem)
        if not isinstance(sheets, dict):
            continue
        for sheet_name, cols in sheets.items():
            if cols:
                lines.append(f"  {stem}[{sheet_name}]: {', '.join(cols)}")
    return "\n".join(lines) if len(lines) > 1 else ""


def _format_column_types_block(stems: list[str]) -> str:
    """D2: 候选表列类型 schema 块（列名: 类型 [枚举/主名称列标记]）。

    从 value_constraints.yaml（列类型）+ enum_mappings.yaml（枚举）合成。
    让 LLM 按类型产出值，避免 int 列塞字符串（case 23 根因）。

    缓存：按 tuple(stems) 缓存构建结果（reset_skill_context_cache 刷新）。
    """
    key = tuple(stems) if stems else ()
    cached = _col_types_cache.get(key)
    if cached is not None:
        return cached
    if not stems:
        _col_types_cache[key] = ""
        return ""
    try:
        from .skill_loader import _load_yaml
        vc = _load_yaml("value_constraints.yaml")
        if not isinstance(vc, dict):
            vc = {}
        tables_vc = vc.get("tables", {})
        em = _load_yaml("enum_mappings.yaml")
        if not isinstance(em, dict):
            em = {}
        tables_em = em.get("tables", {})
    except Exception:
        return ""
    lines = ["## 目标表列类型 schema（按类型产出值，int 列勿塞字符串）"]
    for stem in stems:
        stem_vc = tables_vc.get(stem, {})
        stem_em = tables_em.get(stem, {})
        if not isinstance(stem_vc, dict):
            continue
        for sheet_name, cols in stem_vc.items():
            if not isinstance(cols, dict):
                continue
            col_lines = []
            for col_name, meta in cols.items():
                if not isinstance(meta, dict):
                    continue
                ct = meta.get("type", "str")
                # 主名称列标注（列名含名字/名称/Name 且为 str）
                is_name = any(k in col_name for k in ("名字", "名称", "Name", "name")) and ct == "str"
                # 枚举标注
                enum_vals = ""
                if isinstance(stem_em, dict):
                    sheet_em = stem_em.get(sheet_name, {})
                    if isinstance(sheet_em, dict):
                        col_em = sheet_em.get("columns", {}).get(col_name, {})
                        if isinstance(col_em, dict):
                            vals = col_em.get("values", [])
                            if vals and isinstance(vals, list):
                                enum_vals = " [枚举: " + ", ".join(
                                    f"{v.get('label')}={v.get('value')}" for v in vals[:5] if isinstance(v, dict)) + "]"
                marks = (" [主名称列]" if is_name else "") + enum_vals
                col_lines.append(f"    {col_name}: {ct}{marks}")
            if col_lines:
                lines.append(f"  {stem}[{sheet_name}]:")
                lines.extend(col_lines)
    result = "\n".join(lines) if len(lines) > 1 else ""
    _col_types_cache[key] = result
    return result


def _format_enums_block(stems: list[str]) -> str:
    """候选表枚举块。"""
    parts = [get_enums(stem) for stem in stems]
    parts = [p for p in parts if p]
    return "\n".join(parts)


def build_skill_context(text: str, budget: int = _SKILL_CONTEXT_BUDGET) -> str:
    """构建注入解析 prompt 的 skill 知识块。

    组成：表路由 + 候选表列名 + 候选表枚举。

    预算策略（修正）：**候选表列名/枚举是字段对齐的关键信号，必须优先保留**；
    路由块（全量 74 表）体积大，从「全量路由 → 仅候选路由 → 去路由」逐级降级，
    把预算让给列名。旧实现把全量路由排在最前，撑满预算后列名被裁光，
    导致模型看不到真实列名（如 interaction 的"选项内容"vs int 列"选项1"）。

    6.2 延迟控制：预解析无候选表（关键词均未命中路由）时**退化为全表列名候选**
    （D1：原短路 return "" 导致 LLM 零约束臆造列名，case 23 根因），按 token 预算
    内表名字母序取前 N 张注入列名，不让 LLM 零约束。
    """
    stems = pre_route(text)
    if not stems:
        # D1: 无路由命中 → 退化为全表列名候选（按表名字母序取前 N 张）
        # 但空文本/None 无意义注入，保留原返回空行为
        if not text or not str(text).strip():
            return ""
        all_stems = sorted(known_stems())
        stems = all_stems[:8] if all_stems else []
        if not stems:
            return ""
    cols_block = _format_columns_block(stems)
    types_block = _format_column_types_block(stems)  # D2 列类型 schema
    enum_block = _format_enums_block(stems)
    full_route = _format_route_block()
    compact_route = _format_route_block(only=stems)

    def _assemble(parts: list[str]) -> str:
        return "\n\n".join(p for p in parts if p)

    # 路由从全量→仅候选→无 降级，列名/列类型/枚举始终保留
    for candidate in (
        [full_route, cols_block, types_block, enum_block],     # 全量路由 + 列 + 类型 + 枚举
        [compact_route, cols_block, types_block, enum_block],  # 仅候选路由 + 列 + 类型 + 枚举
        [compact_route, cols_block, types_block],              # 再裁枚举
        [cols_block, types_block],                             # 只留列名+类型（最关键）
    ):
        ctx = _assemble(candidate)
        if ctx and estimate_tokens(ctx) <= budget:
            return ctx
    # 连列名都超预算：返回列名块（保底注入关键信号，宁可略超也别丢列）
    return cols_block or compact_route

