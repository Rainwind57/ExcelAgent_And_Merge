├── nl_parser.py           # 自然语言意图解析（动作/字段/值提取）
├── table_resolver.py      # 自然语言 → 表 + sheet 定位（旧版，关键词+余弦）
├── table_locator.py       # 表格定位器 · 层3：5级递进定位 + 歧义消解
├── llm_context.py         # LLM上下文构建器 · 层4：Token感知 + 5 Skill注入 + 系统提示词
├── fuzzy_matcher.py       # 模糊匹配引擎 · 层2：子串+编辑距离+字符重叠
├── alias_mapping.py       # 语义别名管理 · 层1：alias_mapping.json 反查
├── column_matcher.py      # 自然语言列名 → Excel 列名映射（余弦相似度）
├── table_index.py         # 表格注册中心 · 层1：扫描/MD5/样本/增量刷新
├── file_watcher.py        # 文件监听 · watchdog 防抖自动刷新
├── backup_audit.py        # 操作安全 · 备份/审计日志/回滚
├── table_relations.py     # 关系图谱 · 外键关联 + 跨表上下文扩展
├── index_builder.py       # 索引构建器 standalone 脚本
├── skill_loader.py        # YAML skill 配置文件加载器
├── pipeline/              # 7 步管道编排层
├── subagent/              # SubAgent 派发层(并行 LLM 子 Agent)
├── parser/                # 通用文件解析器(多模态→DocIntent)
├── __init__.py            # 包导出
├── _table_index.json      # 自动生成的表索引（60表，含 md5 + 前3行样本）
├── alias_mapping.json     # 语义别名 → 文件映射（如 灵兽→pet.xlsx）
├── table_relations.json   # 表间外键关系图谱
└── skills/
    ├── column_aliases.yaml    # 列名别名（自然语言 → 列名）
    ├── row_aliases.yaml       # 行定位规则（定位列 + 匹配策略）
    ├── table_context.yaml     # 多 sheet 消歧关键词
    ├── index_builder_hints.yaml   # 索引构建关键词推断提示
    ├── parser_config.yaml     # 解析器配置
    └── required_fields.yaml   # 必填字段配置
```

