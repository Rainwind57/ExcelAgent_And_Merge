# ============================================================
#  AI Excel Tool - 环境变量配置
#  用法: 复制此文件为 .env 后启动服务
#         copy .env.example .env
#  .env 已被版本控制忽略（见 .svnignore），不会被提交。
#  下方凭据仅供团队内部使用。
#  若项目将来对外公开，请先轮换密码。
# ============================================================

# === CodeMaker Serve（LLM 后端，端口 8666）===
# 注意：以下账号密码仅是本地 serve HTTP 接口的 Basic Auth 门禁，
#       与「网易 CodeMaker 账户」无关，团队可共用、无需每人修改。
#       真正调用 LLM 的账户需各自执行一次：
#         codemaker providers login -p netease-codemaker
#       （凭据存本地 ~/.local/share/codemaker/auth.json，走各用户自己的额度）
OPENCODE_SERVER_USERNAME=codemaker
OPENCODE_SERVER_PASSWORD=CMniubi2026

# === FastAPI 后端 -> Serve 访问 ===
CODEMAKER_SERVER_URL=http://127.0.0.1:8666
CODEMAKER_USERNAME=codemaker
CODEMAKER_PASSWORD=CMniubi2026
# CODEMAKER_MODEL 必须用 serve 实际存在的 provider/model（见 /api/model）。
# codemaker serve 1.17 已内置 provider "netease-codemaker"，模型丰富。
# 常见可用：netease-codemaker/deepseek-v4-flash（最便宜）/ deepseek-v4-pro
#           / qwen3.7-plus / glm-5.2 / claude-sonnet-5 等。
CODEMAKER_MODEL=netease-codemaker/deepseek-v4-flash
CODEMAKER_API_TIMEOUT=120

# === 合并引擎 ===
# ProcessPool 阈值：表数 >= 此值才启用多进程并行 compare。
# Windows spawn 下子进程 import 重依赖（LLM client/agent_service）会死锁，
# 默认 9999 = 关闭 ProcessPool（始终走 ThreadPool）。
# 待 worker 模块完全隔离后降低此值。
MERGE_PROCESS_THRESHOLD=9999
# 单表 compare 超时（秒），ProcessPool 模式下每表最长时间。
MERGE_PROCESS_TIMEOUT=60

# === Agent 6 步流程 per-stage 超时（秒）===
# 各阶段 LLM 调用超时，超时后该阶段降级走规则路径。
CODEMAKER_PARSE_TIMEOUT=30
CODEMAKER_PLAN_TIMEOUT=30
CODEMAKER_VALIDATE_TIMEOUT=30
CODEMAKER_EXECUTE_TIMEOUT=30
CODEMAKER_VERIFY_TIMEOUT=20

# === LLM 调用控制 ===
# 单批次 LLM 调用次数上限（0=不限），超限后跳过剩余 AI 增强。
CODEMAKER_LLM_CALL_LIMIT=0
# 白名单模式：1=仅对硬范围/枚举触发 AI 校验，跳过全量验证门（省 LLM 调用）。
CODEMAKER_AI_WHITELIST_MODE=0

# === verify-repair 循环 ===
# 最大修复轮数（默认 3），每轮含 LLM 诊断 + 重试。
CODEMAKER_VERIFY_REPAIR_MAX_ROUNDS=3
# 并行修复：1=多轮 repair 并行（实验性，默认关闭）。
CODEMAKER_PARALLEL_REPAIR=0
